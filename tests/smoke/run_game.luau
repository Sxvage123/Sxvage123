-- Plays one game like a player would and reports every runtime error.
-- Expects globals REFLECTION and MANIFEST (generated by run.sh).
local R = require("./services")
local task = R.task
R.init(REFLECTION)
local game = R.createGame()
R.buildTree(MANIFEST)

local function step(label, seconds)
	R.advance(seconds or 0.5)
	return label
end

-- 1. server scripts
for _, d in game:GetService("ServerScriptService"):GetDescendants() do
	if d.ClassName == "Script" then
		R.runScript(d, "server")
	end
end
step("server boot", 2)

-- 2. player joins + character
local player = R.addPlayer(1001)
R.localPlayer = player
step("join", 3)
R.spawnCharacter(player)
step("character", 2)

-- 3. client scripts
for _, d in game:GetService("StarterPlayer"):GetDescendants() do
	if d.ClassName == "LocalScript" then
		R.runScript(d, "client")
	end
end
step("client boot", 3)

-- 4. make them rich so purchase paths succeed
local commonServer = game:GetService("ServerScriptService"):FindFirstChild("CommonServer")
local DataService = commonServer and R.requireCached(commonServer:FindFirstChild("DataService"))
local function enrich()
	local data = DataService and DataService.Get(player)
	if data then
		for _, key in { "Cash", "Coins", "Gems", "Brainpower" } do
			if type(data[key]) == "number" then
				data[key] = 1e12
			end
		end
	end
end
enrich()

local function clickAll(pass)
	local gui = player:FindFirstChild("PlayerGui")
	local count = 0
	for _, d in gui:GetDescendants() do
		if d:IsA("GuiButton") and d.Parent then
			count += 1
			R.signalFor(d, "Activated"):Fire()
			R.signalFor(d, "MouseButton1Click"):Fire()
			R.advance(0.25)
		end
	end
	return count
end

local function triggerPrompts()
	local n = 0
	local pps = game:GetService("ProximityPromptService")
	for _, d in game:GetService("Workspace"):GetDescendants() do
		if d:IsA("ProximityPrompt") and n < 250 then
			n += 1
			R.signalFor(d, "Triggered"):Fire(player)
			R.signalFor(pps, "PromptTriggered"):Fire(d, player)
			R.advance(0.1)
		end
	end
	return n
end

local function touchAll()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return 0
	end
	local n = 0
	for _, d in game:GetService("Workspace"):GetDescendants() do
		if d:IsA("BasePart") and n < 600 then
			local sig = R.state[d].signals.Touched
			if sig and #sig.handlers > 0 then
				n += 1
				sig:Fire(root)
				R.advance(0.05)
			end
		end
	end
	return n
end

local function buyEverything()
	local remote = game:GetService("ReplicatedStorage"):FindFirstChild("StudioTestPurchase")
	local shared = game:GetService("ReplicatedStorage"):FindFirstChild("Shared")
	local Config = shared and R.requireCached(shared:FindFirstChild("Config"))
	if not remote or not Config then
		return 0
	end
	local n = 0
	for name in Config.Products do
		n += 1
		R.signalFor(remote, "OnServerEvent"):Fire(player, "Product", name)
		R.advance(0.5)
	end
	for name in Config.Passes do
		n += 1
		R.signalFor(remote, "OnServerEvent"):Fire(player, "Pass", name)
		R.advance(0.5)
	end
	return n
end

local stats = {}
if SCENARIO then
	print(SCENARIO(R, game, player))
end
stats.clicks1 = clickAll(1)
step("after clicks", 2)
stats.prompts = triggerPrompts()
step("after prompts", 2)
stats.touches = touchAll()
step("after touches", 2)
stats.purchases = buyEverything()
enrich()
step("after purchases", 3)
stats.clicks2 = clickAll(2)
stats.prompts2 = triggerPrompts()
stats.touches2 = touchAll()
step("play", 240)
stats.clicks3 = clickAll(3)

-- die + respawn
local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
if humanoid then
	humanoid.Health = 0
end
step("respawn", 8)
stats.prompts3 = triggerPrompts()
step("more play", 60)

-- leave + shutdown
R.removePlayer(player)
step("leave", 3)
for _, fn in R.bindToClose do
	task.spawn(fn)
end
R.advance(3)

-- save must exist and be valid
local saved = 0
for _ in R.storeData do
	saved += 1
end

print(string.format("clicks %d/%d/%d prompts %d/%d/%d touches %d/%d purchases %d saves %d",
	stats.clicks1, stats.clicks2, stats.clicks3, stats.prompts, stats.prompts2, stats.prompts3, stats.touches, stats.touches2, stats.purchases, saved))

local seen, unique = {}, {}
for _, e in R.errors do
	local first = string.match(e, "^[^\n]*") or e
	if not seen[first] then
		seen[first] = 0
		table.insert(unique, e)
	end
	seen[first] += 1
end
for _, e in unique do
	local first = string.match(e, "^[^\n]*") or e
	print("ERROR (x" .. seen[first] .. "): " .. e)
end
local wseen = {}
for _, w in R.warnings do
	if not wseen[w] then
		wseen[w] = true
		print("WARN: " .. w)
	end
end
local unimpl = {}
for k in R.unimplemented do
	table.insert(unimpl, k)
end
if #unimpl > 0 then
	print("NOTE unimplemented API calls (no-op in mock): " .. table.concat(unimpl, ", "))
end
if saved == 0 then
	print("ERROR: nothing was saved to the DataStore")
end
print(if #unique == 0 and saved > 0 then "RESULT: PASS" else "RESULT: FAIL")
