  <Item class="ServerScriptService" referent="9">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="10">
      <Properties>
        <string name="Name">CommonServer</string>
      </Properties>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Session-locked DataStore saving shared by every game.
-- Keeps each player's data in memory, autosaves, and never lets two servers
-- write the same player at once (prevents item duplication / rollbacks).
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local DataService = {}

local AUTOSAVE_INTERVAL = 90
local LOCK_EXPIRE = 600
local LOAD_ATTEMPTS = 6

local profiles: { [Player]: { [string]: any } } = {}
local loadedEvent = Instance.new("BindableEvent")
local releasingEvent = Instance.new("BindableEvent")
DataService.ProfileLoaded = loadedEvent.Event -- (player, data)
DataService.ProfileReleasing = releasingEvent.Event -- (player, data) fired before the final save

local store: DataStore? = nil
local memoryStore: { [string]: any } = {}
local template: { [string]: any } = {}
local initialized = false

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end
DataService.DeepCopy = deepCopy

local function reconcile(data, tmpl)
	for key, value in tmpl do
		if data[key] == nil then
			data[key] = deepCopy(value)
		elseif type(value) == "table" and type(data[key]) == "table" and next(value) ~= nil and #value == 0 then
			reconcile(data[key], value)
		end
	end
end

local function update(key: string, transform: (any) -> any): (boolean, any)
	if not store then
		local result = transform(memoryStore[key])
		if result ~= nil then
			memoryStore[key] = deepCopy(result)
		end
		return true, result
	end
	local ok, result = pcall(function()
		return (store :: DataStore):UpdateAsync(key, transform)
	end)
	return ok, result
end

local function keyFor(player: Player): string
	return "Player_" .. player.UserId
end

local function loadProfile(player: Player)
	local key = keyFor(player)
	for attempt = 1, LOAD_ATTEMPTS do
		local stealLock = attempt == LOAD_ATTEMPTS
		local lockedElsewhere = false
		local ok, result = update(key, function(stored)
			stored = stored or { Data = deepCopy(template) }
			local lock = stored.Lock
			if lock and lock.JobId ~= game.JobId and os.time() - lock.Time < LOCK_EXPIRE and not stealLock then
				lockedElsewhere = true
				return nil
			end
			stored.Lock = { JobId = game.JobId, Time = os.time() }
			return stored
		end)
		if ok and result and not lockedElsewhere then
			local data = result.Data or deepCopy(template)
			reconcile(data, template)
			return data
		end
		if not ok then
			warn("[DataService] load failed for", player.Name, result)
		end
		task.wait(lockedElsewhere and 5 or 2)
		if not player.Parent then
			return nil
		end
	end
	return nil
end

-- Saves the player's data. `release` clears the session lock (used on leave).
function DataService.Save(player: Player, release: boolean?): boolean
	local data = profiles[player]
	if not data then
		return false
	end
	data.LastSave = os.time()
	local snapshot = deepCopy(data)
	local ok, err = update(keyFor(player), function(stored)
		stored = stored or {}
		if stored.Lock and stored.Lock.JobId ~= game.JobId then
			-- Another server took over this player; never overwrite its data.
			return nil
		end
		stored.Data = snapshot
		stored.Lock = if release then nil else { JobId = game.JobId, Time = os.time() }
		return stored
	end)
	if not ok then
		warn("[DataService] save failed for", player.Name, err)
	end
	return ok
end

function DataService.Get(player: Player): { [string]: any }?
	return profiles[player]
end

function DataService.WaitFor(player: Player, timeout: number?): { [string]: any }?
	local deadline = os.clock() + (timeout or 15)
	while not profiles[player] and player.Parent and os.clock() < deadline do
		task.wait(0.1)
	end
	return profiles[player]
end

local function onPlayerAdded(player: Player)
	local data = loadProfile(player)
	if not player.Parent then
		if data then
			profiles[player] = data
			DataService.Save(player, true)
			profiles[player] = nil
		end
		return
	end
	if not data then
		player:Kick("Your data could not load. Please rejoin in a moment!")
		return
	end
	data.LoginCount = (data.LoginCount or 0) + 1
	profiles[player] = data
	loadedEvent:Fire(player, data)
end

local function onPlayerRemoving(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	releasingEvent:Fire(player, data)
	DataService.Save(player, true)
	profiles[player] = nil
end

function DataService.Init(storeName: string, dataTemplate: { [string]: any })
	assert(not initialized, "DataService already initialized")
	initialized = true
	template = dataTemplate
	template.LastSave = template.LastSave or 0
	template.LoginCount = template.LoginCount or 0
	template.Receipts = template.Receipts or {}
	template.RobuxSpent = template.RobuxSpent or 0

	local ok, result = pcall(function()
		local s = DataStoreService:GetDataStore(storeName)
		if RunService:IsStudio() then
			-- Throws when "Enable Studio Access to API Services" is off.
			s:GetAsync("__probe")
		end
		return s
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStores unavailable, using memory only (turn on API access in Game Settings to save):", result)
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player in profiles do
				task.spawn(DataService.Save, player, false)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				releasingEvent:Fire(player, profiles[player])
				DataService.Save(player, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[-- Game pass ownership + developer product receipts, done safely:
-- every receipt is granted exactly once and saved before Roblox is told it succeeded.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local DataService = require(script.Parent.DataService)

local MonetizationService = {}

type Config = {
	Passes: { [string]: number },
	Products: { [string]: number },
	ProductHandlers: { [string]: (Player, { [string]: any }) -> boolean? },
	OnPassOwned: ((Player, string) -> ())?,
}

local passes: { [string]: number } = {}
local passIdToName: { [number]: string } = {}
local productIdToName: { [number]: string } = {}
local handlers = {}
local onPassOwned: ((Player, string) -> ())? = nil

local MAX_RECEIPTS = 100

local function setPass(player: Player, name: string)
	if player:GetAttribute("Pass_" .. name) then
		return
	end
	player:SetAttribute("Pass_" .. name, true)
	if onPassOwned then
		task.spawn(onPassOwned, player, name)
	end
end

function MonetizationService.OwnsPass(player: Player, name: string): boolean
	return player:GetAttribute("Pass_" .. name) == true
end

local function checkPasses(player: Player)
	for name, id in passes do
		if id and id > 0 then
			task.spawn(function()
				local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, id)
				if ok and owns and player.Parent then
					setPass(player, name)
				end
			end)
		end
	end
end

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = DataService.WaitFor(player, 20)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if table.find(data.Receipts, receipt.PurchaseId) then
		-- Already applied in memory; only confirm once it's actually saved
		-- (an earlier save may have failed).
		if DataService.Save(player, false) then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local name = productIdToName[receipt.ProductId]
	local handler = name and handlers[name]
	if not handler then
		warn("[Monetization] no handler for product", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok, result = pcall(handler, player, data)
	if not ok then
		warn("[Monetization] handler error", name, result)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if result == false then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(data.Receipts, receipt.PurchaseId)
	while #data.Receipts > MAX_RECEIPTS do
		table.remove(data.Receipts, 1)
	end
	data.RobuxSpent = (data.RobuxSpent or 0) + (receipt.CurrencySpent or 0)
	if DataService.Save(player, false) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

function MonetizationService.Init(config: Config)
	passes = config.Passes
	handlers = config.ProductHandlers
	onPassOwned = config.OnPassOwned
	for name, id in config.Passes do
		passIdToName[id] = name
	end
	for name, id in config.Products do
		productIdToName[id] = name
	end

	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local name = passIdToName[passId]
		if purchased and name then
			setPass(player, name)
		end
	end)

	-- In Studio, buttons for passes/products whose ID is still 0 grant instantly so you can test.
	local testRemote = Instance.new("RemoteEvent")
	testRemote.Name = "StudioTestPurchase"
	testRemote.Parent = ReplicatedStorage
	testRemote.OnServerEvent:Connect(function(player, kind, name)
		if not RunService:IsStudio() or type(name) ~= "string" then
			return
		end
		if kind == "Pass" and passes[name] ~= nil then
			setPass(player, name)
		elseif kind == "Product" and handlers[name] then
			local data = DataService.Get(player)
			if data then
				handlers[name](player, data)
			end
		end
	end)

	Players.PlayerAdded:Connect(checkPasses)
	for _, player in Players:GetPlayers() do
		checkPasses(player)
	end
end

-- Lets admins / testers grant passes in Studio before IDs exist.
function MonetizationService.GrantPassForTesting(player: Player, name: string)
	setPass(player, name)
end

return MonetizationService
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="13">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="14">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Eat the Brainrot World server: chunky city, eat chunks to grow, upgrades, rebirths, eat smaller players.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage.Shared.Config)
local BrainrotModels = require(ReplicatedStorage.Common.BrainrotModels)
local Format = require(ReplicatedStorage.Common.Format)
local DataService = require(ServerScriptService.CommonServer.DataService)
local MonetizationService = require(ServerScriptService.CommonServer.MonetizationService)

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = ReplicatedStorage
local function remote(className: string, name: string): any
	local r = Instance.new(className)
	r.Name = name
	r.Parent = remotes
	return r
end
local NotifyRemote = remote("RemoteEvent", "Notify")
local EatRemote = remote("RemoteEvent", "Eat")
local UpgradeRemote = remote("RemoteFunction", "Upgrade")
local RebirthRemote = remote("RemoteFunction", "Rebirth")

local function notify(player: Player?, text: string, color: Color3?)
	if player then
		NotifyRemote:FireClient(player, text, color)
	else
		NotifyRemote:FireAllClients(text, color)
	end
end

---------------------------------------------------------------- city

local world = Instance.new("Folder")
world.Name = "World"
world.Parent = workspace
local city = Instance.new("Folder")
city.Name = "City"
city.Parent = workspace
local function part(props, parent: Instance): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = parent
	return p
end

part({ Name = "Ground", Size = Vector3.new(760, 2, 760), Position = Vector3.new(0, -1, 0), Color = Color3.fromRGB(90, 150, 80), Material = Enum.Material.Grass }, world)
local spawn = Instance.new("SpawnLocation")
spawn.Anchored = true
spawn.Size = Vector3.new(14, 1, 14)
spawn.Position = Vector3.new(0, 0.5, 0)
spawn.Neutral = true
spawn.Color = Color3.fromRGB(255, 200, 0)
spawn.Parent = world

local edible: { BasePart } = {}
local function addEdible(p: BasePart, minSize: number, food: number)
	p:SetAttribute("MinSize", minSize)
	p:SetAttribute("Food", food)
	table.insert(edible, p)
end

local COLORS = { Color3.fromRGB(240, 200, 160), Color3.fromRGB(170, 200, 240), Color3.fromRGB(240, 170, 190), Color3.fromRGB(200, 240, 170), Color3.fromRGB(230, 230, 230), Color3.fromRGB(250, 220, 120) }
local rng = Random.new(42)
local inner = 30
for _, d in Config.Districts do
	for i = 1, d.Count do
		local a = (i + rng:NextNumber(-0.3, 0.3)) / d.Count * math.pi * 2
		local r = rng:NextNumber(inner + 15, d.Radius - 15)
		local base = Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		local b = d.Block
		local floors = rng:NextInteger(d.Floors[1], d.Floors[2])
		local color = COLORS[rng:NextInteger(1, #COLORS)]
		for fx = 0, 2 do
			for fz = 0, 2 do
				for fy = 0, floors - 1 do
					local window = (fx ~= 1 or fz ~= 1) and fy % 2 == 1
					local p = part({ Name = "Chunk", Size = Vector3.one * b, Position = base + Vector3.new((fx - 1) * b, b / 2 + fy * b, (fz - 1) * b), Color = if window then Color3.fromRGB(120, 180, 230) else color, Material = if window then Enum.Material.Glass else Enum.Material.SmoothPlastic }, city)
					addEdible(p, d.MinSize, d.Food * (if window then 2 else 1))
				end
			end
		end
	end
	-- Trees between buildings
	for _ = 1, d.Count do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(inner, d.Radius)
		local pos = Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		addEdible(part({ Name = "Trunk", Size = Vector3.new(1.5, 6, 1.5) * (d.Block / 5), Position = pos + Vector3.new(0, 3 * d.Block / 5, 0), Color = Color3.fromRGB(110, 75, 45), Material = Enum.Material.Wood }, city), d.MinSize, d.Food)
		addEdible(part({ Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.one * 6 * (d.Block / 5), Position = pos + Vector3.new(0, 7 * d.Block / 5, 0), Color = Color3.fromRGB(60, 150, 60), Material = Enum.Material.Grass }, city), d.MinSize, d.Food * 2)
	end
	inner = d.Radius
end

-- Brainrot titans standing at the edge: the biggest meals in the game.
for i, id in { "tung", "tralalero", "bombardiro", "cappuccino", "garama", "skibidi" } do
	local model, _ = BrainrotModels.Build(id, { Scale = 8 })
	local a = i / 6 * math.pi * 2
	local h = (model:GetAttribute("RootHeight") :: number?) or 20
	model:PivotTo(CFrame.new(math.cos(a) * 340, h, math.sin(a) * 340) * CFrame.Angles(0, -a - math.pi / 2, 0))
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") and p.Name ~= "Root" then
			p.CanQuery = true
			addEdible(p, Config.TitanMinSize, Config.TitanFood)
		end
	end
	model.Parent = city
end

---------------------------------------------------------------- players

local lastBite: { [Player]: number } = {}

local function level(data, id: string): number
	return data.Levels[id] or 0
end

local function sizeMult(player: Player, data): number
	local m = (1 + data.Rebirths * Config.RebirthBonus) * (1 + level(data, "Stomach") * 0.2)
	if MonetizationService.OwnsPass(player, "DoubleSize") then
		m *= 2
	end
	if MonetizationService.OwnsPass(player, "VIP") then
		m *= 1.5
	end
	return m
end

local function applyScale(player: Player)
	local data = DataService.Get(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not data or not character or not humanoid then
		return
	end
	local scale = Config.ScaleFor(data.Size)
	if math.abs(character:GetScale() - scale) > 0.02 then
		character:ScaleTo(scale)
	end
	humanoid.WalkSpeed = (16 + level(data, "Speed") * 2) * math.sqrt(scale)
end

local function sync(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	player:SetAttribute("Size", data.Size)
	player:SetAttribute("Coins", data.Coins)
	player:SetAttribute("Rebirths", data.Rebirths)
	for _, u in Config.Upgrades do
		player:SetAttribute("Lv_" .. u.Id, level(data, u.Id))
	end
	local ls = player:FindFirstChild("leaderstats")
	if ls then
		(ls :: any).Size.Value = math.floor(data.Size);
		(ls :: any).Rebirths.Value = data.Rebirths
	end
	applyScale(player)
end

local function grow(player: Player, data, food: number)
	local gain = food * sizeMult(player, data)
	data.Size += gain
	data.Coins += math.floor(food * (1 + data.Rebirths * Config.RebirthBonus) * (if MonetizationService.OwnsPass(player, "VIP") then 1.5 else 1))
end

local function bite(player: Player)
	local data = DataService.Get(player)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local now = os.clock()
	if not data or not root or now - (lastBite[player] or 0) < Config.BiteCooldown then
		return
	end
	lastBite[player] = now
	local scale = Config.ScaleFor(data.Size)
	local reach = (7 + scale * 4) * (1 + level(data, "Reach") * 0.15)
	local count = 1 + level(data, "Bite")
	if MonetizationService.OwnsPass(player, "MegaBite") then
		count *= 3
	end
	-- Nearest edible chunks within reach that we're big enough for.
	local found = {}
	for i, p in edible do
		if p.Parent and (p:GetAttribute("MinSize") :: number) <= data.Size then
			local d = (p.Position - root.Position).Magnitude - p.Size.Magnitude / 2
			if d <= reach then
				table.insert(found, { i, d })
			end
		end
	end
	table.sort(found, function(a, b)
		return a[2] < b[2]
	end)
	local food = 0
	for k = 1, math.min(count, #found) do
		local p = edible[found[k][1]]
		food += p:GetAttribute("Food") :: number
		local parent = p.Parent
		p.Parent = nil
		task.delay(Config.RespawnTime, function()
			p.Parent = parent
		end)
	end
	-- Eat smaller players in reach.
	for _, other in Players:GetPlayers() do
		local od = DataService.Get(other)
		local oroot = other.Character and other.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local ohum = other.Character and other.Character:FindFirstChildOfClass("Humanoid")
		if other ~= player and od and oroot and ohum and ohum.Health > 0 and data.Size >= (od.Size + 10) * Config.EatPlayerRatio and (oroot.Position - root.Position).Magnitude <= reach then
			local stolen = math.floor(od.Size * 0.3)
			od.Size -= stolen
			food += stolen
			ohum.Health = 0
			sync(other)
			notify(nil, player.DisplayName .. " ATE " .. other.DisplayName .. "!", Color3.fromRGB(255, 80, 80))
		end
	end
	if food > 0 then
		grow(player, data, food)
		sync(player)
	end
end
EatRemote.OnServerEvent:Connect(bite)

task.spawn(function()
	while true do
		task.wait(0.5)
		for _, p in Players:GetPlayers() do
			if MonetizationService.OwnsPass(p, "AutoEat") and p:GetAttribute("AutoEat") ~= false then
				bite(p)
			end
		end
	end
end)

UpgradeRemote.OnServerInvoke = function(player, id)
	local data = DataService.Get(player)
	if not data then
		return false
	end
	for _, u in Config.Upgrades do
		if u.Id == id then
			local lv = level(data, id)
			local cost = Config.UpgradeCost(u, lv)
			if lv >= u.Max or data.Coins < cost then
				return false
			end
			data.Coins -= cost
			data.Levels[id] = lv + 1
			sync(player)
			return true
		end
	end
	return false
end

RebirthRemote.OnServerInvoke = function(player)
	local data = DataService.Get(player)
	if not data then
		return false
	end
	local need = Config.RebirthCost(data.Rebirths)
	if data.Size < need then
		notify(player, "Reach size " .. Format.Abbreviate(need) .. " to rebirth!", Color3.fromRGB(255, 90, 90))
		return false
	end
	data.Size = 0
	data.Rebirths += 1
	sync(player)
	notify(nil, player.DisplayName .. " REBIRTHED! (x" .. (1 + data.Rebirths * Config.RebirthBonus) .. " growth)", Color3.fromRGB(255, 120, 255))
	return true
end

DataService.ProfileLoaded:Connect(function(player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	for _, name in { "Size", "Rebirths" } do
		local v = Instance.new("IntValue")
		v.Name = name
		v.Parent = ls
	end
	ls.Parent = player
	sync(player)
	local function onCharacter(character: Model)
		character:WaitForChild("HumanoidRootPart", 10)
		task.wait()
		applyScale(player)
	end
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
end)

Players.PlayerRemoving:Connect(function(player)
	lastBite[player] = nil
end)

MonetizationService.Init({
	Passes = Config.Passes,
	Products = Config.Products,
	ProductHandlers = {
		Size1 = function(player, data)
			data.Size += math.max(200, data.Size * 0.25)
			sync(player)
			return true
		end,
		Size2 = function(player, data)
			data.Size += math.max(2000, data.Size * 1.5)
			sync(player)
			notify(nil, player.DisplayName .. " bought a GIANT FEAST!", Color3.fromRGB(255, 215, 0))
			return true
		end,
		ShrinkRay = function(player, data)
			local target, best = nil, -1
			for _, other in Players:GetPlayers() do
				local od = DataService.Get(other)
				if other ~= player and od and od.Size > best then
					target, best = other, od.Size
				end
			end
			local od = target and DataService.Get(target)
			if target and od then
				od.Size = math.floor(od.Size / 2)
				sync(target)
				notify(nil, player.DisplayName .. " used a SHRINK RAY on " .. target.DisplayName .. "!", Color3.fromRGB(120, 200, 255))
			else
				data.Size += 300
				sync(player)
				notify(player, "Nobody to shrink, so you grew +300!", Color3.fromRGB(255, 215, 0))
			end
			return true
		end,
		Coins = function(player, data)
			data.Coins += 2000 * (1 + data.Rebirths)
			sync(player)
			return true
		end,
	},
	OnPassOwned = function(player, name)
		notify(player, "Unlocked " .. name .. "!", Color3.fromRGB(255, 215, 0))
	end,
})

DataService.Init("EatTheBrainrotWorld_v1", {
	Size = 0,
	Coins = 0,
	Rebirths = 0,
	Levels = {},
})
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="15">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="16">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="17">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="18">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Eat the Brainrot World client: size HUD, EAT button (also click/tap), upgrades, rebirth, shop.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Common.Format)
local ShopUI = require(ReplicatedStorage.Common.ShopUI)
local UI = require(ReplicatedStorage.Common.UI)

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local gui = UI.new("ScreenGui", { Name = "HUD", ResetOnSpawn = false, Parent = player:WaitForChild("PlayerGui") }) :: ScreenGui
local toast = UI.CreateToaster(gui)
remotes:WaitForChild("Notify").OnClientEvent:Connect(toast)
local buy = ShopUI.Buyer(Config, toast)
local shop = ShopUI.Create(gui, Config, buy, Color3.fromRGB(40, 30, 30))
ShopUI.VIPChatTag("VIP")

local top = UI.new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 6), Size = UDim2.fromOffset(380, 80), BackgroundColor3 = Color3.fromRGB(35, 25, 25), BackgroundTransparency = 0.15, Parent = gui }, { UI.Corner(14), UI.Stroke(Color3.new(0, 0, 0), 3) })
local sizeLabel = UI.Label("", { Size = UDim2.new(1, -10, 0, 44), Position = UDim2.fromOffset(5, 2), TextColor3 = Color3.fromRGB(255, 150, 80), Parent = top })
local infoLabel = UI.Label("", { Size = UDim2.new(1, -10, 0, 28), Position = UDim2.fromOffset(5, 48), TextColor3 = Color3.fromRGB(255, 215, 0), Parent = top })

local eat = UI.Button("😋 EAT", Color3.fromRGB(230, 70, 60), { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -20, 1, -20), Size = UDim2.fromOffset(150, 150), Parent = gui })
local holding = false
eat.MouseButton1Down:Connect(function()
	holding = true
end)
eat.MouseButton1Up:Connect(function()
	holding = false
end)
eat.Activated:Connect(function()
	remotes.Eat:FireServer()
end)
UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.E) then
		remotes.Eat:FireServer()
	end
end)
task.spawn(function()
	while true do
		if holding then
			remotes.Eat:FireServer()
		end
		task.wait(Config.BiteCooldown)
	end
end)

local side = ShopUI.SideBar(gui)
UI.Button("SHOP", Color3.fromRGB(40, 180, 70), { Size = UDim2.fromOffset(140, 46), Parent = side }).Activated:Connect(function()
	shop.Visible = not shop.Visible
end)
local upButtons = {}
for _, u in Config.Upgrades do
	local b = UI.Button(u.Name, Color3.fromRGB(80, 140, 255), { Size = UDim2.fromOffset(140, 46), Parent = side })
	b.Activated:Connect(function()
		remotes.Upgrade:InvokeServer(u.Id)
	end)
	upButtons[u.Id] = b
end
local rebirth = UI.Button("REBIRTH", Color3.fromRGB(200, 80, 255), { Size = UDim2.fromOffset(140, 46), Parent = side })
rebirth.Activated:Connect(function()
	remotes.Rebirth:InvokeServer()
end)
UI.Button("SHRINK RAY", Color3.fromRGB(80, 200, 255), { Size = UDim2.fromOffset(140, 46), Parent = side }).Activated:Connect(function()
	buy("Product", "ShrinkRay")
end)

while true do
	local size = player:GetAttribute("Size") or 0
	sizeLabel.Text = "📏 Size " .. Format.Abbreviate(math.floor(size))
	infoLabel.Text = "🪙 " .. Format.Abbreviate(player:GetAttribute("Coins") or 0) .. "  •  🔁 " .. (player:GetAttribute("Rebirths") or 0)
	for _, u in Config.Upgrades do
		local lv = player:GetAttribute("Lv_" .. u.Id) or 0
		upButtons[u.Id].Text = if lv >= u.Max then u.Name .. " MAX" else u.Name .. " " .. Format.Abbreviate(Config.UpgradeCost(u, lv))
	end
	rebirth.Text = "REBIRTH @" .. Format.Abbreviate(Config.RebirthCost(player:GetAttribute("Rebirths") or 0))
	task.wait(0.3)
end
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
