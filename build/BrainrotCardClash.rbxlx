      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Session-locked DataStore saving shared by every game.
-- Keeps each player's data in memory, autosaves, and never lets two servers
-- write the same player at once (prevents item duplication / rollbacks).
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local DataService = {}

local AUTOSAVE_INTERVAL = 90
local LOCK_EXPIRE = 600
local LOAD_ATTEMPTS = 6

local profiles: { [Player]: { [string]: any } } = {}
local loadedEvent = Instance.new("BindableEvent")
local releasingEvent = Instance.new("BindableEvent")
DataService.ProfileLoaded = loadedEvent.Event -- (player, data)
DataService.ProfileReleasing = releasingEvent.Event -- (player, data) fired before the final save

local store: DataStore? = nil
local memoryStore: { [string]: any } = {}
local template: { [string]: any } = {}
local initialized = false

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end
DataService.DeepCopy = deepCopy

local function reconcile(data, tmpl)
	for key, value in tmpl do
		if data[key] == nil then
			data[key] = deepCopy(value)
		elseif type(value) == "table" and type(data[key]) == "table" and next(value) ~= nil and #value == 0 then
			reconcile(data[key], value)
		end
	end
end

local function update(key: string, transform: (any) -> any): (boolean, any)
	if not store then
		local result = transform(memoryStore[key])
		if result ~= nil then
			memoryStore[key] = deepCopy(result)
		end
		return true, result
	end
	local ok, result = pcall(function()
		return (store :: DataStore):UpdateAsync(key, transform)
	end)
	return ok, result
end

local function keyFor(player: Player): string
	return "Player_" .. player.UserId
end

local function loadProfile(player: Player)
	local key = keyFor(player)
	for attempt = 1, LOAD_ATTEMPTS do
		local stealLock = attempt == LOAD_ATTEMPTS
		local lockedElsewhere = false
		local ok, result = update(key, function(stored)
			stored = stored or { Data = deepCopy(template) }
			local lock = stored.Lock
			if lock and lock.JobId ~= game.JobId and os.time() - lock.Time < LOCK_EXPIRE and not stealLock then
				lockedElsewhere = true
				return nil
			end
			stored.Lock = { JobId = game.JobId, Time = os.time() }
			return stored
		end)
		if ok and result and not lockedElsewhere then
			local data = result.Data or deepCopy(template)
			reconcile(data, template)
			return data
		end
		if not ok then
			warn("[DataService] load failed for", player.Name, result)
		end
		task.wait(lockedElsewhere and 5 or 2)
		if not player.Parent then
			return nil
		end
	end
	return nil
end

-- Saves the player's data. `release` clears the session lock (used on leave).
function DataService.Save(player: Player, release: boolean?): boolean
	local data = profiles[player]
	if not data then
		return false
	end
	data.LastSave = os.time()
	local snapshot = deepCopy(data)
	local ok, err = update(keyFor(player), function(stored)
		stored = stored or {}
		if stored.Lock and stored.Lock.JobId ~= game.JobId then
			-- Another server took over this player; never overwrite its data.
			return nil
		end
		stored.Data = snapshot
		stored.Lock = if release then nil else { JobId = game.JobId, Time = os.time() }
		return stored
	end)
	if not ok then
		warn("[DataService] save failed for", player.Name, err)
	end
	return ok
end

function DataService.Get(player: Player): { [string]: any }?
	return profiles[player]
end

function DataService.WaitFor(player: Player, timeout: number?): { [string]: any }?
	local deadline = os.clock() + (timeout or 15)
	while not profiles[player] and player.Parent and os.clock() < deadline do
		task.wait(0.1)
	end
	return profiles[player]
end

local function onPlayerAdded(player: Player)
	local data = loadProfile(player)
	if not player.Parent then
		if data then
			profiles[player] = data
			DataService.Save(player, true)
			profiles[player] = nil
		end
		return
	end
	if not data then
		player:Kick("Your data could not load. Please rejoin in a moment!")
		return
	end
	data.LoginCount = (data.LoginCount or 0) + 1
	profiles[player] = data
	loadedEvent:Fire(player, data)
end

local function onPlayerRemoving(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	releasingEvent:Fire(player, data)
	DataService.Save(player, true)
	profiles[player] = nil
end

function DataService.Init(storeName: string, dataTemplate: { [string]: any })
	assert(not initialized, "DataService already initialized")
	initialized = true
	template = dataTemplate
	template.LastSave = template.LastSave or 0
	template.LoginCount = template.LoginCount or 0
	template.Receipts = template.Receipts or {}
	template.RobuxSpent = template.RobuxSpent or 0

	local ok, result = pcall(function()
		local s = DataStoreService:GetDataStore(storeName)
		if RunService:IsStudio() then
			-- Throws when "Enable Studio Access to API Services" is off.
			s:GetAsync("__probe")
		end
		return s
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStores unavailable, using memory only (turn on API access in Game Settings to save):", result)
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player in profiles do
				task.spawn(DataService.Save, player, false)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				releasingEvent:Fire(player, profiles[player])
				DataService.Save(player, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[-- Game pass ownership + developer product receipts, done safely:
-- every receipt is granted exactly once and saved before Roblox is told it succeeded.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local DataService = require(script.Parent.DataService)

local MonetizationService = {}

type Config = {
	Passes: { [string]: number },
	Products: { [string]: number },
	ProductHandlers: { [string]: (Player, { [string]: any }) -> boolean? },
	OnPassOwned: ((Player, string) -> ())?,
}

local passes: { [string]: number } = {}
local passIdToName: { [number]: string } = {}
local productIdToName: { [number]: string } = {}
local handlers = {}
local onPassOwned: ((Player, string) -> ())? = nil

local MAX_RECEIPTS = 100

local function setPass(player: Player, name: string)
	if player:GetAttribute("Pass_" .. name) then
		return
	end
	player:SetAttribute("Pass_" .. name, true)
	if onPassOwned then
		task.spawn(onPassOwned, player, name)
	end
end

function MonetizationService.OwnsPass(player: Player, name: string): boolean
	return player:GetAttribute("Pass_" .. name) == true
end

local function checkPasses(player: Player)
	for name, id in passes do
		if id and id > 0 then
			task.spawn(function()
				local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, id)
				if ok and owns and player.Parent then
					setPass(player, name)
				end
			end)
		end
	end
end

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = DataService.WaitFor(player, 20)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if table.find(data.Receipts, receipt.PurchaseId) then
		-- Already applied in memory; only confirm once it's actually saved
		-- (an earlier save may have failed).
		if DataService.Save(player, false) then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local name = productIdToName[receipt.ProductId]
	local handler = name and handlers[name]
	if not handler then
		warn("[Monetization] no handler for product", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok, result = pcall(handler, player, data)
	if not ok then
		warn("[Monetization] handler error", name, result)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if result == false then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(data.Receipts, receipt.PurchaseId)
	while #data.Receipts > MAX_RECEIPTS do
		table.remove(data.Receipts, 1)
	end
	data.RobuxSpent = (data.RobuxSpent or 0) + (receipt.CurrencySpent or 0)
	if DataService.Save(player, false) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

function MonetizationService.Init(config: Config)
	passes = config.Passes
	handlers = config.ProductHandlers
	onPassOwned = config.OnPassOwned
	for name, id in config.Passes do
		passIdToName[id] = name
	end
	for name, id in config.Products do
		productIdToName[id] = name
	end

	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local name = passIdToName[passId]
		if purchased and name then
			setPass(player, name)
		end
	end)

	-- In Studio, buttons for passes/products whose ID is still 0 grant instantly so you can test.
	local testRemote = Instance.new("RemoteEvent")
	testRemote.Name = "StudioTestPurchase"
	testRemote.Parent = ReplicatedStorage
	testRemote.OnServerEvent:Connect(function(player, kind, name)
		if not RunService:IsStudio() or type(name) ~= "string" then
			return
		end
		if kind == "Pass" and passes[name] ~= nil then
			setPass(player, name)
		elseif kind == "Product" and handlers[name] then
			local data = DataService.Get(player)
			if data then
				handlers[name](player, data)
			end
		end
	end)

	Players.PlayerAdded:Connect(checkPasses)
	for _, player in Players:GetPlayers() do
		checkPasses(player)
	end
end

-- Lets admins / testers grant passes in Studio before IDs exist.
function MonetizationService.GrantPassForTesting(player: Player, name: string)
	setPass(player, name)
end

return MonetizationService
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="13">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="14">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Brainrot Card Clash server: card packs (gacha with mutations), auto-built deck, boss ladder battles,
-- passive gems, selling cards.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage.Shared.Config)
local BrainrotModels = require(ReplicatedStorage.Common.BrainrotModels)
local Format = require(ReplicatedStorage.Common.Format)
local DataService = require(ServerScriptService.CommonServer.DataService)
local MonetizationService = require(ServerScriptService.CommonServer.MonetizationService)

Lighting.ClockTime = 16
Lighting.Brightness = 2.5

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = ReplicatedStorage
local function remote(className: string, name: string): any
	local r = Instance.new(className)
	r.Name = name
	r.Parent = remotes
	return r
end
local NotifyRemote = remote("RemoteEvent", "Notify")
local OpenedRemote = remote("RemoteEvent", "Opened") -- (cards: {{Id, Mut}})
local BattleRemote = remote("RemoteEvent", "Battle") -- (bossIndex, log, won)
local CardsRemote = remote("RemoteEvent", "Cards") -- (cards, deckIndices)
local OpenRemote = remote("RemoteFunction", "OpenPack")
local FightRemote = remote("RemoteFunction", "Fight")
local SellRemote = remote("RemoteFunction", "Sell")

local function notify(player: Player?, text: string, color: Color3?)
	if player then
		NotifyRemote:FireClient(player, text, color)
	else
		NotifyRemote:FireAllClients(text, color)
	end
end

local world = Instance.new("Folder")
world.Name = "World"
world.Parent = workspace
local function part(props, parent: Instance?): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = parent or world
	return p
end
local function sign(adornee: BasePart, face: Enum.NormalId, text: string, color: Color3)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.CanvasSize = Vector2.new(400, 120)
	gui.Parent = adornee
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = color
	label.Parent = gui
end

---------------------------------------------------------------- state

local luckUntil = 0

local function deckSize(player: Player): number
	return if MonetizationService.OwnsPass(player, "VIP") then Config.VIPDeckSize else Config.DeckSize
end

local function power(card): number
	local p, _ = Config.Stats(card.Id, card.Mut)
	return p
end

-- The deck is always your strongest cards.
local function deckOf(player: Player, data): { number }
	local order = {}
	for i in data.Cards do
		table.insert(order, i)
	end
	table.sort(order, function(a, b)
		return power(data.Cards[a]) > power(data.Cards[b])
	end)
	local deck = {}
	for i = 1, math.min(deckSize(player), #order) do
		table.insert(deck, order[i])
	end
	return deck
end

local function gemMult(player: Player): number
	local m = 1
	if MonetizationService.OwnsPass(player, "DoubleGems") then
		m *= 2
	end
	if MonetizationService.OwnsPass(player, "VIP") then
		m *= 1.5
	end
	return m
end

local function sync(player: Player, sendCards: boolean?)
	local data = DataService.Get(player)
	if not data then
		return
	end
	player:SetAttribute("Gems", data.Gems)
	player:SetAttribute("Stage", data.Stage)
	player:SetAttribute("CardCount", #data.Cards)
	local deck = deckOf(player, data)
	local total = 0
	for _, i in deck do
		total += power(data.Cards[i])
	end
	player:SetAttribute("DeckPower", total)
	local ls = player:FindFirstChild("leaderstats")
	if ls then
		(ls :: any).Stage.Value = data.Stage;
		(ls :: any).Gems.Value = math.min(data.Gems, 2 ^ 53)
	end
	if sendCards then
		CardsRemote:FireClient(player, data.Cards, deck)
	end
end

---------------------------------------------------------------- packs

local function rollRarity(weights: { [string]: number }, lucky: boolean): string
	local entries = {}
	local total = 0
	for name, w in weights do
		local idx = Config.RarityIndex[name]
		-- Luck doubles the weight of anything rarer than the pack's most common rarity.
		local weight = if lucky and idx >= 3 then w * 2 else w
		table.insert(entries, { name, weight, idx })
		total += weight
	end
	table.sort(entries, function(a, b)
		return a[3] < b[3]
	end)
	local roll = math.random() * total
	for _, e in entries do
		roll -= e[2]
		if roll <= 0 then
			return e[1]
		end
	end
	return entries[#entries][1]
end

local function rollCard(weights: { [string]: number }, player: Player): { Id: string, Mut: string? }
	local lucky = MonetizationService.OwnsPass(player, "LuckyPacks") or os.clock() < luckUntil
	local rarity = rollRarity(weights, lucky)
	local pool = Config.ByRarity[rarity]
	local card = pool[math.random(1, #pool)]
	local mut: string? = nil
	for i = #Config.Mutations, 1, -1 do
		local m = Config.Mutations[i]
		if math.random() < m.Chance * (if lucky then 2 else 1) then
			mut = m.Name
			break
		end
	end
	return { Id = card.Id, Mut = mut }
end

local function addCards(player: Player, data, cards)
	for _, c in cards do
		if #data.Cards >= Config.MaxCards then
			-- Inventory full: auto-sell the new card.
			local r = Config.RarityByName[Config.ById[c.Id].Rarity]
			data.Gems += math.floor(r.Sell * Config.MutationMult(c.Mut))
		else
			table.insert(data.Cards, c)
		end
		local info = Config.ById[c.Id]
		if Config.RarityIndex[info.Rarity] >= 5 or c.Mut == "Rainbow" then
			notify(nil, player.DisplayName .. " pulled " .. (if c.Mut then c.Mut .. " " else "") .. info.Name .. " (" .. info.Rarity .. ")!", Config.RarityByName[info.Rarity].Color)
		end
	end
	data.Opened += #cards
end

local function packById(id: string)
	for _, p in Config.Packs do
		if p.Id == id then
			return p
		end
	end
	return nil
end

local function openPack(player: Player, packId: string): boolean
	local data = DataService.Get(player)
	local pack = packById(packId)
	if not data or not pack then
		return false
	end
	local count = if MonetizationService.OwnsPass(player, "FastOpen") then 5 else 1
	count = math.min(count, math.floor(data.Gems / pack.Cost))
	if count < 1 then
		notify(player, "You need " .. Format.Abbreviate(pack.Cost) .. " gems for a " .. pack.Name .. "!", Color3.fromRGB(255, 90, 90))
		return false
	end
	data.Gems -= pack.Cost * count
	local cards = {}
	for _ = 1, count * 3 do
		table.insert(cards, rollCard(pack.Weights, player))
	end
	addCards(player, data, cards)
	OpenedRemote:FireClient(player, cards)
	sync(player, true)
	return true
end
OpenRemote.OnServerInvoke = function(player, packId)
	return openPack(player, tostring(packId))
end

---------------------------------------------------------------- battles

local fighting: { [Player]: boolean } = {}

local function simulate(player: Player, data, boss)
	local deck = deckOf(player, data)
	local cards = {}
	for _, i in deck do
		local c = data.Cards[i]
		local p, hp = Config.Stats(c.Id, c.Mut)
		table.insert(cards, { Id = c.Id, Mut = c.Mut, Power = p, HP = hp, MaxHP = hp })
	end
	local bossHp = boss.HP
	local log = {}
	for _ = 1, 15 do
		local dmg = 0
		for _, c in cards do
			if c.HP > 0 then
				dmg += c.Power
			end
		end
		bossHp = math.max(0, bossHp - dmg)
		local target = 0
		if bossHp > 0 then
			for i, c in cards do
				if c.HP > 0 then
					c.HP = math.max(0, c.HP - boss.Power)
					target = i
					break
				end
			end
		end
		local hps = {}
		for i, c in cards do
			hps[i] = c.HP
		end
		table.insert(log, { BossHP = bossHp, Damage = dmg, Target = target, HPs = hps })
		local alive = false
		for _, c in cards do
			if c.HP > 0 then
				alive = true
			end
		end
		if bossHp <= 0 or not alive then
			break
		end
	end
	return cards, log, bossHp <= 0
end

local function fight(player: Player, stage: number?): boolean
	local data = DataService.Get(player)
	if not data or fighting[player] then
		return false
	end
	local index = stage or (data.Stage + 1)
	index = math.clamp(index, 1, math.min(data.Stage + 1, #Config.Bosses))
	local boss = Config.Bosses[index]
	if #data.Cards == 0 then
		notify(player, "Open a pack first to get some cards!", Color3.fromRGB(255, 200, 0))
		return false
	end
	fighting[player] = true
	local cards, log, won = simulate(player, data, boss)
	BattleRemote:FireClient(player, index, cards, log, won)
	task.delay(math.min(#log * 0.6 + 1, 10), function()
		fighting[player] = nil
	end)
	if won then
		local first = index > data.Stage
		local reward = math.floor(boss.Reward * gemMult(player) * (if first then 3 else 1))
		data.Gems += reward
		if first then
			data.Stage = index
			notify(nil, player.DisplayName .. " defeated " .. boss.Name .. "!", Color3.fromRGB(255, 215, 0))
		end
		notify(player, "Victory! +" .. Format.Abbreviate(reward) .. " gems" .. (if first then " (first clear x3!)" else ""), Color3.fromRGB(90, 255, 90))
	else
		notify(player, boss.Name .. " was too strong! Open better packs.", Color3.fromRGB(255, 90, 90))
	end
	sync(player)
	return won
end
FightRemote.OnServerInvoke = function(player, stage)
	return fight(player, if type(stage) == "number" then stage else nil)
end

SellRemote.OnServerInvoke = function(player, index)
	local data = DataService.Get(player)
	if not data or type(index) ~= "number" or not data.Cards[index] then
		return false
	end
	-- Never sell your deck by accident.
	if table.find(deckOf(player, data), index) then
		notify(player, "That card is in your deck!", Color3.fromRGB(255, 200, 0))
		return false
	end
	local c = table.remove(data.Cards, index)
	local r = Config.RarityByName[Config.ById[c.Id].Rarity]
	data.Gems += math.floor(r.Sell * Config.MutationMult(c.Mut))
	sync(player, true)
	return true
end

---------------------------------------------------------------- world: pack shop + boss arena

part({ Name = "Floor", Size = Vector3.new(200, 2, 200), Position = Vector3.new(0, -1, 0), Color = Color3.fromRGB(60, 50, 80), Material = Enum.Material.SmoothPlastic })
local spawn = Instance.new("SpawnLocation")
spawn.Anchored = true
spawn.Size = Vector3.new(12, 1, 12)
spawn.Position = Vector3.new(0, 0.5, 0)
spawn.Neutral = true
spawn.Color = Color3.fromRGB(255, 200, 0)
spawn.Material = Enum.Material.Neon
spawn.Parent = world

for i, pack in Config.Packs do
	local x = (i - (#Config.Packs + 1) / 2) * 16
	local stand = part({ Name = "PackStand", Size = Vector3.new(8, 3, 8), Position = Vector3.new(x, 1.5, -30), Color = Color3.fromRGB(40, 35, 55), Material = Enum.Material.Marble })
	local card = part({ Name = pack.Id .. "Pack", Size = Vector3.new(5, 7, 0.6), Position = Vector3.new(x, 7.5, -30), Color = pack.Color, Material = Enum.Material.Neon })
	sign(card, Enum.NormalId.Back, pack.Name .. "\n" .. Format.Abbreviate(pack.Cost) .. " 💎", Color3.new(1, 1, 1))
	sign(card, Enum.NormalId.Front, pack.Name, Color3.new(1, 1, 1))
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "OpenPrompt"
	prompt.ActionText = "Open (" .. Format.Abbreviate(pack.Cost) .. " 💎)"
	prompt.ObjectText = pack.Name
	prompt.HoldDuration = 0.3
	prompt.RequiresLineOfSight = false
	prompt.Parent = stand
	prompt.Triggered:Connect(function(player)
		openPack(player, pack.Id)
	end)
end

-- Arena with a giant figure of the next boss.
part({ Name = "Arena", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 60, 60), CFrame = CFrame.new(0, 0.5, 50) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(150, 40, 60), Material = Enum.Material.Slate })
local arenaPad = part({ Name = "FightPad", Size = Vector3.new(14, 1, 14), Position = Vector3.new(0, 1.2, 32), Color = Color3.fromRGB(255, 70, 70), Material = Enum.Material.Neon })
local fightPrompt = Instance.new("ProximityPrompt")
fightPrompt.Name = "FightPrompt"
fightPrompt.ActionText = "Fight next boss"
fightPrompt.HoldDuration = 0.3
fightPrompt.RequiresLineOfSight = false
fightPrompt.Parent = arenaPad
fightPrompt.Triggered:Connect(function(player)
	fight(player, nil)
end)
do
	local boss, _ = BrainrotModels.Build(Config.Bosses[#Config.Bosses].Id, { Scale = 4 })
	local h = (boss:GetAttribute("RootHeight") :: number?) or 10
	boss:PivotTo(CFrame.new(0, h + 1, 62) * CFrame.Angles(0, math.pi, 0))
	boss.Name = "ArenaBoss"
	boss.Parent = world
end

---------------------------------------------------------------- passive gems + players

task.spawn(function()
	while true do
		task.wait(10)
		for _, player in Players:GetPlayers() do
			local data = DataService.Get(player)
			if data then
				data.Gems += math.floor(Config.PassiveGems * (1 + data.Stage) * gemMult(player))
				sync(player)
			end
		end
		workspace:SetAttribute("LuckLeft", math.max(0, math.ceil(luckUntil - os.clock())))
	end
end)

DataService.ProfileLoaded:Connect(function(player, data)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	for _, name in { "Stage", "Gems" } do
		local v = Instance.new(if name == "Gems" then "NumberValue" else "IntValue")
		v.Name = name
		v.Parent = ls
	end
	ls.Parent = player
	if data.Opened == 0 and #data.Cards == 0 then
		-- Free starter pack so new players can fight right away.
		local starter = {}
		for _ = 1, 3 do
			table.insert(starter, rollCard(Config.Packs[1].Weights, player))
		end
		addCards(player, data, starter)
		task.delay(2, function()
			OpenedRemote:FireClient(player, starter)
			notify(player, "Here's a free starter pack! Walk to the red pad to fight your first boss.", Color3.fromRGB(255, 215, 0))
		end)
	end
	sync(player, true)
end)

Players.PlayerRemoving:Connect(function(player)
	fighting[player] = nil
end)

local function gemPack(player: Player, data, base: number)
	local amount = math.floor(base * (1 + data.Stage * 0.5) ^ 1.5)
	data.Gems += amount
	sync(player)
	notify(player, "+" .. Format.Abbreviate(amount) .. " gems!", Color3.fromRGB(120, 220, 255))
	return true
end

MonetizationService.Init({
	Passes = Config.Passes,
	Products = Config.Products,
	ProductHandlers = {
		Gems = function(player, data)
			return gemPack(player, data, 500)
		end,
		GemsBig = function(player, data)
			return gemPack(player, data, 4000)
		end,
		MegaPack = function(player, data)
			local cards = { rollCard({ Mythic = 80, ["Brainrot God"] = 18, Secret = 2 }, player) }
			addCards(player, data, cards)
			OpenedRemote:FireClient(player, cards)
			sync(player, true)
			return true
		end,
		ServerLuck = function(player)
			luckUntil = math.max(luckUntil, os.clock()) + Config.ServerLuckTime
			notify(nil, player.DisplayName .. " activated 2x SERVER LUCK for packs!", Color3.fromRGB(255, 215, 0))
			return true
		end,
	},
	OnPassOwned = function(player, name)
		sync(player, true)
		notify(player, "Unlocked " .. name .. "!", Color3.fromRGB(255, 215, 0))
	end,
})

DataService.Init("BrainrotCardClash_v1", {
	Gems = 60,
	Stage = 0,
	Opened = 0,
	Cards = {},
})
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="15">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="16">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="17">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="18">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Brainrot Card Clash client: gems HUD, pack reveal, battle screen, card collection, boss ladder, shop.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Common.Format)
local ModelView = require(ReplicatedStorage.Common.ModelView)
local ShopUI = require(ReplicatedStorage.Common.ShopUI)
local UI = require(ReplicatedStorage.Common.UI)

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")

local gui = UI.new("ScreenGui", { Name = "HUD", ResetOnSpawn = false, Parent = player:WaitForChild("PlayerGui") }) :: ScreenGui
local toast = UI.CreateToaster(gui)
remotes:WaitForChild("Notify").OnClientEvent:Connect(toast)
local buy = ShopUI.Buyer(Config, toast)
local shop = ShopUI.Create(gui, Config, buy, Color3.fromRGB(40, 30, 60))
ShopUI.VIPChatTag("VIP")

local top = UI.new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 6),
	Size = UDim2.fromOffset(420, 80),
	BackgroundColor3 = Color3.fromRGB(35, 25, 55),
	BackgroundTransparency = 0.15,
	Parent = gui,
}, { UI.Corner(14), UI.Stroke(Color3.new(0, 0, 0), 3) })
local gemsLabel = UI.Label("", { Size = UDim2.new(1, -10, 0, 44), Position = UDim2.fromOffset(5, 2), TextColor3 = Color3.fromRGB(120, 220, 255), Parent = top })
local infoLabel = UI.Label("", { Size = UDim2.new(1, -10, 0, 28), Position = UDim2.fromOffset(5, 48), TextColor3 = Color3.fromRGB(255, 215, 0), Parent = top })

local function panel(title: string, w: number, h: number): Frame
	local f = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = Color3.fromRGB(35, 25, 55),
		Visible = false,
		Parent = gui,
	}, { UI.Corner(16), UI.Stroke(Color3.new(0, 0, 0), 4) }) :: Frame
	UI.Label(title, { Size = UDim2.new(1, -60, 0, 44), Position = UDim2.fromOffset(10, 6), Parent = f })
	UI.Button("X", Color3.fromRGB(220, 60, 60), { Size = UDim2.fromOffset(40, 40), Position = UDim2.new(1, -48, 0, 8), Parent = f }).Activated:Connect(function()
		f.Visible = false
	end)
	return f
end

-- A card tile: rarity-coloured frame, 3D figure, name, power/hp.
local function cardTile(c, parent: Instance, size: Vector2, extra: string?): (Frame, TextLabel)
	local info = Config.ById[c.Id]
	local rarity = Config.RarityByName[info.Rarity]
	local mutColor
	for _, m in Config.Mutations do
		if m.Name == c.Mut then
			mutColor = m.Color
		end
	end
	local tile = UI.new("Frame", { Size = UDim2.fromOffset(size.X, size.Y), BackgroundColor3 = rarity.Color:Lerp(Color3.new(0, 0, 0), 0.5), Parent = parent }, { UI.Corner(10), UI.Stroke(mutColor or rarity.Color, 3) }) :: Frame
	local view = ModelView.new(c.Id, { Size = UDim2.new(1, -8, 0.55, 0), Position = UDim2.fromOffset(4, 4), BackgroundTransparency = 1 })
	if view then
		view.Parent = tile
	end
	local p, hp = Config.Stats(c.Id, c.Mut)
	UI.Label((if c.Mut then c.Mut .. " " else "") .. info.Name, { Size = UDim2.new(1, -6, 0.18, 0), Position = UDim2.new(0, 3, 0.57, 0), TextColor3 = mutColor or Color3.new(1, 1, 1), Parent = tile })
	UI.Label("⚔️" .. Format.Abbreviate(p) .. "  ❤️" .. Format.Abbreviate(hp), { Size = UDim2.new(1, -6, 0.13, 0), Position = UDim2.new(0, 3, 0.76, 0), TextColor3 = Color3.fromRGB(255, 230, 150), Parent = tile })
	local bottom = UI.Label(extra or info.Rarity, { Size = UDim2.new(1, -6, 0.1, 0), Position = UDim2.new(0, 3, 0.89, 0), TextColor3 = rarity.Color:Lerp(Color3.new(1, 1, 1), 0.3), Parent = tile })
	return tile, bottom
end

---------------------------------------------------------------- pack reveal

local reveal = panel("YOU PULLED", 640, 330)
local revealRow = UI.new("ScrollingFrame", { Size = UDim2.new(1, -20, 1, -64), Position = UDim2.fromOffset(10, 56), BackgroundTransparency = 1, AutomaticCanvasSize = Enum.AutomaticSize.X, CanvasSize = UDim2.new(), ScrollBarThickness = 6, Parent = reveal }, {
	UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) }) :: UIListLayout,
})
remotes:WaitForChild("Opened").OnClientEvent:Connect(function(cards)
	for _, child in revealRow:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	for _, c in cards do
		cardTile(c, revealRow, Vector2.new(140, 250))
	end
	reveal.Visible = true
end)

---------------------------------------------------------------- battle screen

local battle = panel("BATTLE", 680, 380)
local bossLabel = UI.Label("", { Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 52), TextColor3 = Color3.fromRGB(255, 120, 120), Parent = battle })
local bossBarBack = UI.new("Frame", { Size = UDim2.new(1, -40, 0, 22), Position = UDim2.fromOffset(20, 90), BackgroundColor3 = Color3.fromRGB(20, 15, 30), Parent = battle }, { UI.Corner(6) })
local bossBar = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(230, 50, 60), Parent = bossBarBack }, { UI.Corner(6) }) :: Frame
local battleRow = UI.new("Frame", { Size = UDim2.new(1, -20, 0, 210), Position = UDim2.fromOffset(10, 122), BackgroundTransparency = 1, Parent = battle }, {
	UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 8) }) :: UIListLayout,
})
local resultLabel = UI.Label("", { Size = UDim2.new(1, -20, 0, 36), Position = UDim2.new(0, 10, 1, -42), Parent = battle })

remotes:WaitForChild("Battle").OnClientEvent:Connect(function(index, cards, log, won)
	local boss = Config.Bosses[index]
	for _, child in battleRow:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local hpLabels = {}
	for i, c in cards do
		local _, hpLabel = cardTile(c, battleRow, Vector2.new(118, 200), "❤️ " .. Format.Abbreviate(c.MaxHP))
		hpLabels[i] = hpLabel
	end
	bossLabel.Text = "Stage " .. index .. ": " .. boss.Name .. "  (⚔️" .. Format.Abbreviate(boss.Power) .. ")"
	bossBar.Size = UDim2.fromScale(1, 1)
	resultLabel.Text = ""
	battle.Visible = true
	for _, turn in log do
		task.wait(0.5)
		bossBar.Size = UDim2.fromScale(math.clamp(turn.BossHP / boss.HP, 0, 1), 1)
		resultLabel.Text = "Your cards hit for " .. Format.Abbreviate(turn.Damage) .. "!"
		resultLabel.TextColor3 = Color3.new(1, 1, 1)
		for i, hp in turn.HPs do
			local label = hpLabels[i]
			if label then
				label.Text = if hp > 0 then "❤️ " .. Format.Abbreviate(hp) else "💀 KO"
			end
		end
	end
	task.wait(0.4)
	resultLabel.Text = if won then "🏆 VICTORY!" else "💀 DEFEAT. Get stronger cards!"
	resultLabel.TextColor3 = if won then Color3.fromRGB(90, 255, 90) else Color3.fromRGB(255, 90, 90)
end)

---------------------------------------------------------------- collection

local collection = panel("MY CARDS (deck = gold border)", 700, 460)
local grid = UI.new("ScrollingFrame", { Size = UDim2.new(1, -20, 1, -64), Position = UDim2.fromOffset(10, 56), BackgroundTransparency = 1, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollBarThickness = 8, Parent = collection }, {
	UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(120, 230), CellPadding = UDim2.fromOffset(8, 8) }) :: UIGridLayout,
})
local myCards, myDeck = {}, {}
local function renderCollection()
	for _, child in grid:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local order = {}
	for i in myCards do
		table.insert(order, i)
	end
	table.sort(order, function(a, b)
		local pa = Config.Stats(myCards[a].Id, myCards[a].Mut)
		local pb = Config.Stats(myCards[b].Id, myCards[b].Mut)
		return pa > pb
	end)
	for _, i in order do
		local inDeck = table.find(myDeck, i) ~= nil
		local tile, _ = cardTile(myCards[i], grid, Vector2.new(120, 230), if inDeck then "⭐ IN DECK" else nil)
		if inDeck then
			UI.Stroke(Color3.fromRGB(255, 215, 0), 4).Parent = tile
		else
			local sell = UI.Button("SELL", Color3.fromRGB(200, 60, 60), { Size = UDim2.fromOffset(50, 24), Position = UDim2.new(1, -54, 0, 4), TextSize = 14, Parent = tile })
			sell.Activated:Connect(function()
				remotes.Sell:InvokeServer(i)
			end)
		end
	end
end
remotes:WaitForChild("Cards").OnClientEvent:Connect(function(cards, deck)
	myCards, myDeck = cards, deck
	if collection.Visible then
		renderCollection()
	end
end)

---------------------------------------------------------------- boss ladder + packs

local ladder = panel("BOSS LADDER", 460, 470)
local ladderList = UI.new("ScrollingFrame", { Size = UDim2.new(1, -20, 1, -64), Position = UDim2.fromOffset(10, 56), BackgroundTransparency = 1, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollBarThickness = 8, Parent = ladder }, {
	UI.new("UIListLayout", { Padding = UDim.new(0, 6) }) :: UIListLayout,
})
local ladderButtons = {}
for i in Config.Bosses do
	local b = UI.Button("", Color3.fromRGB(80, 60, 110), { Size = UDim2.new(1, -12, 0, 50), Parent = ladderList })
	b.Activated:Connect(function()
		ladder.Visible = false
		remotes.Fight:InvokeServer(i)
	end)
	ladderButtons[i] = b
end

local packs = panel("CARD PACKS (3 cards each)", 460, 70 + #Config.Packs * 60)
for i, pack in Config.Packs do
	UI.Button(pack.Name .. "  •  " .. Format.Abbreviate(pack.Cost) .. " 💎", pack.Color:Lerp(Color3.new(0, 0, 0), 0.3), { Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 56 + (i - 1) * 60), Parent = packs }).Activated:Connect(function()
		remotes.OpenPack:InvokeServer(pack.Id)
	end)
end

local side = ShopUI.SideBar(gui)
UI.Button("PACKS", Color3.fromRGB(255, 140, 40), { Size = UDim2.fromOffset(130, 48), Parent = side }).Activated:Connect(function()
	packs.Visible = not packs.Visible
end)
UI.Button("FIGHT", Color3.fromRGB(230, 60, 70), { Size = UDim2.fromOffset(130, 48), Parent = side }).Activated:Connect(function()
	ladder.Visible = not ladder.Visible
end)
UI.Button("CARDS", Color3.fromRGB(80, 160, 255), { Size = UDim2.fromOffset(130, 48), Parent = side }).Activated:Connect(function()
	collection.Visible = not collection.Visible
	if collection.Visible then
		renderCollection()
	end
end)
UI.Button("SHOP", Color3.fromRGB(40, 180, 70), { Size = UDim2.fromOffset(130, 48), Parent = side }).Activated:Connect(function()
	shop.Visible = not shop.Visible
end)
UI.Button("MEGA PACK", Color3.fromRGB(255, 60, 180), { Size = UDim2.fromOffset(130, 48), Parent = side }).Activated:Connect(function()
	buy("Product", "MegaPack")
end)

task.spawn(function()
	while true do
		local stage = player:GetAttribute("Stage") or 0
		gemsLabel.Text = "💎 " .. Format.Abbreviate(player:GetAttribute("Gems") or 0)
		local luck = workspace:GetAttribute("LuckLeft") or 0
		infoLabel.Text = "Stage " .. stage .. "/" .. #Config.Bosses .. "  •  Deck ⚔️" .. Format.Abbreviate(player:GetAttribute("DeckPower") or 0) .. (if luck > 0 then "  •  🍀 " .. Format.Time(luck) else "")
		for i, b in ladderButtons do
			local boss = Config.Bosses[i]
			local locked = i > stage + 1
			b.Text = (if i <= stage then "✅ " elseif locked then "🔒 " else "⚔️ ") .. boss.Name .. "  ❤️" .. Format.Abbreviate(boss.HP)
			b.AutoButtonColor = not locked
			b.BackgroundColor3 = if locked then Color3.fromRGB(50, 45, 60) elseif i <= stage then Color3.fromRGB(60, 120, 70) else Color3.fromRGB(180, 60, 70)
		end
		task.wait(0.3)
	end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="19">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
