  <Item class="ServerScriptService" referent="8">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="9">
      <Properties>
        <string name="Name">CommonServer</string>
      </Properties>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Session-locked DataStore saving shared by every game.
-- Keeps each player's data in memory, autosaves, and never lets two servers
-- write the same player at once (prevents item duplication / rollbacks).
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local DataService = {}

local AUTOSAVE_INTERVAL = 90
local LOCK_EXPIRE = 600
local LOAD_ATTEMPTS = 6

local profiles: { [Player]: { [string]: any } } = {}
local loadedEvent = Instance.new("BindableEvent")
local releasingEvent = Instance.new("BindableEvent")
DataService.ProfileLoaded = loadedEvent.Event -- (player, data)
DataService.ProfileReleasing = releasingEvent.Event -- (player, data) fired before the final save

local store: DataStore? = nil
local memoryStore: { [string]: any } = {}
local template: { [string]: any } = {}
local initialized = false

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end
DataService.DeepCopy = deepCopy

local function reconcile(data, tmpl)
	for key, value in tmpl do
		if data[key] == nil then
			data[key] = deepCopy(value)
		elseif type(value) == "table" and type(data[key]) == "table" and next(value) ~= nil and #value == 0 then
			reconcile(data[key], value)
		end
	end
end

local function update(key: string, transform: (any) -> any): (boolean, any)
	if not store then
		local result = transform(memoryStore[key])
		if result ~= nil then
			memoryStore[key] = deepCopy(result)
		end
		return true, result
	end
	local ok, result = pcall(function()
		return (store :: DataStore):UpdateAsync(key, transform)
	end)
	return ok, result
end

local function keyFor(player: Player): string
	return "Player_" .. player.UserId
end

local function loadProfile(player: Player)
	local key = keyFor(player)
	for attempt = 1, LOAD_ATTEMPTS do
		local stealLock = attempt == LOAD_ATTEMPTS
		local lockedElsewhere = false
		local ok, result = update(key, function(stored)
			stored = stored or { Data = deepCopy(template) }
			local lock = stored.Lock
			if lock and lock.JobId ~= game.JobId and os.time() - lock.Time < LOCK_EXPIRE and not stealLock then
				lockedElsewhere = true
				return nil
			end
			stored.Lock = { JobId = game.JobId, Time = os.time() }
			return stored
		end)
		if ok and result and not lockedElsewhere then
			local data = result.Data or deepCopy(template)
			reconcile(data, template)
			return data
		end
		if not ok then
			warn("[DataService] load failed for", player.Name, result)
		end
		task.wait(lockedElsewhere and 5 or 2)
		if not player.Parent then
			return nil
		end
	end
	return nil
end

-- Saves the player's data. `release` clears the session lock (used on leave).
function DataService.Save(player: Player, release: boolean?): boolean
	local data = profiles[player]
	if not data then
		return false
	end
	data.LastSave = os.time()
	local snapshot = deepCopy(data)
	local ok, err = update(keyFor(player), function(stored)
		stored = stored or {}
		if stored.Lock and stored.Lock.JobId ~= game.JobId then
			-- Another server took over this player; never overwrite its data.
			return nil
		end
		stored.Data = snapshot
		stored.Lock = if release then nil else { JobId = game.JobId, Time = os.time() }
		return stored
	end)
	if not ok then
		warn("[DataService] save failed for", player.Name, err)
	end
	return ok
end

function DataService.Get(player: Player): { [string]: any }?
	return profiles[player]
end

function DataService.WaitFor(player: Player, timeout: number?): { [string]: any }?
	local deadline = os.clock() + (timeout or 15)
	while not profiles[player] and player.Parent and os.clock() < deadline do
		task.wait(0.1)
	end
	return profiles[player]
end

local function onPlayerAdded(player: Player)
	local data = loadProfile(player)
	if not player.Parent then
		if data then
			profiles[player] = data
			DataService.Save(player, true)
			profiles[player] = nil
		end
		return
	end
	if not data then
		player:Kick("Your data could not load. Please rejoin in a moment!")
		return
	end
	data.LoginCount = (data.LoginCount or 0) + 1
	profiles[player] = data
	loadedEvent:Fire(player, data)
end

local function onPlayerRemoving(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	releasingEvent:Fire(player, data)
	DataService.Save(player, true)
	profiles[player] = nil
end

function DataService.Init(storeName: string, dataTemplate: { [string]: any })
	assert(not initialized, "DataService already initialized")
	initialized = true
	template = dataTemplate
	template.LastSave = template.LastSave or 0
	template.LoginCount = template.LoginCount or 0
	template.Receipts = template.Receipts or {}
	template.RobuxSpent = template.RobuxSpent or 0

	local ok, result = pcall(function()
		local s = DataStoreService:GetDataStore(storeName)
		if RunService:IsStudio() then
			-- Throws when "Enable Studio Access to API Services" is off.
			s:GetAsync("__probe")
		end
		return s
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStores unavailable, using memory only (turn on API access in Game Settings to save):", result)
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player in profiles do
				task.spawn(DataService.Save, player, false)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				releasingEvent:Fire(player, profiles[player])
				DataService.Save(player, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[-- Game pass ownership + developer product receipts, done safely:
-- every receipt is granted exactly once and saved before Roblox is told it succeeded.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local DataService = require(script.Parent.DataService)

local MonetizationService = {}

type Config = {
	Passes: { [string]: number },
	Products: { [string]: number },
	ProductHandlers: { [string]: (Player, { [string]: any }) -> boolean? },
	OnPassOwned: ((Player, string) -> ())?,
}

local passes: { [string]: number } = {}
local passIdToName: { [number]: string } = {}
local productIdToName: { [number]: string } = {}
local handlers = {}
local onPassOwned: ((Player, string) -> ())? = nil

local MAX_RECEIPTS = 100

local function setPass(player: Player, name: string)
	if player:GetAttribute("Pass_" .. name) then
		return
	end
	player:SetAttribute("Pass_" .. name, true)
	if onPassOwned then
		task.spawn(onPassOwned, player, name)
	end
end

function MonetizationService.OwnsPass(player: Player, name: string): boolean
	return player:GetAttribute("Pass_" .. name) == true
end

local function checkPasses(player: Player)
	for name, id in passes do
		if id and id > 0 then
			task.spawn(function()
				local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, id)
				if ok and owns and player.Parent then
					setPass(player, name)
				end
			end)
		end
	end
end

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = DataService.WaitFor(player, 20)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if table.find(data.Receipts, receipt.PurchaseId) then
		-- Already applied in memory; only confirm once it's actually saved
		-- (an earlier save may have failed).
		if DataService.Save(player, false) then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local name = productIdToName[receipt.ProductId]
	local handler = name and handlers[name]
	if not handler then
		warn("[Monetization] no handler for product", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok, result = pcall(handler, player, data)
	if not ok then
		warn("[Monetization] handler error", name, result)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if result == false then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(data.Receipts, receipt.PurchaseId)
	while #data.Receipts > MAX_RECEIPTS do
		table.remove(data.Receipts, 1)
	end
	data.RobuxSpent = (data.RobuxSpent or 0) + (receipt.CurrencySpent or 0)
	if DataService.Save(player, false) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

function MonetizationService.Init(config: Config)
	passes = config.Passes
	handlers = config.ProductHandlers
	onPassOwned = config.OnPassOwned
	for name, id in config.Passes do
		passIdToName[id] = name
	end
	for name, id in config.Products do
		productIdToName[id] = name
	end

	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local name = passIdToName[passId]
		if purchased and name then
			setPass(player, name)
		end
	end)

	-- In Studio, buttons for passes/products whose ID is still 0 grant instantly so you can test.
	local testRemote = Instance.new("RemoteEvent")
	testRemote.Name = "StudioTestPurchase"
	testRemote.Parent = ReplicatedStorage
	testRemote.OnServerEvent:Connect(function(player, kind, name)
		if not RunService:IsStudio() or type(name) ~= "string" then
			return
		end
		if kind == "Pass" and passes[name] ~= nil then
			setPass(player, name)
		elseif kind == "Product" and handlers[name] then
			local data = DataService.Get(player)
			if data then
				handlers[name](player, data)
			end
		end
	end)

	Players.PlayerAdded:Connect(checkPasses)
	for _, player in Players:GetPlayers() do
		checkPasses(player)
	end
end

-- Lets admins / testers grant passes in Studio before IDs exist.
function MonetizationService.GrantPassForTesting(player: Player, name: string)
	setPass(player, name)
end

return MonetizationService
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="12">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="13">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Sahur Mystery server: roles (Sahur / Sheriff / Innocents), bat + gun combat, coins, crates, perks.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local BrainrotModels = require(ReplicatedStorage.Common.BrainrotModels)
local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(ServerScriptService.CommonServer.DataService)
local MonetizationService = require(ServerScriptService.CommonServer.MonetizationService)

Lighting.ClockTime = 20.5
Lighting.Brightness = 1.2
Lighting.OutdoorAmbient = Color3.fromRGB(90, 90, 120)

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = ReplicatedStorage
local function remote(className: string, name: string): any
	local r = Instance.new(className)
	r.Name = name
	r.Parent = remotes
	return r
end
local NotifyRemote = remote("RemoteEvent", "Notify")
local RoleRemote = remote("RemoteEvent", "Role")
local BatRemote = remote("RemoteEvent", "Bat")
local GunRemote = remote("RemoteEvent", "Gun")
local TracerRemote = remote("RemoteEvent", "Tracer")
local CrateRemote = remote("RemoteFunction", "OpenCrate")
local EquipRemote = remote("RemoteFunction", "EquipSkin")

local function notify(player: Player?, text: string, color: Color3?)
	if player then
		NotifyRemote:FireClient(player, text, color)
	else
		NotifyRemote:FireAllClients(text, color)
	end
end

---------------------------------------------------------------- lobby + mansion map

local world = Instance.new("Folder")
world.Name = "World"
world.Parent = workspace
local function part(props): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = world
	return p
end
part({ Name = "Lobby", Size = Vector3.new(60, 2, 60), Position = Vector3.new(0, -1, 0), Color = Color3.fromRGB(230, 225, 240), Material = Enum.Material.Marble })
local spawn = Instance.new("SpawnLocation")
spawn.Anchored = true
spawn.Size = Vector3.new(12, 1, 12)
spawn.Position = Vector3.new(0, 0.5, 0)
spawn.Neutral = true
spawn.Parent = world
if BrainrotModels.Has("tung") then
	local statue = BrainrotModels.Build("tung", { Scale = 2 })
	statue:PivotTo(CFrame.new(0, statue:GetAttribute("RootHeight"), 24) * CFrame.Angles(0, math.pi, 0))
	statue.Parent = world
end

local MANSION = Vector3.new(0, 0, 300)
local SIZE = 120
part({ Name = "MansionFloor", Size = Vector3.new(SIZE, 2, SIZE), Position = MANSION - Vector3.new(0, 1, 0), Color = Color3.fromRGB(150, 110, 75), Material = Enum.Material.WoodPlanks })
for _, s in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
	part({ Size = if s[1] ~= 0 then Vector3.new(2, 16, SIZE) else Vector3.new(SIZE, 16, 2), Position = MANSION + Vector3.new(s[1] * SIZE / 2, 8, s[2] * SIZE / 2), Color = Color3.fromRGB(120, 60, 60), Material = Enum.Material.Brick })
end
-- Interior walls on a grid with doorways.
local rng = Random.new(99)
for gx = -2, 2 do
	for gz = -2, 2 do
		local c = MANSION + Vector3.new(gx * 24, 0, gz * 24)
		if gx < 2 and rng:NextNumber() < 0.7 then
			part({ Size = Vector3.new(1, 12, 9), Position = c + Vector3.new(12, 6, -7.5), Color = Color3.fromRGB(200, 185, 160), Material = Enum.Material.Plaster })
			part({ Size = Vector3.new(1, 12, 9), Position = c + Vector3.new(12, 6, 7.5), Color = Color3.fromRGB(200, 185, 160), Material = Enum.Material.Plaster })
		end
		if gz < 2 and rng:NextNumber() < 0.7 then
			part({ Size = Vector3.new(9, 12, 1), Position = c + Vector3.new(-7.5, 6, 12), Color = Color3.fromRGB(200, 185, 160), Material = Enum.Material.Plaster })
			part({ Size = Vector3.new(9, 12, 1), Position = c + Vector3.new(7.5, 6, 12), Color = Color3.fromRGB(200, 185, 160), Material = Enum.Material.Plaster })
		end
		if rng:NextNumber() < 0.4 then
			part({ Size = Vector3.new(6, 3, 3), Position = c + Vector3.new(rng:NextNumber(-6, 6), 1.5, rng:NextNumber(-6, 6)), Color = Color3.fromRGB(90, 50, 40), Material = Enum.Material.Fabric })
		end
		local lamp = part({ Size = Vector3.new(1, 1, 1), Position = c + Vector3.new(0, 11, 0), Color = Color3.fromRGB(255, 220, 150), Material = Enum.Material.Neon, CanCollide = false })
		local light = Instance.new("PointLight")
		light.Range = 22
		light.Brightness = 1.5
		light.Parent = lamp
	end
end
local coinFolder = Instance.new("Folder")
coinFolder.Name = "Coins"
coinFolder.Parent = workspace

local function randomMansionPoint(): Vector3
	return MANSION + Vector3.new(rng:NextNumber(-SIZE / 2 + 4, SIZE / 2 - 4), 3, rng:NextNumber(-SIZE / 2 + 4, SIZE / 2 - 4))
end

---------------------------------------------------------------- data helpers

local function sync(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	player:SetAttribute("Coins", data.Coins)
	player:SetAttribute("Wins", data.Wins)
	player:SetAttribute("BatSkin", data.BatSkin)
	player:SetAttribute("GunSkin", data.GunSkin)
	player:SetAttribute("SahurPerk", data.SahurPerk)
	player:SetAttribute("SheriffPerk", data.SheriffPerk)
	local owned = {}
	for id in data.Skins do
		table.insert(owned, id)
	end
	player:SetAttribute("OwnedSkins", table.concat(owned, ","))
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats.Wins.Value = data.Wins
		stats.Coins.Value = data.Coins
	end
end

local function coinMult(player: Player): number
	local m = 1
	if MonetizationService.OwnsPass(player, "DoubleCoins") then
		m *= 2
	end
	if MonetizationService.OwnsPass(player, "VIP") then
		m *= 1.5
	end
	return m
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function makeWeapon(kind: string, skinId: string): Tool
	local skin = Config.SkinById[skinId] or Config.SkinById[if kind == "Bat" then "bat_wood" else "gun_basic"]
	local tool = Instance.new("Tool")
	tool.Name = kind
	tool.CanBeDropped = false
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = if kind == "Bat" then Vector3.new(0.4, 4.4, 0.4) else Vector3.new(0.4, 1.0, 1.8)
	handle.Color = skin.Color
	handle.Material = (Enum.Material :: any)[skin.Material]
	handle.CanCollide = false
	handle.Parent = tool
	if kind == "Bat" then
		tool.GripPos = Vector3.new(0, -1.6, 0)
		local barrel = Instance.new("Part")
		barrel.Shape = Enum.PartType.Cylinder
		barrel.Size = Vector3.new(2.0, 0.75, 0.75)
		barrel.Color = skin.Color
		barrel.Material = handle.Material
		barrel.CanCollide = false
		barrel.Massless = true
		barrel.CFrame = handle.CFrame * CFrame.new(0, 1.7, 0) * CFrame.Angles(0, 0, math.rad(90))
		local w = Instance.new("WeldConstraint")
		w.Part0 = handle
		w.Part1 = barrel
		w.Parent = barrel
		barrel.Parent = tool
	end
	return tool
end

---------------------------------------------------------------- round state

local round = { Active = false, Sahur = nil :: Player?, Sheriff = nil :: Player?, Hero = nil :: Player?, Coins = {} :: { [Player]: number }, Over = false, Winner = "" }
local lastBat: { [Player]: number } = {}
local lastGun: { [Player]: number } = {}
local droppedGun: BasePart? = nil

local function alive(): { Player }
	local list = {}
	for _, p in Players:GetPlayers() do
		if p:GetAttribute("InRound") and rootOf(p) then
			table.insert(list, p)
		end
	end
	return list
end

local function endRound(winner: string)
	if round.Over then
		return
	end
	round.Over = true
	round.Winner = winner
end

local function clearDroppedGun()
	if droppedGun then
		droppedGun:Destroy()
		droppedGun = nil
	end
end

local function dropGun(at: Vector3)
	clearDroppedGun()
	local gun = part({ Name = "DroppedGun", Size = Vector3.new(0.6, 1, 2), Position = at + Vector3.new(0, 1, 0), Color = Color3.fromRGB(80, 120, 255), Material = Enum.Material.Neon, CanCollide = false })
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "PickupGun"
	prompt.ActionText = "Pick up Gun"
	prompt.RequiresLineOfSight = false
	prompt.Parent = gun
	prompt.Triggered:Connect(function(player)
		if not round.Active or player == round.Sahur or not player:GetAttribute("InRound") or not rootOf(player) then
			return
		end
		clearDroppedGun()
		round.Hero = player
		player:SetAttribute("Role", "Hero")
		local data = DataService.Get(player)
		makeWeapon("Gun", data and data.GunSkin or "gun_basic").Parent = player:FindFirstChildOfClass("Backpack")
		RoleRemote:FireClient(player, "Hero")
		notify(nil, "Someone picked up the gun!", Color3.fromRGB(80, 160, 255))
	end)
	droppedGun = gun
	notify(nil, "The Sheriff fell! The gun dropped — innocents can grab it!", Color3.fromRGB(80, 160, 255))
end

local function kill(victim: Player, by: Player?)
	local character = victim.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	local root = rootOf(victim)
	local at = if root then root.Position else MANSION
	humanoid.Health = 0
	victim:SetAttribute("InRound", false)
	if victim == round.Sahur then
		notify(nil, "TUNG TUNG SAHUR WAS STOPPED by " .. (if by then by.DisplayName else "someone") .. "!", Color3.fromRGB(90, 255, 90))
		if by then
			local data = DataService.Get(by)
			if data then
				data.Coins += math.floor(Config.WinCoins * coinMult(by))
				sync(by)
			end
		end
		endRound("Innocents")
		return
	end
	if victim == round.Sheriff or victim == round.Hero then
		dropGun(at)
	end
end

BatRemote.OnServerEvent:Connect(function(player)
	if not round.Active or round.Over or player ~= round.Sahur then
		return
	end
	local root = rootOf(player)
	if not root or not (player.Character and player.Character:FindFirstChild("Bat")) then
		return
	end
	local now = os.clock()
	if now - (lastBat[player] or 0) < Config.BatCooldown then
		return
	end
	lastBat[player] = now
	local best, bestDist = nil, Config.BatRange
	for _, p in alive() do
		if p ~= player then
			local r = rootOf(p) :: BasePart
			local d = (r.Position - root.Position).Magnitude
			if d <= bestDist then
				best, bestDist = p, d
			end
		end
	end
	if best then
		kill(best, player)
	end
end)

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
GunRemote.OnServerEvent:Connect(function(player, target)
	if not round.Active or round.Over or typeof(target) ~= "Vector3" then
		return
	end
	if player ~= round.Sheriff and player ~= round.Hero then
		return
	end
	local head = player.Character and player.Character:FindFirstChild("Head") :: BasePart?
	if not head or not player.Character:FindFirstChild("Gun") then
		return
	end
	local now = os.clock()
	if now - (lastGun[player] or 0) < Config.GunCooldown then
		return
	end
	lastGun[player] = now
	local dir = target - head.Position
	if dir.Magnitude < 0.1 then
		return
	end
	rayParams.FilterDescendantsInstances = { player.Character, coinFolder }
	local hit = workspace:Raycast(head.Position, dir.Unit * Config.GunRange, rayParams)
	local endPos = if hit then hit.Position else head.Position + dir.Unit * Config.GunRange
	TracerRemote:FireAllClients(head.Position, endPos)
	local victimModel = hit and hit.Instance:FindFirstAncestorOfClass("Model")
	local victim = victimModel and Players:GetPlayerFromCharacter(victimModel)
	if victim and victim:GetAttribute("InRound") then
		if victim == round.Sahur then
			kill(victim, player)
		else
			-- Shot an innocent: both die, gun drops.
			kill(victim, player)
			notify(nil, player.DisplayName .. " shot an innocent!", Color3.fromRGB(255, 90, 90))
			kill(player, nil)
		end
	end
end)

---------------------------------------------------------------- coins

local function spawnCoin()
	local coin = part({ Name = "Coin", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 1.6, 1.6), Position = randomMansionPoint(), Color = Color3.fromRGB(255, 200, 40), Material = Enum.Material.Neon, CanCollide = false })
	coin.CFrame *= CFrame.Angles(0, 0, math.rad(90))
	coin.Parent = coinFolder
	coin.Touched:Connect(function(hit)
		local character = hit:FindFirstAncestorOfClass("Model")
		local player = character and Players:GetPlayerFromCharacter(character)
		if not player or not round.Active or not player:GetAttribute("InRound") or not coin.Parent then
			return
		end
		local cap = if MonetizationService.OwnsPass(player, "VIP") then Config.VIPCoinBag else Config.CoinBag
		if (round.Coins[player] or 0) >= cap then
			return
		end
		coin:Destroy()
		round.Coins[player] = (round.Coins[player] or 0) + 1
		player:SetAttribute("RoundCoins", round.Coins[player])
	end)
end

---------------------------------------------------------------- round loop

local function pickWeighted(pool: { Player }, perkKey: string): Player
	local total = 0
	local weights = {}
	for i, p in pool do
		local data = DataService.Get(p)
		weights[i] = 1 + (if data and data[perkKey] > 0 then 15 else 0)
		total += weights[i]
	end
	local r = math.random() * total
	for i, p in pool do
		r -= weights[i]
		if r <= 0 then
			return p
		end
	end
	return pool[#pool]
end

task.spawn(function()
	while true do
		for t = Config.Intermission, 1, -1 do
			workspace:SetAttribute("RoundState", "Intermission")
			workspace:SetAttribute("TimeLeft", t)
			task.wait(1)
		end
		local pool = {}
		for _, p in Players:GetPlayers() do
			if DataService.Get(p) and rootOf(p) then
				table.insert(pool, p)
			end
		end
		local minPlayers = if RunService:IsStudio() then 1 else Config.MinPlayers
		if #pool < minPlayers then
			workspace:SetAttribute("RoundState", "Waiting")
			task.wait(2)
			continue
		end
		round.Active = true
		round.Over = false
		round.Winner = ""
		round.Hero = nil
		round.Coins = {}
		table.clear(lastBat)
		table.clear(lastGun)
		round.Sahur = pickWeighted(pool, "SahurPerk")
		local rest = {}
		for _, p in pool do
			if p ~= round.Sahur then
				table.insert(rest, p)
			end
		end
		round.Sheriff = if #rest > 0 then pickWeighted(rest, "SheriffPerk") else nil
		for _, p in pool do
			local data = DataService.Get(p)
			local role = if p == round.Sahur then "Sahur" elseif p == round.Sheriff then "Sheriff" else "Innocent"
			if data then
				if role == "Sahur" and data.SahurPerk > 0 then
					data.SahurPerk -= 1
				elseif role == "Sheriff" and data.SheriffPerk > 0 then
					data.SheriffPerk -= 1
				end
				sync(p)
			end
			p:SetAttribute("Role", role)
			p:SetAttribute("InRound", true)
			p:SetAttribute("RoundCoins", 0)
			p.Character:PivotTo(CFrame.new(randomMansionPoint()))
			RoleRemote:FireClient(p, role)
			local backpack = p:FindFirstChildOfClass("Backpack")
			if role == "Sahur" then
				makeWeapon("Bat", data and data.BatSkin or "bat_wood").Parent = backpack
			elseif role == "Sheriff" then
				makeWeapon("Gun", data and data.GunSkin or "gun_basic").Parent = backpack
			end
		end
		coinFolder:ClearAllChildren()
		for _ = 1, 25 do
			spawnCoin()
		end
		workspace:SetAttribute("RoundState", "Playing")
		local started = os.clock()
		local nextCoin = os.clock()
		while not round.Over do
			local left = Config.RoundTime - (os.clock() - started)
			workspace:SetAttribute("TimeLeft", math.ceil(left))
			local living = alive()
			workspace:SetAttribute("AliveCount", #living)
			if left <= 0 then
				endRound("Innocents")
			elseif round.Sahur and not round.Sahur:GetAttribute("InRound") then
				endRound("Innocents")
			else
				local innocents = 0
				for _, p in living do
					if p ~= round.Sahur then
						innocents += 1
					end
				end
				if innocents == 0 and #pool > 1 then
					endRound("Sahur")
				end
			end
			-- Coin Magnet pass: collect coins within 14 studs.
			for _, p in living do
				if MonetizationService.OwnsPass(p, "CoinMagnet") then
					local r = rootOf(p)
					local cap = if MonetizationService.OwnsPass(p, "VIP") then Config.VIPCoinBag else Config.CoinBag
					for _, coin in coinFolder:GetChildren() do
						if r and (round.Coins[p] or 0) < cap and coin:IsA("BasePart") and (coin.Position - r.Position).Magnitude <= 14 then
							coin:Destroy()
							round.Coins[p] = (round.Coins[p] or 0) + 1
							p:SetAttribute("RoundCoins", round.Coins[p])
						end
					end
				end
			end
			if os.clock() >= nextCoin and #coinFolder:GetChildren() < 40 then
				nextCoin = os.clock() + 2
				spawnCoin()
			end
			task.wait(0.25)
		end
		-- rewards
		local sahur = round.Sahur
		for _, p in pool do
			local data = DataService.Get(p)
			if data and p.Parent then
				local earned = round.Coins[p] or 0
				local won = (round.Winner == "Sahur" and p == sahur) or (round.Winner == "Innocents" and p ~= sahur)
				if won then
					earned += Config.WinCoins
					data.Wins += 1
				end
				data.Coins += math.floor(earned * coinMult(p))
				sync(p)
			end
		end
		notify(nil, if round.Winner == "Sahur" then "TUNG TUNG SAHUR WINS! It was " .. (if sahur then sahur.DisplayName else "?") else "INNOCENTS WIN! Sahur was " .. (if sahur then sahur.DisplayName else "?"), if round.Winner == "Sahur" then Color3.fromRGB(255, 70, 70) else Color3.fromRGB(90, 255, 90))
		round.Active = false
		clearDroppedGun()
		coinFolder:ClearAllChildren()
		for _, p in Players:GetPlayers() do
			p:SetAttribute("Role", nil)
			p:SetAttribute("InRound", false)
			for _, container in { p:FindFirstChildOfClass("Backpack"), p.Character } do
				for _, name in { "Bat", "Gun" } do
					local tool = container and container:FindFirstChild(name)
					if tool then
						tool:Destroy()
					end
				end
			end
			if rootOf(p) then
				p.Character:PivotTo(CFrame.new(0, 4, 0))
			end
		end
		workspace:SetAttribute("RoundState", "Ended")
		task.wait(5)
	end
end)

---------------------------------------------------------------- crates + skins

CrateRemote.OnServerInvoke = function(player)
	local data = DataService.Get(player)
	if not data then
		return false, "Loading..."
	end
	if data.Coins < Config.CrateCost then
		return false, "Need " .. Config.CrateCost .. " coins!"
	end
	data.Coins -= Config.CrateCost
	local total = 0
	for _, r in Config.Rarities do
		total += r.Weight
	end
	local roll = math.random() * total
	local rarity = Config.Rarities[1].Name
	for _, r in Config.Rarities do
		roll -= r.Weight
		if roll <= 0 then
			rarity = r.Name
			break
		end
	end
	local pool = {}
	for _, s in Config.Skins do
		if s.Rarity == rarity then
			table.insert(pool, s.Id)
		end
	end
	local id = pool[math.random(1, #pool)]
	data.Skins[id] = (data.Skins[id] or 0) + 1
	local skin = Config.SkinById[id]
	if rarity == "Legendary" or rarity == "Godly" then
		notify(nil, player.DisplayName .. " unboxed " .. rarity .. " " .. skin.Name .. "!", Config.RarityColor[rarity])
	end
	sync(player)
	return true, id
end

EquipRemote.OnServerInvoke = function(player, id)
	local data = DataService.Get(player)
	local skin = type(id) == "string" and Config.SkinById[id]
	if not data or not skin or not data.Skins[id] then
		return false
	end
	if skin.Kind == "Bat" then
		data.BatSkin = id
	else
		data.GunSkin = id
	end
	sync(player)
	return true
end

---------------------------------------------------------------- players + monetization

DataService.ProfileLoaded:Connect(function(player, data)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, name in { "Wins", "Coins" } do
		local v = Instance.new("IntValue")
		v.Name = name
		v.Parent = stats
	end
	stats.Parent = player
	sync(player)
end)

Players.PlayerRemoving:Connect(function(player)
	lastBat[player] = nil
	lastGun[player] = nil
	if round.Active and player == round.Sahur then
		notify(nil, "Sahur left the game!", Color3.fromRGB(255, 200, 80))
		endRound("Innocents")
	elseif round.Active and (player == round.Sheriff or player == round.Hero) then
		local root = rootOf(player)
		dropGun(if root then root.Position else MANSION)
	end
end)

MonetizationService.Init({
	Passes = Config.Passes,
	Products = Config.Products,
	ProductHandlers = {
		SahurPerk = function(player, data)
			data.SahurPerk += 1
			sync(player)
			notify(player, "You're very likely to be Sahur next round!", Color3.fromRGB(255, 80, 80))
			return true
		end,
		SheriffPerk = function(player, data)
			data.SheriffPerk += 1
			sync(player)
			notify(player, "You're very likely to be Sheriff next round!", Color3.fromRGB(80, 160, 255))
			return true
		end,
		CoinPack = function(player, data)
			data.Coins += 1000
			sync(player)
			return true
		end,
	},
	OnPassOwned = function(player, name)
		notify(player, "Unlocked " .. name .. "!", Color3.fromRGB(255, 215, 0))
	end,
})

DataService.Init("SahurMystery_v1", {
	Coins = 0,
	Wins = 0,
	Skins = { bat_wood = 1, gun_basic = 1 },
	BatSkin = "bat_wood",
	GunSkin = "gun_basic",
	SahurPerk = 0,
	SheriffPerk = 0,
})
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="14">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="15">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="16">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="17">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Sahur Mystery client: role reveal, bat/gun use, tracers, coins HUD, crates + skins, perks, shop.
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Common.Format)
local ShopUI = require(ReplicatedStorage.Common.ShopUI)
local UI = require(ReplicatedStorage.Common.UI)

local player = Players.LocalPlayer
local mouse = player:GetMouse()
local remotes = ReplicatedStorage:WaitForChild("Remotes")

local gui = UI.new("ScreenGui", { Name = "HUD", ResetOnSpawn = false, Parent = player:WaitForChild("PlayerGui") }) :: ScreenGui
local toast = UI.CreateToaster(gui)
remotes:WaitForChild("Notify").OnClientEvent:Connect(toast)
local buy = ShopUI.Buyer(Config, toast)
local shop = ShopUI.Create(gui, Config, buy, Color3.fromRGB(35, 30, 45))
ShopUI.VIPChatTag("VIP")

local top = UI.new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 6),
	Size = UDim2.fromOffset(400, 80),
	BackgroundColor3 = Color3.fromRGB(30, 25, 40),
	BackgroundTransparency = 0.15,
	Parent = gui,
}, { UI.Corner(14), UI.Stroke(Color3.new(0, 0, 0), 3) })
local stateLabel = UI.Label("", { Size = UDim2.new(1, -10, 0, 40), Position = UDim2.fromOffset(5, 2), Parent = top })
local coinsLabel = UI.Label("", { Size = UDim2.new(1, -10, 0, 28), Position = UDim2.fromOffset(5, 46), TextColor3 = Color3.fromRGB(255, 210, 60), Parent = top })
local roleLabel = UI.Label("", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -24), Size = UDim2.fromOffset(420, 40), Parent = gui })

local function refresh()
	local cap = if player:GetAttribute("Pass_VIP") then Config.VIPCoinBag else Config.CoinBag
	coinsLabel.Text = string.format("🪙 %s coins  •  this round %d/%d  •  %d wins", Format.Abbreviate(player:GetAttribute("Coins") or 0), player:GetAttribute("RoundCoins") or 0, cap, player:GetAttribute("Wins") or 0)
	local role = player:GetAttribute("Role")
	roleLabel.Text = if role == "Sahur" then "You are TUNG TUNG SAHUR" elseif role == "Sheriff" then "You are the SHERIFF" elseif role == "Hero" then "You are the HERO" elseif role == "Innocent" then "You are INNOCENT" else ""
	roleLabel.TextColor3 = if role == "Sahur" then Color3.fromRGB(255, 70, 70) elseif role == "Sheriff" or role == "Hero" then Color3.fromRGB(90, 160, 255) else Color3.fromRGB(90, 255, 120)
end
player.AttributeChanged:Connect(refresh)
refresh()

task.spawn(function()
	while true do
		local state = workspace:GetAttribute("RoundState")
		local t = workspace:GetAttribute("TimeLeft") or 0
		stateLabel.Text = if state == "Playing" then Format.Time(t) .. "  •  " .. (workspace:GetAttribute("AliveCount") or 0) .. " alive" elseif state == "Intermission" then "Next round in " .. t elseif state == "Waiting" then "Waiting for players..." else "Round over!"
		task.wait(0.25)
	end
end)

-- Big role reveal at round start.
local reveal = UI.Label("", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.4), Size = UDim2.fromOffset(700, 110), Visible = false, Parent = gui })
local REVEAL = {
	Sahur = { "YOU ARE TUNG TUNG SAHUR", "Bonk everyone with your bat!", Color3.fromRGB(255, 70, 70) },
	Sheriff = { "YOU ARE THE SHERIFF", "Find Sahur and shoot them!", Color3.fromRGB(90, 160, 255) },
	Hero = { "YOU ARE THE HERO", "You grabbed the gun — stop Sahur!", Color3.fromRGB(90, 160, 255) },
	Innocent = { "YOU ARE INNOCENT", "Hide, collect coins, survive!", Color3.fromRGB(90, 255, 120) },
}
remotes:WaitForChild("Role").OnClientEvent:Connect(function(role)
	local r = REVEAL[role]
	if not r then
		return
	end
	reveal.Text = r[1] .. "\n" .. r[2]
	reveal.TextColor3 = r[3]
	reveal.Visible = true
	task.delay(3, function()
		reveal.Visible = false
	end)
end)

---------------------------------------------------------------- weapons

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or input.UserInputType ~= Enum.UserInputType.MouseButton1 then
		return
	end
	local character = player.Character
	if character and character:FindFirstChild("Bat") then
		remotes.Bat:FireServer()
	elseif character and character:FindFirstChild("Gun") then
		mouse.TargetFilter = character
		remotes.Gun:FireServer(mouse.Hit.Position)
	end
end)

remotes:WaitForChild("Tracer").OnClientEvent:Connect(function(from: Vector3, to: Vector3)
	local beam = Instance.new("Part")
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.CanTouch = false
	beam.Material = Enum.Material.Neon
	beam.Color = Color3.fromRGB(255, 240, 150)
	beam.Size = Vector3.new(0.15, 0.15, (to - from).Magnitude)
	beam.CFrame = CFrame.lookAt((from + to) / 2, to)
	beam.Parent = workspace
	TweenService:Create(beam, TweenInfo.new(0.25), { Transparency = 1 }):Play()
	Debris:AddItem(beam, 0.3)
end)

---------------------------------------------------------------- skins + crates

local skinsFrame = UI.new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.new(0, 540, 0.72, 0),
	BackgroundColor3 = Color3.fromRGB(35, 30, 45),
	Visible = false,
	Parent = gui,
}, { UI.Corner(18), UI.Stroke(Color3.new(0, 0, 0), 4) }) :: Frame
UI.Label("WEAPON SKINS", { Size = UDim2.new(1, -80, 0, 50), Position = UDim2.fromOffset(16, 6), TextXAlignment = Enum.TextXAlignment.Left, Parent = skinsFrame })
UI.Button("X", Color3.fromRGB(230, 60, 60), { Size = UDim2.fromOffset(48, 48), Position = UDim2.new(1, -58, 0, 8), Parent = skinsFrame }).Activated:Connect(function()
	skinsFrame.Visible = false
end)
local crateButton = UI.Button("OPEN CRATE (" .. Config.CrateCost .. " coins)", Color3.fromRGB(255, 170, 0), { Position = UDim2.fromOffset(16, 62), Size = UDim2.new(1, -32, 0, 52), Parent = skinsFrame })
local odds = {}
for _, r in Config.Rarities do
	table.insert(odds, r.Name .. " " .. r.Weight .. "%")
end
UI.Label(table.concat(odds, " • "), { Position = UDim2.fromOffset(16, 118), Size = UDim2.new(1, -32, 0, 22), Font = Enum.Font.GothamMedium, Parent = skinsFrame })
local skinList = UI.new("ScrollingFrame", { Position = UDim2.fromOffset(12, 146), Size = UDim2.new(1, -24, 1, -158), BackgroundTransparency = 1, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollBarThickness = 8, Parent = skinsFrame })
local skinLayout = Instance.new("UIListLayout")
skinLayout.Padding = UDim.new(0, 6)
skinLayout.SortOrder = Enum.SortOrder.LayoutOrder
skinLayout.Parent = skinList

local function renderSkins()
	for _, c in skinList:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	local owned = {}
	for id in string.gmatch(player:GetAttribute("OwnedSkins") or "", "[^,]+") do
		owned[id] = true
	end
	for i, skin in Config.Skins do
		local has = owned[skin.Id]
		local row = UI.new("Frame", { LayoutOrder = i, Size = UDim2.new(1, -10, 0, 52), BackgroundColor3 = Color3.fromRGB(55, 48, 70), Parent = skinList }, { UI.Corner(10) })
		UI.Label((if has then skin.Name else "??? ") .. "  (" .. skin.Kind .. ", " .. skin.Rarity .. ")", { Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -150, 1, -8), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Config.RarityColor[skin.Rarity], Parent = row })
		if has then
			local equipped = player:GetAttribute(skin.Kind .. "Skin") == skin.Id
			local b = UI.Button(if equipped then "EQUIPPED" else "EQUIP", if equipped then Color3.fromRGB(90, 90, 90) else Color3.fromRGB(40, 180, 70), { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(120, 42), Parent = row })
			b.Activated:Connect(function()
				remotes.EquipSkin:InvokeServer(skin.Id)
				renderSkins()
			end)
		end
	end
end
crateButton.Activated:Connect(function()
	local ok, result = remotes.OpenCrate:InvokeServer()
	if not ok then
		toast(result, Color3.fromRGB(255, 90, 90))
		buy("Product", "CoinPack")
		return
	end
	local skin = Config.SkinById[result]
	toast("You got " .. skin.Name .. " (" .. skin.Rarity .. ")!", Config.RarityColor[skin.Rarity])
	renderSkins()
end)

local side = ShopUI.SideBar(gui)
UI.Button("SKINS", Color3.fromRGB(255, 120, 40), { Size = UDim2.fromOffset(130, 52), Parent = side }).Activated:Connect(function()
	shop.Visible = false
	skinsFrame.Visible = not skinsFrame.Visible
	if skinsFrame.Visible then
		renderSkins()
	end
end)
UI.Button("BE SAHUR", Color3.fromRGB(220, 50, 50), { Size = UDim2.fromOffset(130, 52), Parent = side }).Activated:Connect(function()
	buy("Product", "SahurPerk")
end)
UI.Button("BE SHERIFF", Color3.fromRGB(60, 120, 255), { Size = UDim2.fromOffset(130, 52), Parent = side }).Activated:Connect(function()
	buy("Product", "SheriffPerk")
end)
UI.Button("SHOP", Color3.fromRGB(40, 180, 70), { Size = UDim2.fromOffset(130, 52), Parent = side }).Activated:Connect(function()
	skinsFrame.Visible = false
	shop.Visible = not shop.Visible
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
