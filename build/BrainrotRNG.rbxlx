      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[-- Number formatting helpers shared by every game.
local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

function Format.Abbreviate(n: number): string
	if n ~= n then
		return "0"
	end
	local negative = n < 0
	n = math.abs(n)
	local index = 1
	while n >= 1000 and index < #SUFFIXES do
		n /= 1000
		index += 1
	end
	local text
	if index == 1 then
		text = tostring(math.floor(n))
	elseif n >= 100 then
		text = string.format("%d%s", math.floor(n), SUFFIXES[index])
	else
		text = string.format("%.2f", math.floor(n * 100) / 100):gsub("%.?0+$", "") .. SUFFIXES[index]
	end
	return (negative and "-" or "") .. text
end

function Format.Cash(n: number): string
	return "$" .. Format.Abbreviate(n)
end

function Format.Time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local m = math.floor(seconds / 60)
	local s = seconds % 60
	if m >= 60 then
		return string.format("%dh %02dm", math.floor(m / 60), m % 60)
	end
	return string.format("%d:%02d", m, s)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">ShopUI</string>
          <string name="Source"><![CDATA[-- Shared Robux shop window + purchase helper used by every game's client.
-- Expects Config.Passes/Products (name -> id) and Config.PassInfo/ProductInfo (display rows).
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local UI = require(script.Parent.UI)

local ShopUI = {}

function ShopUI.Buyer(config, toast: (string, Color3?) -> ())
	local player = Players.LocalPlayer
	local testPurchase = ReplicatedStorage:WaitForChild("StudioTestPurchase")
	return function(kind: string, key: string)
		if kind == "Pass" and player:GetAttribute("Pass_" .. key) then
			return
		end
		local id = if kind == "Pass" then config.Passes[key] else config.Products[key]
		if id and id > 0 then
			if kind == "Pass" then
				MarketplaceService:PromptGamePassPurchase(player, id)
			else
				MarketplaceService:PromptProductPurchase(player, id)
			end
		elseif RunService:IsStudio() then
			testPurchase:FireServer(kind, key)
			toast("[Studio test] granted " .. key, Color3.fromRGB(255, 215, 0))
		else
			toast("Coming soon!", Color3.fromRGB(255, 90, 90))
		end
	end
end

-- Returns the (hidden) shop frame; toggle its Visible to open it.
function ShopUI.Create(gui: ScreenGui, config, buy: (string, string) -> (), theme: Color3?): Frame
	local player = Players.LocalPlayer
	local bg = theme or Color3.fromRGB(40, 40, 60)
	local frame = UI.new("Frame", {
		Name = "Shop",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 520, 0.7, 0),
		BackgroundColor3 = bg,
		Visible = false,
		ZIndex = 5,
		Parent = gui,
	}, { UI.Corner(18), UI.Stroke(Color3.new(0, 0, 0), 4) }) :: Frame
	local c = Instance.new("UISizeConstraint")
	c.MaxSize = Vector2.new(math.huge, 560)
	c.Parent = frame
	UI.Label("SHOP", { Size = UDim2.new(1, -80, 0, 50), Position = UDim2.fromOffset(16, 6), TextXAlignment = Enum.TextXAlignment.Left, Parent = frame })
	UI.Button("X", Color3.fromRGB(230, 60, 60), { Size = UDim2.fromOffset(48, 48), Position = UDim2.new(1, -58, 0, 8), Parent = frame }).Activated:Connect(function()
		frame.Visible = false
	end)
	local list = UI.new("ScrollingFrame", {
		Position = UDim2.fromOffset(12, 64),
		Size = UDim2.new(1, -24, 1, -76),
		BackgroundTransparency = 1,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 8,
		Parent = frame,
	})
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list

	local order = 0
	local function item(info, kind: string)
		order += 1
		local row = UI.new("Frame", { Size = UDim2.new(1, -10, 0, 74), BackgroundColor3 = bg:Lerp(Color3.new(1, 1, 1), 0.12), LayoutOrder = order, Parent = list }, { UI.Corner(12) })
		UI.Label(info.Name, { Position = UDim2.fromOffset(12, 4), Size = UDim2.new(1, -150, 0, 32), TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
		UI.Label(info.Description, { Position = UDim2.fromOffset(12, 38), Size = UDim2.new(1, -150, 0, 28), TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamMedium, TextColor3 = Color3.fromRGB(215, 215, 230), Parent = row })
		local b = UI.Button("R$ " .. info.Price, if kind == "Pass" then Color3.fromRGB(40, 180, 70) else Color3.fromRGB(40, 140, 230), {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(120, 52),
			Parent = row,
		})
		if kind == "Pass" then
			local function owned()
				if player:GetAttribute("Pass_" .. info.Key) then
					b.Text = "OWNED"
					b.BackgroundColor3 = Color3.fromRGB(90, 90, 90)
				end
			end
			player:GetAttributeChangedSignal("Pass_" .. info.Key):Connect(owned)
			owned()
		end
		b.Activated:Connect(function()
			buy(kind, info.Key)
		end)
	end
	for _, info in config.ProductInfo do
		item(info, "Product")
	end
	for _, info in config.PassInfo do
		item(info, "Pass")
	end
	return frame
end

-- Gold [VIP] chat tag for players owning the given pass.
function ShopUI.VIPChatTag(passKey: string)
	local TextChatService = game:GetService("TextChatService")
	TextChatService.OnIncomingMessage = function(message)
		local props = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		local speaker = source and Players:GetPlayerByUserId(source.UserId)
		if speaker and speaker:GetAttribute("Pass_" .. passKey) then
			props.PrefixText = "<font color='#FFD700'>[VIP]</font> " .. message.PrefixText
		end
		return props
	end
end

-- Column of big buttons on the left edge.
function ShopUI.SideBar(gui: ScreenGui): Frame
	local side = UI.new("Frame", {
		Name = "SideBar",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Size = UDim2.fromOffset(130, 330),
		BackgroundTransparency = 1,
		Parent = gui,
	}) :: Frame
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 10)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = side
	return side
end

return ShopUI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">UI</string>
          <string name="Source"><![CDATA[-- Tiny helpers for building UI from code so the games need no Studio work.
local UI = {}

function UI.new(className: string, props: { [string]: any }, children: { Instance }?): Instance
	local inst = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			(inst :: any)[key] = value
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function UI.Corner(radius: number?): UICorner
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 10)
	return c
end

function UI.Stroke(color: Color3?, thickness: number?): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color or Color3.new(0, 0, 0)
	s.Thickness = thickness or 2
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	return s
end

function UI.TextStroke(thickness: number?): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = Color3.new(0, 0, 0)
	s.Thickness = thickness or 2
	return s
end

-- Big chunky cartoon button used by every game.
function UI.Button(text: string, color: Color3, props: { [string]: any }?): TextButton
	local button = UI.new("TextButton", {
		Text = text,
		BackgroundColor3 = color,
		TextColor3 = Color3.new(1, 1, 1),
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		AutoButtonColor = true,
		Size = UDim2.fromOffset(160, 50),
	}, { UI.Corner(12), UI.Stroke(Color3.new(0, 0, 0), 3), UI.TextStroke(2) }) :: TextButton
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 6)
	padding.PaddingBottom = UDim.new(0, 6)
	padding.PaddingLeft = UDim.new(0, 8)
	padding.PaddingRight = UDim.new(0, 8)
	padding.Parent = button
	if props then
		for key, value in props do
			(button :: any)[key] = value
		end
	end
	return button
end

function UI.Label(text: string, props: { [string]: any }?): TextLabel
	local label = UI.new("TextLabel", {
		Text = text,
		BackgroundTransparency = 1,
		TextColor3 = Color3.new(1, 1, 1),
		Font = Enum.Font.FredokaOne,
		TextScaled = true,
		Size = UDim2.fromOffset(200, 40),
	}, { UI.TextStroke(2) }) :: TextLabel
	if props then
		for key, value in props do
			(label :: any)[key] = value
		end
	end
	return label
end

-- Toast notifications stacked at the top of the screen.
function UI.CreateToaster(screenGui: ScreenGui)
	local holder = UI.new("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 90),
		Size = UDim2.new(0.6, 0, 0, 300),
		Parent = screenGui,
	})
	local layout = Instance.new("UIListLayout")
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = holder

	local TweenService = game:GetService("TweenService")
	local order = 0
	return function(text: string, color: Color3?)
		order += 1
		local label = UI.Label(text, {
			Size = UDim2.new(1, 0, 0, 32),
			TextColor3 = color or Color3.new(1, 1, 1),
			LayoutOrder = order,
			Parent = holder,
		})
		task.delay(3.5, function()
			local tween = TweenService:Create(label, TweenInfo.new(0.5), { TextTransparency = 1 })
			tween:Play()
			tween.Completed:Wait()
			label:Destroy()
		end)
	end
end

return UI
]]></string>
        </Properties>
      </Item>
