      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Session-locked DataStore saving shared by every game.
-- Keeps each player's data in memory, autosaves, and never lets two servers
-- write the same player at once (prevents item duplication / rollbacks).
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local DataService = {}

local AUTOSAVE_INTERVAL = 90
local LOCK_EXPIRE = 600
local LOAD_ATTEMPTS = 6

local profiles: { [Player]: { [string]: any } } = {}
local loadedEvent = Instance.new("BindableEvent")
local releasingEvent = Instance.new("BindableEvent")
DataService.ProfileLoaded = loadedEvent.Event -- (player, data)
DataService.ProfileReleasing = releasingEvent.Event -- (player, data) fired before the final save

local store: DataStore? = nil
local memoryStore: { [string]: any } = {}
local template: { [string]: any } = {}
local initialized = false

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end
DataService.DeepCopy = deepCopy

local function reconcile(data, tmpl)
	for key, value in tmpl do
		if data[key] == nil then
			data[key] = deepCopy(value)
		elseif type(value) == "table" and type(data[key]) == "table" and next(value) ~= nil and #value == 0 then
			reconcile(data[key], value)
		end
	end
end

local function update(key: string, transform: (any) -> any): (boolean, any)
	if not store then
		local result = transform(memoryStore[key])
		if result ~= nil then
			memoryStore[key] = deepCopy(result)
		end
		return true, result
	end
	local ok, result = pcall(function()
		return (store :: DataStore):UpdateAsync(key, transform)
	end)
	return ok, result
end

local function keyFor(player: Player): string
	return "Player_" .. player.UserId
end

local function loadProfile(player: Player)
	local key = keyFor(player)
	for attempt = 1, LOAD_ATTEMPTS do
		local stealLock = attempt == LOAD_ATTEMPTS
		local lockedElsewhere = false
		local ok, result = update(key, function(stored)
			stored = stored or { Data = deepCopy(template) }
			local lock = stored.Lock
			if lock and lock.JobId ~= game.JobId and os.time() - lock.Time < LOCK_EXPIRE and not stealLock then
				lockedElsewhere = true
				return nil
			end
			stored.Lock = { JobId = game.JobId, Time = os.time() }
			return stored
		end)
		if ok and result and not lockedElsewhere then
			local data = result.Data or deepCopy(template)
			reconcile(data, template)
			return data
		end
		if not ok then
			warn("[DataService] load failed for", player.Name, result)
		end
		task.wait(lockedElsewhere and 5 or 2)
		if not player.Parent then
			return nil
		end
	end
	return nil
end

-- Saves the player's data. `release` clears the session lock (used on leave).
function DataService.Save(player: Player, release: boolean?): boolean
	local data = profiles[player]
	if not data then
		return false
	end
	data.LastSave = os.time()
	local snapshot = deepCopy(data)
	local ok, err = update(keyFor(player), function(stored)
		stored = stored or {}
		if stored.Lock and stored.Lock.JobId ~= game.JobId then
			-- Another server took over this player; never overwrite its data.
			return nil
		end
		stored.Data = snapshot
		stored.Lock = if release then nil else { JobId = game.JobId, Time = os.time() }
		return stored
	end)
	if not ok then
		warn("[DataService] save failed for", player.Name, err)
	end
	return ok
end

function DataService.Get(player: Player): { [string]: any }?
	return profiles[player]
end

function DataService.WaitFor(player: Player, timeout: number?): { [string]: any }?
	local deadline = os.clock() + (timeout or 15)
	while not profiles[player] and player.Parent and os.clock() < deadline do
		task.wait(0.1)
	end
	return profiles[player]
end

local function onPlayerAdded(player: Player)
	local data = loadProfile(player)
	if not player.Parent then
		if data then
			profiles[player] = data
			DataService.Save(player, true)
			profiles[player] = nil
		end
		return
	end
	if not data then
		player:Kick("Your data could not load. Please rejoin in a moment!")
		return
	end
	data.LoginCount = (data.LoginCount or 0) + 1
	profiles[player] = data
	loadedEvent:Fire(player, data)
end

local function onPlayerRemoving(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	releasingEvent:Fire(player, data)
	DataService.Save(player, true)
	profiles[player] = nil
end

function DataService.Init(storeName: string, dataTemplate: { [string]: any })
	assert(not initialized, "DataService already initialized")
	initialized = true
	template = dataTemplate
	template.LastSave = template.LastSave or 0
	template.LoginCount = template.LoginCount or 0
	template.Receipts = template.Receipts or {}
	template.RobuxSpent = template.RobuxSpent or 0

	local ok, result = pcall(function()
		local s = DataStoreService:GetDataStore(storeName)
		if RunService:IsStudio() then
			-- Throws when "Enable Studio Access to API Services" is off.
			s:GetAsync("__probe")
		end
		return s
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStores unavailable, using memory only (turn on API access in Game Settings to save):", result)
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player in profiles do
				task.spawn(DataService.Save, player, false)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				releasingEvent:Fire(player, profiles[player])
				DataService.Save(player, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[-- Game pass ownership + developer product receipts, done safely:
-- every receipt is granted exactly once and saved before Roblox is told it succeeded.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local DataService = require(script.Parent.DataService)

local MonetizationService = {}

type Config = {
	Passes: { [string]: number },
	Products: { [string]: number },
	ProductHandlers: { [string]: (Player, { [string]: any }) -> boolean? },
	OnPassOwned: ((Player, string) -> ())?,
}

local passes: { [string]: number } = {}
local passIdToName: { [number]: string } = {}
local productIdToName: { [number]: string } = {}
local handlers = {}
local onPassOwned: ((Player, string) -> ())? = nil

local MAX_RECEIPTS = 100

local function setPass(player: Player, name: string)
	if player:GetAttribute("Pass_" .. name) then
		return
	end
	player:SetAttribute("Pass_" .. name, true)
	if onPassOwned then
		task.spawn(onPassOwned, player, name)
	end
end

function MonetizationService.OwnsPass(player: Player, name: string): boolean
	return player:GetAttribute("Pass_" .. name) == true
end

local function checkPasses(player: Player)
	for name, id in passes do
		if id and id > 0 then
			task.spawn(function()
				local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, id)
				if ok and owns and player.Parent then
					setPass(player, name)
				end
			end)
		end
	end
end

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = DataService.WaitFor(player, 20)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if table.find(data.Receipts, receipt.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local name = productIdToName[receipt.ProductId]
	local handler = name and handlers[name]
	if not handler then
		warn("[Monetization] no handler for product", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok, result = pcall(handler, player, data)
	if not ok then
		warn("[Monetization] handler error", name, result)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if result == false then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(data.Receipts, receipt.PurchaseId)
	while #data.Receipts > MAX_RECEIPTS do
		table.remove(data.Receipts, 1)
	end
	data.RobuxSpent = (data.RobuxSpent or 0) + (receipt.CurrencySpent or 0)
	if DataService.Save(player, false) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

function MonetizationService.Init(config: Config)
	passes = config.Passes
	handlers = config.ProductHandlers
	onPassOwned = config.OnPassOwned
	for name, id in config.Passes do
		passIdToName[id] = name
	end
	for name, id in config.Products do
		productIdToName[id] = name
	end

	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local name = passIdToName[passId]
		if purchased and name then
			setPass(player, name)
		end
	end)

	-- In Studio, buttons for passes/products whose ID is still 0 grant instantly so you can test.
	local testRemote = Instance.new("RemoteEvent")
	testRemote.Name = "StudioTestPurchase"
	testRemote.Parent = ReplicatedStorage
	testRemote.OnServerEvent:Connect(function(player, kind, name)
		if not RunService:IsStudio() or type(name) ~= "string" then
			return
		end
		if kind == "Pass" and passes[name] ~= nil then
			setPass(player, name)
		elseif kind == "Product" and handlers[name] then
			local data = DataService.Get(player)
			if data then
				handlers[name](player, data)
			end
		end
	end)

	Players.PlayerAdded:Connect(checkPasses)
	for _, player in Players:GetPlayers() do
		checkPasses(player)
	end
end

-- Lets admins / testers grant passes in Studio before IDs exist.
function MonetizationService.GrantPassForTesting(player: Player, name: string)
	setPass(player, name)
end

return MonetizationService
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="11">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="12">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Yoink a Brainrot: buy brainrots off the runway, they earn cash in your base,
-- steal other players' brainrots, lock your base, rebirth for multipliers.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Common.Format)
local DataService = require(ServerScriptService.CommonServer.DataService)
local MonetizationService = require(ServerScriptService.CommonServer.MonetizationService)
local Map = require(script.Parent.Map)
local Models = require(script.Parent.Models)

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = ReplicatedStorage
local NotifyRemote = Instance.new("RemoteEvent")
NotifyRemote.Name = "Notify"
NotifyRemote.Parent = remotes
local RebirthRemote = Instance.new("RemoteFunction")
RebirthRemote.Name = "Rebirth"
RebirthRemote.Parent = remotes

local plots = Map.Build()
local playerPlot: { [Player]: any } = {}
local carrying: { [Player]: any } = {}
local records: { [string]: any } = {} -- uid -> brainrot record
local brainrotFolder = Instance.new("Folder")
brainrotFolder.Name = "Brainrots"
brainrotFolder.Parent = workspace

local function notify(player: Player?, text: string, color: Color3?)
	if player then
		NotifyRemote:FireClient(player, text, color)
	else
		NotifyRemote:FireAllClients(text, color)
	end
end

---------------------------------------------------------------- stats & cash

local function multiplier(player: Player): number
	local data = DataService.Get(player)
	local m = 1 + (data and data.Rebirths or 0) * Config.RebirthBonus
	if MonetizationService.OwnsPass(player, "DoubleCash") then
		m *= 2
	end
	if MonetizationService.OwnsPass(player, "VIP") then
		m *= 1.5
	end
	return m
end

local function income(player: Player): number
	local plot = playerPlot[player]
	if not plot then
		return 0
	end
	local total = 0
	for _, rec in plot.Slots do
		if rec.State == "Placed" then
			total += rec.Info.Income
		end
	end
	return total * multiplier(player)
end

local function updateStats(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	player:SetAttribute("Cash", data.Cash)
	player:SetAttribute("Rebirths", data.Rebirths)
	player:SetAttribute("Multiplier", multiplier(player))
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats.Cash.Value = Format.Cash(data.Cash)
		stats.Rebirths.Value = data.Rebirths
	end
end

local function addCash(player: Player, amount: number)
	local data = DataService.Get(player)
	if not data then
		return
	end
	data.Cash += amount
	if amount > 0 then
		data.TotalEarned = (data.TotalEarned or 0) + amount
	end
	updateStats(player)
end

local function walkSpeed(player: Player): number
	local speed = if carrying[player] then Config.CarrySpeed else Config.WalkSpeed
	if MonetizationService.OwnsPass(player, "SpeedCoil") then
		speed *= Config.SpeedCoilMultiplier
	end
	return speed
end

local function applySpeed(player: Player)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = walkSpeed(player)
	end
end

---------------------------------------------------------------- slots

local function maxSlots(player: Player): number
	return Config.BaseSlots + (if MonetizationService.OwnsPass(player, "ExtraSlots") then Config.ExtraSlots else 0)
end

local function freeSlot(player: Player, limit: number?): number?
	local plot = playerPlot[player]
	if not plot then
		return nil
	end
	for i = 1, limit or maxSlots(player) do
		if not plot.Slots[i] then
			return i
		end
	end
	return nil
end

local function slotCFrame(rec): CFrame
	local height = rec.Model:GetAttribute("RootHeight") or 3
	return rec.Plot.SlotCFrames[rec.Slot] * CFrame.new(0, height, 0)
end

local function setPromptMode(rec)
	-- The client decides which prompts to show from these attributes (owners see Sell, others Steal).
	local mode = rec.State
	rec.Model:SetAttribute("State", mode)
	rec.Model:SetAttribute("OwnerId", if rec.Owner then rec.Owner.UserId else 0)
	rec.Model:SetAttribute("ReservedFor", if rec.ReservedFor then rec.ReservedFor.UserId else 0)
	local tag = rec.Root:FindFirstChild("Tag")
	if tag then
		tag.Price.Visible = mode == "Walking"
	end
end

local function destroyRecord(rec)
	records[rec.Uid] = nil
	if rec.Tween then
		rec.Tween:Cancel()
	end
	if rec.Plot and rec.Plot.Slots[rec.Slot] == rec then
		rec.Plot.Slots[rec.Slot] = nil
	end
	rec.Model:Destroy()
end

-- Places a record into a player's base and writes it into their save data.
local function assignToPlot(rec, player: Player, slot: number, animate: boolean)
	local plot = playerPlot[player]
	local data = DataService.Get(player)
	rec.Owner = player
	rec.Plot = plot
	rec.Slot = slot
	rec.ReservedFor = nil
	plot.Slots[slot] = rec
	data.Brainrots[rec.Uid] = { Id = rec.Info.Id, Slot = slot }
	data.Discovered[rec.Info.Id] = true
	if rec.Tween then
		rec.Tween:Cancel()
		rec.Tween = nil
	end
	local target = slotCFrame(rec)
	if animate then
		rec.State = "Moving"
		setPromptMode(rec)
		local tween = TweenService:Create(rec.Root, TweenInfo.new(1.4, Enum.EasingStyle.Quad), { CFrame = target })
		rec.Tween = tween
		tween.Completed:Connect(function(state)
			if state == Enum.PlaybackState.Completed and rec.State == "Moving" then
				rec.State = "Placed"
				rec.Tween = nil
				setPromptMode(rec)
			end
		end)
		tween:Play()
	else
		rec.Root.CFrame = target
		rec.State = "Placed"
		setPromptMode(rec)
	end
end

---------------------------------------------------------------- stealing

local function endCarry(rec)
	local thief = rec.Thief
	rec.Thief = nil
	if rec.CarryWeld then
		rec.CarryWeld:Destroy()
		rec.CarryWeld = nil
	end
	rec.Root.Anchored = true
	if thief then
		carrying[thief] = nil
		thief:SetAttribute("Carrying", nil)
		applySpeed(thief)
	end
	return thief
end

local function returnToOwner(rec, reason: string?)
	local thief = endCarry(rec)
	rec.State = "Placed"
	rec.Root.CFrame = slotCFrame(rec)
	setPromptMode(rec)
	if thief and reason then
		notify(thief, reason, Color3.fromRGB(255, 90, 90))
	end
end

local function completeSteal(rec)
	local thief = rec.Thief
	local victim = rec.Owner
	local slot = freeSlot(thief)
	if not slot then
		returnToOwner(rec, "Your base is full! The brainrot ran home.")
		return
	end
	endCarry(rec)
	local victimData = DataService.Get(victim)
	if victimData then
		victimData.Brainrots[rec.Uid] = nil
	end
	rec.Plot.Slots[rec.Slot] = nil
	assignToPlot(rec, thief, slot, false)
	local thiefData = DataService.Get(thief)
	thiefData.Steals = (thiefData.Steals or 0) + 1
	notify(thief, "You yoinked " .. rec.Info.Name .. "!", Color3.fromRGB(90, 255, 90))
	notify(victim, thief.DisplayName .. " yoinked your " .. rec.Info.Name .. "!", Color3.fromRGB(255, 90, 90))
end

local function startSteal(rec, thief: Player)
	local root = thief.Character and thief.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	if rec.Tween then
		rec.Tween:Cancel()
		rec.Tween = nil
	end
	rec.State = "Carried"
	rec.Thief = thief
	rec.StealDeadline = os.clock() + Config.StealTimeout
	carrying[thief] = rec
	thief:SetAttribute("Carrying", rec.Info.Name)
	setPromptMode(rec)

	rec.Root.Anchored = false
	rec.Root.CanCollide = false
	rec.Root.Massless = true
	local w = Instance.new("Weld")
	w.Part0 = root
	w.Part1 = rec.Root
	w.C0 = CFrame.new(0, 3 + rec.Root.Size.Y / 2 + 1, 0)
	w.Parent = rec.Root
	rec.CarryWeld = w
	rec.Root:SetNetworkOwner(thief)
	applySpeed(thief)
	notify(thief, "Run back to your base!", Color3.fromRGB(255, 230, 80))
	notify(rec.Owner, thief.DisplayName .. " is stealing your " .. rec.Info.Name .. "! Tag them!", Color3.fromRGB(255, 60, 60))
end

---------------------------------------------------------------- records

local function newRecord(info, uid: string?)
	local model, root = Models.Create(info)
	local rec: any = {
		Uid = uid or HttpService:GenerateGUID(false),
		Info = info,
		Model = model,
		Root = root,
		State = "Walking",
	}
	records[rec.Uid] = rec

	local function prompt(name, action, key, hold)
		local p = Instance.new("ProximityPrompt")
		p.Name = name
		p.ActionText = action
		p.ObjectText = info.Name
		p.KeyboardKeyCode = key
		p.HoldDuration = hold
		p.MaxActivationDistance = 12
		p.RequiresLineOfSight = false
		p.Parent = root
		return p
	end
	rec.BuyPrompt = prompt("BuyPrompt", "Buy " .. Format.Cash(info.Price), Enum.KeyCode.E, 0)
	rec.SellPrompt = prompt("SellPrompt", "Sell " .. Format.Cash(info.Price * Config.SellRefund), Enum.KeyCode.F, 1)
	rec.StealPrompt = prompt("StealPrompt", "Steal", Enum.KeyCode.E, Config.StealHoldTime)

	rec.BuyPrompt.Triggered:Connect(function(player)
		if rec.State ~= "Walking" then
			return
		end
		if rec.ReservedFor and rec.ReservedFor ~= player and os.clock() < rec.ReservedUntil then
			notify(player, "This one is reserved for " .. rec.ReservedFor.DisplayName .. "!", Color3.fromRGB(255, 90, 90))
			return
		end
		local data = DataService.Get(player)
		if not data or not playerPlot[player] then
			return
		end
		if data.Cash < info.Price then
			notify(player, "Not enough cash! Need " .. Format.Cash(info.Price), Color3.fromRGB(255, 90, 90))
			return
		end
		local slot = freeSlot(player)
		if not slot then
			notify(player, "Your base is full! Sell something or get +5 Slots.", Color3.fromRGB(255, 90, 90))
			return
		end
		addCash(player, -info.Price)
		assignToPlot(rec, player, slot, true)
		if Config.RarityByName[info.Rarity].Luck then
			notify(nil, player.DisplayName .. " bought a " .. info.Rarity .. " " .. info.Name .. "!", Config.RarityByName[info.Rarity].Color)
		end
	end)

	rec.SellPrompt.Triggered:Connect(function(player)
		if rec.State ~= "Placed" or rec.Owner ~= player then
			return
		end
		local data = DataService.Get(player)
		if not data then
			return
		end
		data.Brainrots[rec.Uid] = nil
		destroyRecord(rec)
		addCash(player, math.floor(info.Price * Config.SellRefund))
		notify(player, "Sold " .. info.Name .. " for " .. Format.Cash(info.Price * Config.SellRefund), Color3.fromRGB(90, 255, 90))
	end)

	rec.StealPrompt.Triggered:Connect(function(player)
		if rec.State ~= "Placed" or rec.Owner == player or carrying[player] or not playerPlot[player] then
			return
		end
		if os.clock() < rec.Plot.LockedUntil then
			notify(player, "This base is locked!", Color3.fromRGB(255, 90, 90))
			return
		end
		if not freeSlot(player) then
			notify(player, "Your base is full!", Color3.fromRGB(255, 90, 90))
			return
		end
		startSteal(rec, player)
	end)

	setPromptMode(rec)
	model.Parent = brainrotFolder
	return rec
end

---------------------------------------------------------------- runway spawner

local function currentLuck(): number
	local luck = 1
	if (workspace:GetAttribute("ServerLuckUntil") or 0) > os.time() then
		luck *= 2
	end
	if (workspace:GetAttribute("EventUntil") or 0) > os.time() then
		luck *= 1.5
	end
	return luck
end

local function rollBrainrot()
	local luck = currentLuck()
	local total = 0
	for _, rarity in Config.Rarities do
		total += rarity.Weight * (if rarity.Luck then luck else 1)
	end
	local roll = math.random() * total
	local chosen = Config.Rarities[1]
	for _, rarity in Config.Rarities do
		roll -= rarity.Weight * (if rarity.Luck then luck else 1)
		if roll <= 0 then
			chosen = rarity
			break
		end
	end
	local pool = Config.ByRarity[chosen.Name]
	return pool[math.random(1, #pool)]
end

local function spawnWalker(info, reservedFor: Player?)
	local rec = newRecord(info)
	if reservedFor then
		rec.ReservedFor = reservedFor
		rec.ReservedUntil = os.clock() + 12
	end
	setPromptMode(rec)
	local height = rec.Model:GetAttribute("RootHeight") or 3
	local start = Map.RunwayStart + Vector3.new(0, height, 0)
	local finish = Map.RunwayEnd + Vector3.new(0, height, 0)
	rec.Root.CFrame = CFrame.lookAt(start, finish)
	local tween = TweenService:Create(rec.Root, TweenInfo.new(Config.WalkTime, Enum.EasingStyle.Linear), {
		CFrame = CFrame.lookAt(finish, finish + (finish - start).Unit),
	})
	rec.Tween = tween
	tween.Completed:Connect(function(state)
		if state == Enum.PlaybackState.Completed and rec.State == "Walking" then
			destroyRecord(rec)
		end
	end)
	tween:Play()
	if Config.RarityByName[info.Rarity].Luck and info.Rarity ~= "Epic" then
		notify(nil, "A " .. info.Rarity .. " " .. info.Name .. " appeared!", Config.RarityByName[info.Rarity].Color)
	end
	return rec
end

task.spawn(function()
	while true do
		local interval = Config.SpawnInterval
		if (workspace:GetAttribute("EventUntil") or 0) > os.time() then
			interval /= 2
		end
		task.wait(interval)
		spawnWalker(rollBrainrot())
	end
end)

-- Recurring "Brainrot Rush" event keeps players around.
task.spawn(function()
	while true do
		task.wait(Config.EventEvery)
		workspace:SetAttribute("EventUntil", os.time() + Config.EventDuration)
		notify(nil, "BRAINROT RUSH! 2x spawns + luck for 2 minutes!", Color3.fromRGB(255, 200, 0))
	end
end)

---------------------------------------------------------------- plots & players

local function lockPlot(plot, player: Player)
	local duration = Config.LockDuration * (if MonetizationService.OwnsPass(player, "VIP") then 2 else 1)
	local now = os.clock()
	plot.LockedUntil = math.max(plot.LockedUntil, now) + duration
	plot.LockCooldownUntil = plot.LockedUntil + Config.LockCooldown
	notify(player, "Base locked for " .. duration .. "s!", Color3.fromRGB(255, 130, 130))
end

local function playerFromHit(hit: BasePart): Player?
	local character = hit:FindFirstAncestorOfClass("Model")
	return character and Players:GetPlayerFromCharacter(character)
end

for _, plot in plots do
	local collectDebounce = false
	plot.CollectPad.Touched:Connect(function(hit)
		local player = playerFromHit(hit)
		if collectDebounce or not player or plot.Owner ~= player or plot.Uncollected < 1 then
			return
		end
		collectDebounce = true
		local amount = math.floor(plot.Uncollected)
		plot.Uncollected -= amount
		addCash(player, amount)
		notify(player, "+" .. Format.Cash(amount), Color3.fromRGB(90, 255, 90))
		task.wait(0.5)
		collectDebounce = false
	end)
	plot.LockPad.Touched:Connect(function(hit)
		local player = playerFromHit(hit)
		if not player or plot.Owner ~= player then
			return
		end
		if os.clock() >= plot.LockCooldownUntil then
			lockPlot(plot, player)
		end
	end)
end

local function setupCharacter(player: Player, character: Model)
	local plot = playerPlot[player]
	local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if plot and root then
		task.wait()
		character:PivotTo(plot.SpawnCFrame)
	end
	applySpeed(player)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if humanoid then
		humanoid.Died:Connect(function()
			local rec = carrying[player]
			if rec then
				returnToOwner(rec, "You dropped it!")
			end
		end)
	end
end

local function claimPlot(player: Player, data)
	local plot
	for _, p in plots do
		if not p.Owner then
			plot = p
			break
		end
	end
	if not plot then
		notify(player, "Server is full of bases! Rejoin another server.", Color3.fromRGB(255, 90, 90))
		return
	end
	plot.Owner = player
	plot.Uncollected = 0
	plot.LockedUntil = 0
	plot.LockCooldownUntil = 0
	plot.SignLabel.Text = player.DisplayName .. "'s Base"
	playerPlot[player] = plot
	player:SetAttribute("PlotIndex", plot.Index)

	-- Restore saved brainrots into their slots.
	local limit = Config.BaseSlots + Config.ExtraSlots
	for uid, entry in data.Brainrots do
		local info = Config.ById[entry.Id]
		if not info then
			data.Brainrots[uid] = nil
			continue
		end
		local slot = entry.Slot
		if type(slot) ~= "number" or slot < 1 or slot > limit or plot.Slots[slot] then
			slot = freeSlot(player, limit)
		end
		if slot then
			local rec = newRecord(info, uid)
			assignToPlot(rec, player, slot, false)
		end
	end
end

local function onProfileLoaded(player: Player, data)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local cash = Instance.new("StringValue")
	cash.Name = "Cash"
	cash.Parent = stats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = stats
	stats.Parent = player

	claimPlot(player, data)
	updateStats(player)

	if data.LastSave > 0 then
		local away = math.min(os.time() - data.LastSave, Config.OfflineCapSeconds)
		local earned = math.floor(away * income(player) * Config.OfflineRate)
		if earned > 0 then
			addCash(player, earned)
			task.delay(3, notify, player, "Welcome back! Your brainrots earned " .. Format.Cash(earned) .. " while you were gone.", Color3.fromRGB(90, 255, 90))
		end
	end

	player.CharacterAdded:Connect(function(character)
		setupCharacter(player, character)
	end)
	if player.Character then
		task.spawn(setupCharacter, player, player.Character)
	end
end

local function releasePlayer(player: Player)
	local rec = carrying[player]
	if rec then
		returnToOwner(rec)
	end
	local plot = playerPlot[player]
	if not plot then
		return
	end
	for _, r in records do
		if r.Owner == player then
			if r.State == "Carried" then
				endCarry(r)
			end
			destroyRecord(r)
		end
	end
	plot.Owner = nil
	plot.Uncollected = 0
	plot.Slots = {}
	plot.SignLabel.Text = "Empty Base"
	plot.CollectLabel.Text = "COLLECT $0"
	plot.Barrier.Transparency = 1
	playerPlot[player] = nil
end

---------------------------------------------------------------- monetization

local function cashPack(name)
	return function(player: Player, _data)
		local pack = Config.CashPacks[name]
		local amount = math.max(pack.Min, math.floor(income(player) * pack.Seconds))
		addCash(player, amount)
		notify(player, "+" .. Format.Cash(amount) .. "! Thanks for the support!", Color3.fromRGB(90, 255, 90))
		return true
	end
end

MonetizationService.Init({
	Passes = Config.Passes,
	Products = Config.Products,
	ProductHandlers = {
		CashSmall = cashPack("CashSmall"),
		CashMedium = cashPack("CashMedium"),
		CashLarge = cashPack("CashLarge"),
		ServerLuck = function(player)
			local current = math.max(workspace:GetAttribute("ServerLuckUntil") or 0, os.time())
			workspace:SetAttribute("ServerLuckUntil", current + Config.ServerLuckMinutes * 60)
			notify(nil, player.DisplayName .. " activated 2x SERVER LUCK! Thank them!", Color3.fromRGB(0, 255, 200))
			return true
		end,
		SpawnSecret = function(player)
			local pool = Config.ByRarity.Secret
			local info = pool[math.random(1, #pool)]
			spawnWalker(info, player)
			notify(nil, player.DisplayName .. " summoned a SECRET " .. info.Name .. "!", Color3.fromRGB(255, 0, 170))
			return true
		end,
		InstantLock = function(player)
			local plot = playerPlot[player]
			if not plot then
				return false
			end
			lockPlot(plot, player)
			return true
		end,
	},
	OnPassOwned = function(player, name)
		applySpeed(player)
		updateStats(player)
		notify(player, "Unlocked " .. name .. "!", Color3.fromRGB(255, 215, 0))
	end,
})

RebirthRemote.OnServerInvoke = function(player)
	local data = DataService.Get(player)
	if not data then
		return false, "Still loading..."
	end
	local cost = Config.RebirthCost(data.Rebirths)
	if data.Cash < cost then
		return false, "You need " .. Format.Cash(cost) .. " to rebirth!"
	end
	local rec = carrying[player]
	if rec then
		returnToOwner(rec)
	end
	for _, r in records do
		if r.Owner == player then
			if r.State == "Carried" then
				endCarry(r)
			end
			destroyRecord(r)
		end
	end
	data.Brainrots = {}
	data.Cash = Config.StartingCash * (data.Rebirths + 2)
	data.Rebirths += 1
	local plot = playerPlot[player]
	if plot then
		plot.Uncollected = 0
	end
	updateStats(player)
	notify(nil, player.DisplayName .. " reached Rebirth " .. data.Rebirths .. "!", Color3.fromRGB(255, 215, 0))
	return true, "Rebirthed! Permanent " .. (1 + data.Rebirths * Config.RebirthBonus) .. "x cash."
end

DataService.ProfileLoaded:Connect(onProfileLoaded)
DataService.ProfileReleasing:Connect(function(player)
	-- Bank uncollected cash so it isn't lost on leave.
	local plot = playerPlot[player]
	local data = DataService.Get(player)
	if plot and data and plot.Owner == player then
		data.Cash += math.floor(plot.Uncollected)
		plot.Uncollected = 0
	end
end)
Players.PlayerRemoving:Connect(function(player)
	-- Let DataService bank & save first (it also listens to PlayerRemoving).
	task.defer(releasePlayer, player)
end)

DataService.Init("YoinkABrainrot_v1", {
	Cash = Config.StartingCash,
	Rebirths = 0,
	Brainrots = {},
	Discovered = {},
	TotalEarned = 0,
	Steals = 0,
})

---------------------------------------------------------------- game loops

-- Income tick
task.spawn(function()
	while true do
		task.wait(1)
		for player, plot in playerPlot do
			local perSecond = income(player)
			plot.Uncollected += perSecond
			plot.CollectLabel.Text = "COLLECT " .. Format.Cash(plot.Uncollected)
			player:SetAttribute("Income", perSecond)
		end
	end
end)

-- Steal tracking, base locks
task.spawn(function()
	while true do
		task.wait(0.15)
		local now = os.clock()
		for thief, rec in carrying do
			local root = thief.Character and thief.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local humanoid = thief.Character and thief.Character:FindFirstChildOfClass("Humanoid")
			if not root or not humanoid or humanoid.Health <= 0 then
				returnToOwner(rec, "You dropped it!")
				continue
			end
			if now > rec.StealDeadline then
				returnToOwner(rec, "Too slow! It escaped.")
				continue
			end
			local owner = rec.Owner
			local ownerRoot = owner.Character and owner.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if ownerRoot and (ownerRoot.Position - root.Position).Magnitude < 7 then
				returnToOwner(rec, owner.DisplayName .. " caught you!")
				notify(owner, "You got your " .. rec.Info.Name .. " back!", Color3.fromRGB(90, 255, 90))
				continue
			end
			local home = playerPlot[thief]
			if home and Map.IsInPlot(home, root.Position) then
				completeSteal(rec)
			end
		end

		for _, plot in plots do
			local locked = now < plot.LockedUntil
			plot.Barrier.Transparency = if locked then 0.35 else 1
			if plot.Owner then
				if locked then
					plot.LockLabel.Text = "LOCKED " .. math.ceil(plot.LockedUntil - now) .. "s"
				elseif now < plot.LockCooldownUntil then
					plot.LockLabel.Text = "Cooldown " .. math.ceil(plot.LockCooldownUntil - now) .. "s"
				else
					plot.LockLabel.Text = "LOCK BASE"
				end
			end
			if locked then
				for _, player in Players:GetPlayers() do
					if player ~= plot.Owner then
						local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
						if root and Map.IsInPlot(plot, root.Position) then
							local localPos = plot.CFrame:PointToObjectSpace(root.Position)
							player.Character:PivotTo(plot.CFrame * CFrame.new(localPos.X, 4, -Map.PlotHalfZ - 6))
						end
					end
				end
			end
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Map</string>
          <string name="Source"><![CDATA[-- Builds the whole map in code: grass, the brainrot runway and 8 player bases.
local Lighting = game:GetService("Lighting")

local Config = require(game:GetService("ReplicatedStorage").Shared.Config)

local Map = {}

Map.RunwayStart = Vector3.new(-170, 0.5, 0)
Map.RunwayEnd = Vector3.new(170, 0.5, 0)
Map.PlotHalfX = 35
Map.PlotHalfZ = 30

local PLOT_COLORS = {
	Color3.fromRGB(255, 99, 99),
	Color3.fromRGB(99, 160, 255),
	Color3.fromRGB(110, 230, 110),
	Color3.fromRGB(255, 200, 70),
	Color3.fromRGB(200, 110, 255),
	Color3.fromRGB(255, 150, 60),
	Color3.fromRGB(80, 230, 220),
	Color3.fromRGB(255, 120, 200),
}

local function part(props, parent): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = parent
	return p
end

local function padLabel(pad: BasePart, text: string, color: Color3): TextLabel
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(200, 60)
	gui.StudsOffset = Vector3.new(0, 4, 0)
	gui.MaxDistance = 90
	gui.Parent = pad
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.Text = text
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Parent = label
	label.Parent = gui
	return label
end

function Map.Build()
	local world = Instance.new("Folder")
	world.Name = "World"
	world.Parent = workspace

	Lighting.ClockTime = 14
	Lighting.Brightness = 2.5
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 170)

	part({
		Name = "Ground",
		Size = Vector3.new(700, 2, 500),
		Position = Vector3.new(0, -1, 0),
		Color = Color3.fromRGB(90, 190, 90),
		Material = Enum.Material.Grass,
	}, world)

	local runwayLength = (Map.RunwayEnd - Map.RunwayStart).Magnitude + 20
	part({
		Name = "Runway",
		Size = Vector3.new(runwayLength, 0.6, 16),
		Position = Vector3.new(0, 0.2, 0),
		Color = Color3.fromRGB(50, 50, 60),
		Material = Enum.Material.SmoothPlastic,
	}, world)
	for _, side in { -1, 1 } do
		part({
			Name = "RunwayEdge",
			Size = Vector3.new(runwayLength, 1, 1),
			Position = Vector3.new(0, 0.5, side * 8.5),
			Color = Color3.fromRGB(255, 220, 0),
			Material = Enum.Material.Neon,
			CanCollide = false,
		}, world)
	end
	local portal = part({
		Name = "SpawnPortal",
		Size = Vector3.new(2, 16, 18),
		Position = Map.RunwayStart + Vector3.new(-6, 8, 0),
		Color = Color3.fromRGB(170, 0, 255),
		Material = Enum.Material.Neon,
		Transparency = 0.3,
		CanCollide = false,
	}, world)
	local portalGui = padLabel(portal, "BRAINROTS INCOMING!", Color3.fromRGB(255, 255, 255)).Parent :: BillboardGui
	portalGui.StudsOffset = Vector3.new(0, 11, 0)

	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.Position = Vector3.new(0, 0.5, 120)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Parent = world

	local plots = {}
	local xs = { -135, -45, 45, 135 }
	local index = 0
	for _, zSide in { 1, -1 } do
		for _, x in xs do
			index += 1
			local center = Vector3.new(x, 0, zSide * 62)
			local cf = CFrame.lookAt(center, Vector3.new(x, 0, 0))
			local color = PLOT_COLORS[index]
			local model = Instance.new("Model")
			model.Name = "Plot" .. index
			model.Parent = world

			part({
				Name = "Floor",
				Size = Vector3.new(Map.PlotHalfX * 2, 1, Map.PlotHalfZ * 2),
				CFrame = cf * CFrame.new(0, 0.5, 0),
				Color = color:Lerp(Color3.new(1, 1, 1), 0.55),
				Material = Enum.Material.WoodPlanks,
			}, model)
			-- Walls on the sides and back; the front faces the runway.
			local wallH = 11
			for _, sx in { -1, 1 } do
				part({
					Name = "Wall",
					Size = Vector3.new(1.5, wallH, Map.PlotHalfZ * 2),
					CFrame = cf * CFrame.new(sx * Map.PlotHalfX, wallH / 2 + 1, 0),
					Color = color,
				}, model)
			end
			part({
				Name = "Wall",
				Size = Vector3.new(Map.PlotHalfX * 2, wallH, 1.5),
				CFrame = cf * CFrame.new(0, wallH / 2 + 1, Map.PlotHalfZ),
				Color = color,
			}, model)
			local barrier = part({
				Name = "Barrier",
				Size = Vector3.new(Map.PlotHalfX * 2, wallH, 0.6),
				CFrame = cf * CFrame.new(0, wallH / 2 + 1, -Map.PlotHalfZ),
				Color = Color3.fromRGB(255, 40, 40),
				Material = Enum.Material.ForceField,
				Transparency = 1,
				CanCollide = false,
			}, model)

			local sign = part({
				Name = "Sign",
				Size = Vector3.new(30, 7, 1),
				CFrame = cf * CFrame.new(0, wallH + 5, Map.PlotHalfZ),
				Color = color,
			}, model)
			local signGui = Instance.new("SurfaceGui")
			signGui.Face = Enum.NormalId.Front
			signGui.Parent = sign
			local signLabel = Instance.new("TextLabel")
			signLabel.Size = UDim2.fromScale(1, 1)
			signLabel.BackgroundTransparency = 1
			signLabel.Font = Enum.Font.FredokaOne
			signLabel.TextScaled = true
			signLabel.TextColor3 = Color3.new(1, 1, 1)
			signLabel.Text = "Empty Base"
			local stroke = Instance.new("UIStroke")
			stroke.Thickness = 4
			stroke.Parent = signLabel
			signLabel.Parent = signGui

			local slotCFrames = {}
			local total = Config.BaseSlots + Config.ExtraSlots
			for i = 1, total do
				local row = math.floor((i - 1) / 5)
				local col = (i - 1) % 5
				local slotCF = cf * CFrame.new((col - 2) * 12, 1, 2 + row * 9)
				-- Brainrots face the entrance.
				slotCFrames[i] = slotCF
				part({
					Name = "Slot" .. i,
					Size = Vector3.new(8, 0.3, 7),
					CFrame = slotCF * CFrame.new(0, 0.15, 0),
					Color = if i > Config.BaseSlots then Color3.fromRGB(255, 215, 0) else color,
					Material = Enum.Material.SmoothPlastic,
					CanCollide = false,
				}, model)
			end

			local collectPad = part({
				Name = "CollectPad",
				Size = Vector3.new(10, 1, 10),
				CFrame = cf * CFrame.new(-24, 1.2, -20),
				Color = Color3.fromRGB(40, 220, 80),
				Material = Enum.Material.Neon,
			}, model)
			local collectLabel = padLabel(collectPad, "COLLECT $0", Color3.fromRGB(120, 255, 120))

			local lockPad = part({
				Name = "LockPad",
				Size = Vector3.new(8, 1, 8),
				CFrame = cf * CFrame.new(24, 1.2, -20),
				Color = Color3.fromRGB(255, 60, 60),
				Material = Enum.Material.Neon,
			}, model)
			local lockLabel = padLabel(lockPad, "LOCK BASE", Color3.fromRGB(255, 130, 130))

			table.insert(plots, {
				Index = index,
				CFrame = cf,
				Model = model,
				SlotCFrames = slotCFrames,
				CollectPad = collectPad,
				CollectLabel = collectLabel,
				LockPad = lockPad,
				LockLabel = lockLabel,
				Barrier = barrier,
				SignLabel = signLabel,
				SpawnCFrame = cf * CFrame.new(0, 4, -18),
				Owner = nil,
				Uncollected = 0,
				Slots = {},
				LockedUntil = 0,
				LockCooldownUntil = 0,
			})
		end
	end
	return plots
end

function Map.IsInPlot(plot, position: Vector3): boolean
	local localPos = plot.CFrame:PointToObjectSpace(position)
	return math.abs(localPos.X) <= Map.PlotHalfX and math.abs(localPos.Z) <= Map.PlotHalfZ and localPos.Y < 40
end

return Map
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Models</string>
          <string name="Source"><![CDATA[-- Builds cartoon brainrot characters out of parts so no assets are required.
-- Swap in real meshes later by putting Models named after each Id in ServerStorage.Brainrots.
local ServerStorage = game:GetService("ServerStorage")

local Config = require(game:GetService("ReplicatedStorage").Shared.Config)
local Format = require(game:GetService("ReplicatedStorage").Common.Format)

local Models = {}

local rarityIndex = {}
for i, rarity in Config.Rarities do
	rarityIndex[rarity.Name] = i
end

local function part(props): BasePart
	local p = Instance.new("Part")
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanTouch = false
	p.Massless = true
	for k, v in props do
		(p :: any)[k] = v
	end
	return p
end

local function weld(a: BasePart, b: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = b
end

local function bodySize(shape: string, scale: number): Vector3
	if shape == "Tall" then
		return Vector3.new(3, 6, 3) * scale
	elseif shape == "Long" then
		return Vector3.new(3.5, 3, 7) * scale
	elseif shape == "Block" then
		return Vector3.new(4, 4, 4) * scale
	end
	return Vector3.new(4.5, 4.5, 4.5) * scale
end

local function buildProcedural(info): (Model, BasePart)
	local model = Instance.new("Model")
	local idx = rarityIndex[info.Rarity] or 1
	local scale = 1 + (idx - 1) * 0.18
	local size = bodySize(info.Shape, scale)
	local rarity = Config.RarityByName[info.Rarity]

	local root = part({
		Name = "Root",
		Size = size,
		Color = info.Color,
		Material = if idx >= 6 then Enum.Material.Neon else Enum.Material.SmoothPlastic,
		Shape = if info.Shape == "Ball" then Enum.PartType.Ball else Enum.PartType.Block,
		Anchored = true,
		Massless = false,
	})
	root.Parent = model
	model.PrimaryPart = root

	-- Eyes on the front (-Z) face.
	local eyeSize = 1.3 * scale
	for _, side in { -1, 1 } do
		local eye = part({
			Size = Vector3.new(eyeSize, eyeSize, eyeSize),
			Shape = Enum.PartType.Ball,
			Color = Color3.new(1, 1, 1),
			CFrame = root.CFrame * CFrame.new(side * size.X * 0.22, size.Y * 0.18, -size.Z / 2),
		})
		eye.Parent = model
		weld(root, eye)
		local pupil = part({
			Size = Vector3.new(eyeSize * 0.5, eyeSize * 0.5, eyeSize * 0.5),
			Shape = Enum.PartType.Ball,
			Color = Color3.new(0, 0, 0),
			CFrame = eye.CFrame * CFrame.new(0, 0, -eyeSize * 0.35),
		})
		pupil.Parent = model
		weld(root, pupil)
	end

	-- Mouth
	local mouth = part({
		Size = Vector3.new(size.X * 0.4, 0.3 * scale, 0.3),
		Color = Color3.fromRGB(120, 20, 20),
		CFrame = root.CFrame * CFrame.new(0, -size.Y * 0.15, -size.Z / 2),
	})
	mouth.Parent = model
	weld(root, mouth)

	-- Legs
	for _, side in { -1, 1 } do
		local leg = part({
			Size = Vector3.new(0.8, 1.6, 0.8) * scale,
			Color = info.Color:Lerp(Color3.new(0, 0, 0), 0.4),
			CFrame = root.CFrame * CFrame.new(side * size.X * 0.25, -size.Y / 2 - 0.8 * scale, 0),
		})
		leg.Parent = model
		weld(root, leg)
	end

	-- Rarity bling
	if idx >= 4 then
		local sparkle = Instance.new("ParticleEmitter")
		sparkle.Color = ColorSequence.new(rarity.Color)
		sparkle.LightEmission = 1
		sparkle.Size = NumberSequence.new(0.4, 0)
		sparkle.Rate = 6 * idx
		sparkle.Lifetime = NumberRange.new(0.8, 1.4)
		sparkle.Speed = NumberRange.new(2, 4)
		sparkle.SpreadAngle = Vector2.new(180, 180)
		sparkle.Parent = root
	end
	if idx >= 6 then
		local light = Instance.new("PointLight")
		light.Color = rarity.Color
		light.Range = 14
		light.Brightness = 2
		light.Parent = root
	end
	if info.Rarity == "Secret" then
		local crown = part({
			Size = Vector3.new(size.X * 0.6, 1, size.Z * 0.6),
			Color = Color3.fromRGB(255, 215, 0),
			Material = Enum.Material.Neon,
			CFrame = root.CFrame * CFrame.new(0, size.Y / 2 + 0.5, 0),
		})
		crown.Parent = model
		weld(root, crown)
	end

	model:SetAttribute("RootHeight", size.Y / 2 + 1.6 * scale)
	return model, root
end

local function buildFromTemplate(info): (Model?, BasePart?)
	local folder = ServerStorage:FindFirstChild("Brainrots")
	local template = folder and folder:FindFirstChild(info.Id)
	if not (template and template:IsA("Model") and template.PrimaryPart) then
		return nil, nil
	end
	local model = template:Clone()
	local root = model.PrimaryPart :: BasePart
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= root then
			d.Anchored = false
			d.CanCollide = false
			d.Massless = true
			weld(root, d)
		end
	end
	root.Anchored = true
	root.CanCollide = false
	local _, extents = model:GetBoundingBox()
	model:SetAttribute("RootHeight", root.Position.Y - (model:GetPivot().Position.Y - extents.Y / 2))
	return model, root
end

function Models.Create(info): (Model, BasePart)
	local model, root = buildFromTemplate(info)
	if not model then
		model, root = buildProcedural(info)
	end
	model.Name = info.Id
	local rarity = Config.RarityByName[info.Rarity]

	local gui = Instance.new("BillboardGui")
	gui.Name = "Tag"
	gui.Size = UDim2.fromOffset(220, 90)
	gui.StudsOffsetWorldSpace = Vector3.new(0, (root :: BasePart).Size.Y / 2 + 3, 0)
	gui.MaxDistance = 120
	gui.AlwaysOnTop = false
	gui.Parent = root

	local layout = Instance.new("UIListLayout")
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Parent = gui

	local function line(name, text, color, height)
		local label = Instance.new("TextLabel")
		label.Name = name
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(1, 0, 0, height)
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = color
		label.Text = text
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Color = if info.Rarity == "Secret" then Color3.new(1, 1, 1) else Color3.new(0, 0, 0)
		stroke.Parent = label
		label.Parent = gui
		return label
	end
	line("Rarity", info.Rarity, rarity.Color, 20)
	line("Name", info.Name, Color3.new(1, 1, 1), 26)
	line("Income", Format.Cash(info.Income) .. "/s", Color3.fromRGB(90, 255, 90), 22)
	line("Price", Format.Cash(info.Price), Color3.fromRGB(255, 230, 80), 22)

	return model, root :: BasePart
end

return Models
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="15">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="16">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="17">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="18">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Yoink a Brainrot client: HUD, shop, rebirth menu, notifications, prompt filtering.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Common.Format)
local UI = require(ReplicatedStorage.Common.UI)

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local testPurchase = ReplicatedStorage:WaitForChild("StudioTestPurchase")

local gui = UI.new("ScreenGui", {
	Name = "HUD",
	ResetOnSpawn = false,
	IgnoreGuiInset = false,
	Parent = player:WaitForChild("PlayerGui"),
}) :: ScreenGui

local toast = UI.CreateToaster(gui)
remotes:WaitForChild("Notify").OnClientEvent:Connect(function(text, color)
	toast(text, color)
end)

---------------------------------------------------------------- top bar

local top = UI.new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 6),
	Size = UDim2.fromOffset(320, 80),
	BackgroundColor3 = Color3.fromRGB(30, 30, 40),
	BackgroundTransparency = 0.2,
	Parent = gui,
}, { UI.Corner(14), UI.Stroke(Color3.new(0, 0, 0), 3) })
local cashLabel = UI.Label("$0", {
	Size = UDim2.new(1, -10, 0, 44),
	Position = UDim2.fromOffset(5, 2),
	TextColor3 = Color3.fromRGB(90, 255, 90),
	Parent = top,
})
local incomeLabel = UI.Label("$0/s", {
	Size = UDim2.new(1, -10, 0, 26),
	Position = UDim2.fromOffset(5, 48),
	TextColor3 = Color3.fromRGB(220, 220, 220),
	Parent = top,
})

local banner = UI.Label("", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 92),
	Size = UDim2.fromOffset(500, 30),
	TextColor3 = Color3.fromRGB(0, 255, 200),
	Parent = gui,
})

local carryLabel = UI.Label("", {
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -120),
	Size = UDim2.fromOffset(600, 44),
	TextColor3 = Color3.fromRGB(255, 230, 80),
	Visible = false,
	Parent = gui,
})

local function refreshStats()
	cashLabel.Text = Format.Cash(player:GetAttribute("Cash") or 0)
	local mult = player:GetAttribute("Multiplier") or 1
	incomeLabel.Text = Format.Cash(player:GetAttribute("Income") or 0) .. "/s  •  x" .. (math.floor(mult * 100) / 100)
	local carrying = player:GetAttribute("Carrying")
	carryLabel.Visible = carrying ~= nil
	carryLabel.Text = if carrying then "CARRYING " .. string.upper(carrying) .. " — RUN TO YOUR BASE!" else ""
end
player.AttributeChanged:Connect(refreshStats)
refreshStats()

---------------------------------------------------------------- shop

local function openModal(title: string): (Frame, ScrollingFrame)
	local modal = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 520, 0.7, 0),
		BackgroundColor3 = Color3.fromRGB(40, 40, 60),
		Visible = false,
		Parent = gui,
	}, { UI.Corner(18), UI.Stroke(Color3.new(0, 0, 0), 4) }) :: Frame
	local constraint = Instance.new("UISizeConstraint")
	constraint.MaxSize = Vector2.new(math.huge, 560)
	constraint.Parent = modal
	UI.Label(title, { Size = UDim2.new(1, -80, 0, 50), Position = UDim2.fromOffset(16, 6), TextXAlignment = Enum.TextXAlignment.Left, Parent = modal })
	local close = UI.Button("X", Color3.fromRGB(230, 60, 60), {
		Size = UDim2.fromOffset(48, 48),
		Position = UDim2.new(1, -58, 0, 8),
		Parent = modal,
	})
	close.Activated:Connect(function()
		modal.Visible = false
	end)
	local list = UI.new("ScrollingFrame", {
		Position = UDim2.fromOffset(12, 64),
		Size = UDim2.new(1, -24, 1, -76),
		BackgroundTransparency = 1,
		ScrollBarThickness = 8,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = modal,
	}) :: ScrollingFrame
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list
	return modal, list
end

local shop, shopList = openModal("SHOP")
local order = 0

local function section(text: string)
	order += 1
	UI.Label(text, {
		Size = UDim2.new(1, 0, 0, 34),
		TextColor3 = Color3.fromRGB(255, 215, 0),
		LayoutOrder = order,
		Parent = shopList,
	})
end

local function shopItem(info, kind: string, color: Color3)
	order += 1
	local row = UI.new("Frame", {
		Size = UDim2.new(1, -10, 0, 74),
		BackgroundColor3 = Color3.fromRGB(60, 60, 85),
		LayoutOrder = order,
		Parent = shopList,
	}, { UI.Corner(12) })
	UI.Label(info.Name, {
		Position = UDim2.fromOffset(12, 4),
		Size = UDim2.new(1, -150, 0, 32),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})
	UI.Label(info.Description, {
		Position = UDim2.fromOffset(12, 38),
		Size = UDim2.new(1, -150, 0, 28),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(200, 200, 220),
		Font = Enum.Font.GothamMedium,
		Parent = row,
	})
	local button = UI.Button("R$ " .. info.Price, color, {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(120, 52),
		Parent = row,
	})
	if kind == "Pass" then
		local function refresh()
			if player:GetAttribute("Pass_" .. info.Key) then
				button.Text = "OWNED"
				button.BackgroundColor3 = Color3.fromRGB(90, 90, 90)
			end
		end
		player:GetAttributeChangedSignal("Pass_" .. info.Key):Connect(refresh)
		refresh()
	end
	button.Activated:Connect(function()
		local id = if kind == "Pass" then Config.Passes[info.Key] else Config.Products[info.Key]
		if kind == "Pass" and player:GetAttribute("Pass_" .. info.Key) then
			return
		end
		if id and id > 0 then
			if kind == "Pass" then
				MarketplaceService:PromptGamePassPurchase(player, id)
			else
				MarketplaceService:PromptProductPurchase(player, id)
			end
		elseif RunService:IsStudio() then
			testPurchase:FireServer(kind, info.Key)
			toast("[Studio test] granted " .. info.Name, Color3.fromRGB(255, 215, 0))
		else
			toast("Coming soon!", Color3.fromRGB(255, 90, 90))
		end
	end)
end

section("GAME PASSES")
for _, info in Config.PassInfo do
	shopItem(info, "Pass", Color3.fromRGB(40, 180, 70))
end
section("BOOSTS")
for _, info in Config.ProductInfo do
	shopItem(info, "Product", Color3.fromRGB(40, 140, 230))
end

---------------------------------------------------------------- rebirth

local rebirthModal, rebirthList = openModal("REBIRTH")
local rebirthInfo = UI.Label("", {
	Size = UDim2.new(1, 0, 0, 120),
	TextWrapped = true,
	Parent = rebirthList,
})
local rebirthButton = UI.Button("REBIRTH!", Color3.fromRGB(255, 170, 0), {
	Size = UDim2.new(1, -10, 0, 64),
	LayoutOrder = 2,
	Parent = rebirthList,
})
local function refreshRebirth()
	local rebirths = player:GetAttribute("Rebirths") or 0
	local cost = Config.RebirthCost(rebirths)
	rebirthInfo.Text = string.format(
		"Cost: %s\nNext bonus: %sx cash forever\nResets your cash and brainrots.",
		Format.Cash(cost),
		tostring(1 + (rebirths + 1) * Config.RebirthBonus)
	)
end
player:GetAttributeChangedSignal("Rebirths"):Connect(refreshRebirth)
refreshRebirth()
rebirthButton.Activated:Connect(function()
	local ok, message = remotes:WaitForChild("Rebirth"):InvokeServer()
	toast(message, if ok then Color3.fromRGB(255, 215, 0) else Color3.fromRGB(255, 90, 90))
	if ok then
		rebirthModal.Visible = false
	end
end)

---------------------------------------------------------------- side buttons

local side = UI.new("Frame", {
	AnchorPoint = Vector2.new(0, 0.5),
	Position = UDim2.new(0, 10, 0.5, 0),
	Size = UDim2.fromOffset(130, 200),
	BackgroundTransparency = 1,
	Parent = gui,
})
local sideLayout = Instance.new("UIListLayout")
sideLayout.Padding = UDim.new(0, 10)
sideLayout.Parent = side
local shopButton = UI.Button("SHOP", Color3.fromRGB(40, 180, 70), { Size = UDim2.fromOffset(130, 56), Parent = side })
local rebirthOpen = UI.Button("REBIRTH", Color3.fromRGB(255, 170, 0), { Size = UDim2.fromOffset(130, 56), Parent = side })
local luckButton = UI.Button("2x LUCK", Color3.fromRGB(0, 190, 170), { Size = UDim2.fromOffset(130, 56), Parent = side })
shopButton.Activated:Connect(function()
	rebirthModal.Visible = false
	shop.Visible = not shop.Visible
end)
rebirthOpen.Activated:Connect(function()
	shop.Visible = false
	rebirthModal.Visible = not rebirthModal.Visible
end)
luckButton.Activated:Connect(function()
	local id = Config.Products.ServerLuck
	if id > 0 then
		MarketplaceService:PromptProductPurchase(player, id)
	elseif RunService:IsStudio() then
		testPurchase:FireServer("Product", "ServerLuck")
	end
end)

---------------------------------------------------------------- prompts + banners

local brainrots = workspace:WaitForChild("Brainrots")
task.spawn(function()
	while true do
		local now = os.time()
		local parts = {}
		local luckUntil = workspace:GetAttribute("ServerLuckUntil") or 0
		local eventUntil = workspace:GetAttribute("EventUntil") or 0
		if luckUntil > now then
			table.insert(parts, "2x SERVER LUCK " .. Format.Time(luckUntil - now))
		end
		if eventUntil > now then
			table.insert(parts, "BRAINROT RUSH " .. Format.Time(eventUntil - now))
		end
		banner.Text = table.concat(parts, "   •   ")

		for _, model in brainrots:GetChildren() do
			local root = model.PrimaryPart
			if not root then
				continue
			end
			local state = model:GetAttribute("State")
			local mine = model:GetAttribute("OwnerId") == player.UserId
			local buy = root:FindFirstChild("BuyPrompt") :: ProximityPrompt?
			local sell = root:FindFirstChild("SellPrompt") :: ProximityPrompt?
			local steal = root:FindFirstChild("StealPrompt") :: ProximityPrompt?
			if buy then
				buy.Enabled = state == "Walking"
			end
			if sell then
				sell.Enabled = state == "Placed" and mine
			end
			if steal then
				steal.Enabled = state == "Placed" and not mine
			end
		end
		task.wait(0.25)
	end
end)

---------------------------------------------------------------- VIP chat tag

TextChatService.OnIncomingMessage = function(message)
	local props = Instance.new("TextChatMessageProperties")
	local source = message.TextSource
	local speaker = source and Players:GetPlayerByUserId(source.UserId)
	if speaker and speaker:GetAttribute("Pass_VIP") then
		props.PrefixText = "<font color='#FFD700'>[VIP]</font> " .. message.PrefixText
	end
	return props
end
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>