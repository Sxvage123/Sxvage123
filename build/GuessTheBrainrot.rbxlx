  <Item class="ServerScriptService" referent="9">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="10">
      <Properties>
        <string name="Name">CommonServer</string>
      </Properties>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Session-locked DataStore saving shared by every game.
-- Keeps each player's data in memory, autosaves, and never lets two servers
-- write the same player at once (prevents item duplication / rollbacks).
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local DataService = {}

local AUTOSAVE_INTERVAL = 90
local LOCK_EXPIRE = 600
local LOAD_ATTEMPTS = 6

local profiles: { [Player]: { [string]: any } } = {}
local loadedEvent = Instance.new("BindableEvent")
local releasingEvent = Instance.new("BindableEvent")
DataService.ProfileLoaded = loadedEvent.Event -- (player, data)
DataService.ProfileReleasing = releasingEvent.Event -- (player, data) fired before the final save

local store: DataStore? = nil
local memoryStore: { [string]: any } = {}
local template: { [string]: any } = {}
local initialized = false

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end
DataService.DeepCopy = deepCopy

local function reconcile(data, tmpl)
	for key, value in tmpl do
		if data[key] == nil then
			data[key] = deepCopy(value)
		elseif type(value) == "table" and type(data[key]) == "table" and next(value) ~= nil and #value == 0 then
			reconcile(data[key], value)
		end
	end
end

local function update(key: string, transform: (any) -> any): (boolean, any)
	if not store then
		local result = transform(memoryStore[key])
		if result ~= nil then
			memoryStore[key] = deepCopy(result)
		end
		return true, result
	end
	local ok, result = pcall(function()
		return (store :: DataStore):UpdateAsync(key, transform)
	end)
	return ok, result
end

local function keyFor(player: Player): string
	return "Player_" .. player.UserId
end

local function loadProfile(player: Player)
	local key = keyFor(player)
	for attempt = 1, LOAD_ATTEMPTS do
		local stealLock = attempt == LOAD_ATTEMPTS
		local lockedElsewhere = false
		local ok, result = update(key, function(stored)
			stored = stored or { Data = deepCopy(template) }
			local lock = stored.Lock
			if lock and lock.JobId ~= game.JobId and os.time() - lock.Time < LOCK_EXPIRE and not stealLock then
				lockedElsewhere = true
				return nil
			end
			stored.Lock = { JobId = game.JobId, Time = os.time() }
			return stored
		end)
		if ok and result and not lockedElsewhere then
			local data = result.Data or deepCopy(template)
			reconcile(data, template)
			return data
		end
		if not ok then
			warn("[DataService] load failed for", player.Name, result)
		end
		task.wait(lockedElsewhere and 5 or 2)
		if not player.Parent then
			return nil
		end
	end
	return nil
end

-- Saves the player's data. `release` clears the session lock (used on leave).
function DataService.Save(player: Player, release: boolean?): boolean
	local data = profiles[player]
	if not data then
		return false
	end
	data.LastSave = os.time()
	local snapshot = deepCopy(data)
	local ok, err = update(keyFor(player), function(stored)
		stored = stored or {}
		if stored.Lock and stored.Lock.JobId ~= game.JobId then
			-- Another server took over this player; never overwrite its data.
			return nil
		end
		stored.Data = snapshot
		stored.Lock = if release then nil else { JobId = game.JobId, Time = os.time() }
		return stored
	end)
	if not ok then
		warn("[DataService] save failed for", player.Name, err)
	end
	return ok
end

function DataService.Get(player: Player): { [string]: any }?
	return profiles[player]
end

function DataService.WaitFor(player: Player, timeout: number?): { [string]: any }?
	local deadline = os.clock() + (timeout or 15)
	while not profiles[player] and player.Parent and os.clock() < deadline do
		task.wait(0.1)
	end
	return profiles[player]
end

local function onPlayerAdded(player: Player)
	local data = loadProfile(player)
	if not player.Parent then
		if data then
			profiles[player] = data
			DataService.Save(player, true)
			profiles[player] = nil
		end
		return
	end
	if not data then
		player:Kick("Your data could not load. Please rejoin in a moment!")
		return
	end
	data.LoginCount = (data.LoginCount or 0) + 1
	profiles[player] = data
	loadedEvent:Fire(player, data)
end

local function onPlayerRemoving(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	releasingEvent:Fire(player, data)
	DataService.Save(player, true)
	profiles[player] = nil
end

function DataService.Init(storeName: string, dataTemplate: { [string]: any })
	assert(not initialized, "DataService already initialized")
	initialized = true
	template = dataTemplate
	template.LastSave = template.LastSave or 0
	template.LoginCount = template.LoginCount or 0
	template.Receipts = template.Receipts or {}
	template.RobuxSpent = template.RobuxSpent or 0

	local ok, result = pcall(function()
		local s = DataStoreService:GetDataStore(storeName)
		if RunService:IsStudio() then
			-- Throws when "Enable Studio Access to API Services" is off.
			s:GetAsync("__probe")
		end
		return s
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStores unavailable, using memory only (turn on API access in Game Settings to save):", result)
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player in profiles do
				task.spawn(DataService.Save, player, false)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				releasingEvent:Fire(player, profiles[player])
				DataService.Save(player, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[-- Game pass ownership + developer product receipts, done safely:
-- every receipt is granted exactly once and saved before Roblox is told it succeeded.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local DataService = require(script.Parent.DataService)

local MonetizationService = {}

type Config = {
	Passes: { [string]: number },
	Products: { [string]: number },
	ProductHandlers: { [string]: (Player, { [string]: any }) -> boolean? },
	OnPassOwned: ((Player, string) -> ())?,
}

local passes: { [string]: number } = {}
local passIdToName: { [number]: string } = {}
local productIdToName: { [number]: string } = {}
local handlers = {}
local onPassOwned: ((Player, string) -> ())? = nil

local MAX_RECEIPTS = 100

local function setPass(player: Player, name: string)
	if player:GetAttribute("Pass_" .. name) then
		return
	end
	player:SetAttribute("Pass_" .. name, true)
	if onPassOwned then
		task.spawn(onPassOwned, player, name)
	end
end

function MonetizationService.OwnsPass(player: Player, name: string): boolean
	return player:GetAttribute("Pass_" .. name) == true
end

local function checkPasses(player: Player)
	for name, id in passes do
		if id and id > 0 then
			task.spawn(function()
				local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, id)
				if ok and owns and player.Parent then
					setPass(player, name)
				end
			end)
		end
	end
end

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = DataService.WaitFor(player, 20)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if table.find(data.Receipts, receipt.PurchaseId) then
		-- Already applied in memory; only confirm once it's actually saved
		-- (an earlier save may have failed).
		if DataService.Save(player, false) then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local name = productIdToName[receipt.ProductId]
	local handler = name and handlers[name]
	if not handler then
		warn("[Monetization] no handler for product", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok, result = pcall(handler, player, data)
	if not ok then
		warn("[Monetization] handler error", name, result)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if result == false then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(data.Receipts, receipt.PurchaseId)
	while #data.Receipts > MAX_RECEIPTS do
		table.remove(data.Receipts, 1)
	end
	data.RobuxSpent = (data.RobuxSpent or 0) + (receipt.CurrencySpent or 0)
	if DataService.Save(player, false) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

function MonetizationService.Init(config: Config)
	passes = config.Passes
	handlers = config.ProductHandlers
	onPassOwned = config.OnPassOwned
	for name, id in config.Passes do
		passIdToName[id] = name
	end
	for name, id in config.Products do
		productIdToName[id] = name
	end

	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local name = passIdToName[passId]
		if purchased and name then
			setPass(player, name)
		end
	end)

	-- In Studio, buttons for passes/products whose ID is still 0 grant instantly so you can test.
	local testRemote = Instance.new("RemoteEvent")
	testRemote.Name = "StudioTestPurchase"
	testRemote.Parent = ReplicatedStorage
	testRemote.OnServerEvent:Connect(function(player, kind, name)
		if not RunService:IsStudio() or type(name) ~= "string" then
			return
		end
		if kind == "Pass" and passes[name] ~= nil then
			setPass(player, name)
		elseif kind == "Product" and handlers[name] then
			local data = DataService.Get(player)
			if data then
				handlers[name](player, data)
			end
		end
	end)

	Players.PlayerAdded:Connect(checkPasses)
	for _, player in Players:GetPlayers() do
		checkPasses(player)
	end
end

-- Lets admins / testers grant passes in Studio before IDs exist.
function MonetizationService.GrantPassForTesting(player: Player, name: string)
	setPass(player, name)
end

return MonetizationService
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="13">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="14">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Guess the Brainrot server: per-player questions shown on a big stage figure + client viewport.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage.Shared.Config)
local BrainrotModels = require(ReplicatedStorage.Common.BrainrotModels)
local DataService = require(ServerScriptService.CommonServer.DataService)
local MonetizationService = require(ServerScriptService.CommonServer.MonetizationService)

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = ReplicatedStorage
local function remote(className: string, name: string): any
	local r = Instance.new(className)
	r.Name = name
	r.Parent = remotes
	return r
end
local NotifyRemote = remote("RemoteEvent", "Notify")
local QuestionRemote = remote("RemoteEvent", "Question") -- (id, choices, seconds, removed)
local AnswerRemote = remote("RemoteEvent", "Answer")

local world = Instance.new("Folder")
world.Name = "World"
world.Parent = workspace
local floor = Instance.new("Part")
floor.Anchored = true
floor.Size = Vector3.new(120, 2, 120)
floor.Position = Vector3.new(0, -1, 0)
floor.Color = Color3.fromRGB(70, 60, 110)
floor.Parent = world
local spawn = Instance.new("SpawnLocation")
spawn.Anchored = true
spawn.Size = Vector3.new(10, 1, 10)
spawn.Position = Vector3.new(0, 0.5, 0)
spawn.Neutral = true
spawn.Parent = world
-- A ring of every brainrot as decoration (a "museum" of the answers).
for i, b in Config.Brainrots do
	if BrainrotModels.Has(b.Id) then
		local a = i / #Config.Brainrots * math.pi * 2
		local m, _ = BrainrotModels.Build(b.Id, { Scale = 1.4 })
		m:PivotTo(CFrame.lookAt(Vector3.new(math.cos(a) * 45, (m:GetAttribute("RootHeight") :: number?) or 4, math.sin(a) * 45), Vector3.new(0, 4, 0)))
		m.Parent = world
	end
end

type Q = { Id: string, Choices: { string }, Answer: string, Ends: number, Token: number }
local current: { [Player]: Q } = {}

local function sync(p: Player)
	local data = DataService.Get(p)
	if not data then
		return
	end
	p:SetAttribute("Coins", data.Coins)
	p:SetAttribute("Correct", data.Correct)
	p:SetAttribute("BestStreak", data.BestStreak)
	local ls = p:FindFirstChild("leaderstats")
	if ls then
		(ls :: any).Correct.Value = data.Correct;
		(ls :: any)["Best Streak"].Value = data.BestStreak
	end
end

local function shuffle<T>(t: { T }): { T }
	for i = #t, 2, -1 do
		local j = math.random(1, i)
		t[i], t[j] = t[j], t[i]
	end
	return t
end

local ask
local function wrongOnes(q: Q, n: number): { string }
	local out = {}
	for _, c in q.Choices do
		if c ~= q.Answer and #out < n then
			table.insert(out, c)
		end
	end
	return out
end

ask = function(p: Player)
	local pick = Config.Brainrots[math.random(1, #Config.Brainrots)]
	local choices = { pick.Name }
	local pool = shuffle(table.clone(Config.Brainrots))
	for _, b in pool do
		if #choices >= 4 then
			break
		end
		if b.Id ~= pick.Id then
			table.insert(choices, b.Name)
		end
	end
	shuffle(choices)
	local seconds = Config.QuestionTime + (if MonetizationService.OwnsPass(p, "ExtraTime") then 5 else 0)
	local token = ((current[p] and current[p].Token) or 0) + 1
	local q: Q = { Id = pick.Id, Choices = choices, Answer = pick.Name, Ends = os.clock() + seconds, Token = token }
	current[p] = q
	QuestionRemote:FireClient(p, pick.Id, choices, seconds, if MonetizationService.OwnsPass(p, "AutoHint") then wrongOnes(q, 1) else {})
	task.delay(seconds + 0.5, function()
		if current[p] == q then
			local data = DataService.Get(p)
			if data then
				data.Streak = 0
				sync(p)
			end
			NotifyRemote:FireClient(p, "Time's up! It was " .. q.Answer, Color3.fromRGB(255, 120, 90))
			ask(p)
		end
	end)
end

AnswerRemote.OnServerEvent:Connect(function(p, choice)
	local q = current[p]
	local data = DataService.Get(p)
	if not q or not data or type(choice) ~= "string" then
		return
	end
	current[p] = nil
	if choice == q.Answer then
		data.Streak += 1
		data.Correct += 1
		data.BestStreak = math.max(data.BestStreak, data.Streak)
		local timeBonus = math.max(0, q.Ends - os.clock()) / 2
		local m = (if MonetizationService.OwnsPass(p, "DoubleCoins") then 2 else 1) * (if MonetizationService.OwnsPass(p, "VIP") then 1.5 else 1)
		local coins = math.floor((Config.Coins + timeBonus + data.Streak) * m)
		data.Coins += coins
		NotifyRemote:FireClient(p, "✅ Correct! +" .. coins .. " coins (streak " .. data.Streak .. ")", Color3.fromRGB(90, 255, 90))
		if data.Streak % 10 == 0 then
			NotifyRemote:FireAllClients(p.DisplayName .. " is on a " .. data.Streak .. " streak!", Color3.fromRGB(255, 215, 0))
		end
	else
		data.Streak = 0
		NotifyRemote:FireClient(p, "❌ Nope! It was " .. q.Answer, Color3.fromRGB(255, 90, 90))
	end
	sync(p)
	task.delay(1, ask, p)
end)

DataService.ProfileLoaded:Connect(function(p)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	for _, n in { "Correct", "Best Streak" } do
		local v = Instance.new("IntValue")
		v.Name = n
		v.Parent = ls
	end
	ls.Parent = p
	sync(p)
	task.delay(2, ask, p)
end)
Players.PlayerRemoving:Connect(function(p)
	current[p] = nil
end)

MonetizationService.Init({
	Passes = Config.Passes,
	Products = Config.Products,
	ProductHandlers = {
		Hint = function(p, data)
			local q = current[p]
			if q then
				QuestionRemote:FireClient(p, q.Id, q.Choices, math.max(1, math.floor(q.Ends - os.clock())), wrongOnes(q, 2))
			else
				data.Coins += 50
				sync(p)
			end
			return true
		end,
		Skip = function(p)
			current[p] = nil
			task.defer(ask, p)
			return true
		end,
		Coins = function(p, data)
			data.Coins += 1000
			sync(p)
			return true
		end,
	},
	OnPassOwned = function(p, name)
		NotifyRemote:FireClient(p, "Unlocked " .. name .. "!", Color3.fromRGB(255, 215, 0))
	end,
})

DataService.Init("GuessTheBrainrot_v1", { Coins = 0, Correct = 0, Streak = 0, BestStreak = 0 })
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="15">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="16">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="17">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="18">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Guess the Brainrot client: big figure viewport, 4 answer buttons, timer, hint/skip, shop.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local ModelView = require(ReplicatedStorage.Common.ModelView)
local ShopUI = require(ReplicatedStorage.Common.ShopUI)
local UI = require(ReplicatedStorage.Common.UI)

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local gui = UI.new("ScreenGui", { Name = "HUD", ResetOnSpawn = false, Parent = player:WaitForChild("PlayerGui") }) :: ScreenGui
local toast = UI.CreateToaster(gui)
remotes:WaitForChild("Notify").OnClientEvent:Connect(toast)
local buy = ShopUI.Buyer(Config, toast)
local shop = ShopUI.Create(gui, Config, buy, Color3.fromRGB(40, 30, 70))
ShopUI.VIPChatTag("VIP")

local card = UI.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(520, 470), BackgroundColor3 = Color3.fromRGB(40, 30, 70), Parent = gui }, { UI.Corner(18), UI.Stroke(Color3.new(0, 0, 0), 4) }) :: Frame
UI.Label("WHO IS THIS BRAINROT?", { Size = UDim2.new(1, -20, 0, 40), Position = UDim2.fromOffset(10, 6), Parent = card })
local timer = UI.Label("", { Size = UDim2.fromOffset(80, 40), Position = UDim2.new(1, -90, 0, 6), TextColor3 = Color3.fromRGB(255, 200, 80), Parent = card })
local stats = UI.Label("", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 6), Size = UDim2.fromOffset(420, 30), TextColor3 = Color3.fromRGB(255, 215, 0), Parent = gui })
local holder = UI.new("Frame", { Size = UDim2.new(1, -20, 0, 220), Position = UDim2.fromOffset(10, 50), BackgroundColor3 = Color3.fromRGB(25, 20, 45), Parent = card }, { UI.Corner(12) })
local buttons: { TextButton } = {}
for i = 1, 4 do
	local b = UI.Button("", Color3.fromRGB(80, 120, 255), { Size = UDim2.new(0.5, -15, 0, 80), Position = UDim2.new(((i - 1) % 2) * 0.5, 10, 0, 282 + ((i - 1) // 2) * 90), Parent = card })
	b.Activated:Connect(function()
		if b.Text ~= "" and b.AutoButtonColor then
			remotes.Answer:FireServer(b.Text)
		end
	end)
	buttons[i] = b
end

local deadline = 0
remotes:WaitForChild("Question").OnClientEvent:Connect(function(id, choices, seconds, removed)
	for _, c in holder:GetChildren() do
		if c:IsA("ViewportFrame") then
			c:Destroy()
		end
	end
	local view = ModelView.new(id, { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })
	if view then
		view.Parent = holder
	end
	for i, b in buttons do
		b.Text = choices[i] or ""
		local gone = table.find(removed, choices[i]) ~= nil
		b.AutoButtonColor = not gone
		b.BackgroundColor3 = if gone then Color3.fromRGB(60, 55, 70) else Color3.fromRGB(80, 120, 255)
	end
	deadline = os.clock() + seconds
end)

local side = ShopUI.SideBar(gui)
UI.Button("50/50", Color3.fromRGB(255, 160, 40), { Size = UDim2.fromOffset(120, 48), Parent = side }).Activated:Connect(function()
	buy("Product", "Hint")
end)
UI.Button("SKIP", Color3.fromRGB(230, 70, 120), { Size = UDim2.fromOffset(120, 48), Parent = side }).Activated:Connect(function()
	buy("Product", "Skip")
end)
UI.Button("SHOP", Color3.fromRGB(40, 180, 70), { Size = UDim2.fromOffset(120, 48), Parent = side }).Activated:Connect(function()
	shop.Visible = not shop.Visible
end)

while true do
	timer.Text = "⏱ " .. math.max(0, math.ceil(deadline - os.clock()))
	stats.Text = "✅ " .. (player:GetAttribute("Correct") or 0) .. "   🔥 best " .. (player:GetAttribute("BestStreak") or 0) .. "   🪙 " .. (player:GetAttribute("Coins") or 0)
	task.wait(0.2)
end
]]></string>
