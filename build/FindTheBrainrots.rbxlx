      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Session-locked DataStore saving shared by every game.
-- Keeps each player's data in memory, autosaves, and never lets two servers
-- write the same player at once (prevents item duplication / rollbacks).
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local DataService = {}

local AUTOSAVE_INTERVAL = 90
local LOCK_EXPIRE = 600
local LOAD_ATTEMPTS = 6

local profiles: { [Player]: { [string]: any } } = {}
local loadedEvent = Instance.new("BindableEvent")
local releasingEvent = Instance.new("BindableEvent")
DataService.ProfileLoaded = loadedEvent.Event -- (player, data)
DataService.ProfileReleasing = releasingEvent.Event -- (player, data) fired before the final save

local store: DataStore? = nil
local memoryStore: { [string]: any } = {}
local template: { [string]: any } = {}
local initialized = false

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end
DataService.DeepCopy = deepCopy

local function reconcile(data, tmpl)
	for key, value in tmpl do
		if data[key] == nil then
			data[key] = deepCopy(value)
		elseif type(value) == "table" and type(data[key]) == "table" and next(value) ~= nil and #value == 0 then
			reconcile(data[key], value)
		end
	end
end

local function update(key: string, transform: (any) -> any): (boolean, any)
	if not store then
		local result = transform(memoryStore[key])
		if result ~= nil then
			memoryStore[key] = deepCopy(result)
		end
		return true, result
	end
	local ok, result = pcall(function()
		return (store :: DataStore):UpdateAsync(key, transform)
	end)
	return ok, result
end

local function keyFor(player: Player): string
	return "Player_" .. player.UserId
end

local function loadProfile(player: Player)
	local key = keyFor(player)
	for attempt = 1, LOAD_ATTEMPTS do
		local stealLock = attempt == LOAD_ATTEMPTS
		local lockedElsewhere = false
		local ok, result = update(key, function(stored)
			stored = stored or { Data = deepCopy(template) }
			local lock = stored.Lock
			if lock and lock.JobId ~= game.JobId and os.time() - lock.Time < LOCK_EXPIRE and not stealLock then
				lockedElsewhere = true
				return nil
			end
			stored.Lock = { JobId = game.JobId, Time = os.time() }
			return stored
		end)
		if ok and result and not lockedElsewhere then
			local data = result.Data or deepCopy(template)
			reconcile(data, template)
			return data
		end
		if not ok then
			warn("[DataService] load failed for", player.Name, result)
		end
		task.wait(lockedElsewhere and 5 or 2)
		if not player.Parent then
			return nil
		end
	end
	return nil
end

-- Saves the player's data. `release` clears the session lock (used on leave).
function DataService.Save(player: Player, release: boolean?): boolean
	local data = profiles[player]
	if not data then
		return false
	end
	data.LastSave = os.time()
	local snapshot = deepCopy(data)
	local ok, err = update(keyFor(player), function(stored)
		stored = stored or {}
		if stored.Lock and stored.Lock.JobId ~= game.JobId then
			-- Another server took over this player; never overwrite its data.
			return nil
		end
		stored.Data = snapshot
		stored.Lock = if release then nil else { JobId = game.JobId, Time = os.time() }
		return stored
	end)
	if not ok then
		warn("[DataService] save failed for", player.Name, err)
	end
	return ok
end

function DataService.Get(player: Player): { [string]: any }?
	return profiles[player]
end

function DataService.WaitFor(player: Player, timeout: number?): { [string]: any }?
	local deadline = os.clock() + (timeout or 15)
	while not profiles[player] and player.Parent and os.clock() < deadline do
		task.wait(0.1)
	end
	return profiles[player]
end

local function onPlayerAdded(player: Player)
	local data = loadProfile(player)
	if not player.Parent then
		if data then
			profiles[player] = data
			DataService.Save(player, true)
			profiles[player] = nil
		end
		return
	end
	if not data then
		player:Kick("Your data could not load. Please rejoin in a moment!")
		return
	end
	data.LoginCount = (data.LoginCount or 0) + 1
	profiles[player] = data
	loadedEvent:Fire(player, data)
end

local function onPlayerRemoving(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	releasingEvent:Fire(player, data)
	DataService.Save(player, true)
	profiles[player] = nil
end

function DataService.Init(storeName: string, dataTemplate: { [string]: any })
	assert(not initialized, "DataService already initialized")
	initialized = true
	template = dataTemplate
	template.LastSave = template.LastSave or 0
	template.LoginCount = template.LoginCount or 0
	template.Receipts = template.Receipts or {}
	template.RobuxSpent = template.RobuxSpent or 0

	local ok, result = pcall(function()
		local s = DataStoreService:GetDataStore(storeName)
		if RunService:IsStudio() then
			-- Throws when "Enable Studio Access to API Services" is off.
			s:GetAsync("__probe")
		end
		return s
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStores unavailable, using memory only (turn on API access in Game Settings to save):", result)
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player in profiles do
				task.spawn(DataService.Save, player, false)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				releasingEvent:Fire(player, profiles[player])
				DataService.Save(player, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[-- Game pass ownership + developer product receipts, done safely:
-- every receipt is granted exactly once and saved before Roblox is told it succeeded.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local DataService = require(script.Parent.DataService)

local MonetizationService = {}

type Config = {
	Passes: { [string]: number },
	Products: { [string]: number },
	ProductHandlers: { [string]: (Player, { [string]: any }) -> boolean? },
	OnPassOwned: ((Player, string) -> ())?,
}

local passes: { [string]: number } = {}
local passIdToName: { [number]: string } = {}
local productIdToName: { [number]: string } = {}
local handlers = {}
local onPassOwned: ((Player, string) -> ())? = nil

local MAX_RECEIPTS = 100

local function setPass(player: Player, name: string)
	if player:GetAttribute("Pass_" .. name) then
		return
	end
	player:SetAttribute("Pass_" .. name, true)
	if onPassOwned then
		task.spawn(onPassOwned, player, name)
	end
end

function MonetizationService.OwnsPass(player: Player, name: string): boolean
	return player:GetAttribute("Pass_" .. name) == true
end

local function checkPasses(player: Player)
	for name, id in passes do
		if id and id > 0 then
			task.spawn(function()
				local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, id)
				if ok and owns and player.Parent then
					setPass(player, name)
				end
			end)
		end
	end
end

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = DataService.WaitFor(player, 20)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if table.find(data.Receipts, receipt.PurchaseId) then
		-- Already applied in memory; only confirm once it's actually saved
		-- (an earlier save may have failed).
		if DataService.Save(player, false) then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local name = productIdToName[receipt.ProductId]
	local handler = name and handlers[name]
	if not handler then
		warn("[Monetization] no handler for product", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok, result = pcall(handler, player, data)
	if not ok then
		warn("[Monetization] handler error", name, result)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if result == false then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(data.Receipts, receipt.PurchaseId)
	while #data.Receipts > MAX_RECEIPTS do
		table.remove(data.Receipts, 1)
	end
	data.RobuxSpent = (data.RobuxSpent or 0) + (receipt.CurrencySpent or 0)
	if DataService.Save(player, false) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

function MonetizationService.Init(config: Config)
	passes = config.Passes
	handlers = config.ProductHandlers
	onPassOwned = config.OnPassOwned
	for name, id in config.Passes do
		passIdToName[id] = name
	end
	for name, id in config.Products do
		productIdToName[id] = name
	end

	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local name = passIdToName[passId]
		if purchased and name then
			setPass(player, name)
		end
	end)

	-- In Studio, buttons for passes/products whose ID is still 0 grant instantly so you can test.
	local testRemote = Instance.new("RemoteEvent")
	testRemote.Name = "StudioTestPurchase"
	testRemote.Parent = ReplicatedStorage
	testRemote.OnServerEvent:Connect(function(player, kind, name)
		if not RunService:IsStudio() or type(name) ~= "string" then
			return
		end
		if kind == "Pass" and passes[name] ~= nil then
			setPass(player, name)
		elseif kind == "Product" and handlers[name] then
			local data = DataService.Get(player)
			if data then
				handlers[name](player, data)
			end
		end
	end)

	Players.PlayerAdded:Connect(checkPasses)
	for _, player in Players:GetPlayers() do
		checkPasses(player)
	end
end

-- Lets admins / testers grant passes in Studio before IDs exist.
function MonetizationService.GrantPassForTesting(player: Player, name: string)
	setPass(player, name)
end

return MonetizationService
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="11">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="12">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Find the Brainrots server: collectibles, saving, hints, teleports, coils.
local BadgeService = game:GetService("BadgeService")
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(ServerScriptService.CommonServer.DataService)
local MonetizationService = require(ServerScriptService.CommonServer.MonetizationService)
local World = require(script.Parent.World)

-- Optional: put a Badge ID here to award when someone finds every brainrot.
local COMPLETION_BADGE_ID = 0

Lighting.ClockTime = 14
Lighting.Brightness = 2.5

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = ReplicatedStorage
local function remote(className: string, name: string): any
	local r = Instance.new(className)
	r.Name = name
	r.Parent = remotes
	return r
end
local NotifyRemote = remote("RemoteEvent", "Notify")
local GuideRemote = remote("RemoteEvent", "Guide")
local TeleportRemote = remote("RemoteEvent", "Teleport")

local function notify(player: Player?, text: string, color: Color3?)
	if player then
		NotifyRemote:FireClient(player, text, color)
	else
		NotifyRemote:FireAllClients(text, color)
	end
end

local spots = World.Build()
local TOTAL = math.min(#spots, #Config.Names)
workspace:SetAttribute("TotalBrainrots", TOTAL)

local collectFolder = Instance.new("Folder")
collectFolder.Name = "Collectibles"
collectFolder.Parent = workspace

local collectibles = {}

local function sync(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local list, count = {}, 0
	for id in data.Found do
		table.insert(list, id)
		count += 1
	end
	player:SetAttribute("Found", table.concat(list, ","))
	player:SetAttribute("FoundCount", count)
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats.Found.Value = count
	end
end

local function collect(player: Player, index: number)
	local data = DataService.Get(player)
	local key = tostring(index)
	if not data or data.Found[key] then
		return
	end
	data.Found[key] = true
	local count = 0
	for _ in data.Found do
		count += 1
	end
	notify(player, "Found " .. Config.Names[index] .. "! (" .. count .. "/" .. TOTAL .. ")", Color3.fromHSV(index / TOTAL, 0.7, 1))
	if count >= TOTAL then
		notify(nil, player.DisplayName .. " FOUND ALL " .. TOTAL .. " BRAINROTS!", Color3.fromRGB(255, 215, 0))
		if COMPLETION_BADGE_ID > 0 then
			pcall(BadgeService.AwardBadge, BadgeService, player.UserId, COMPLETION_BADGE_ID)
		end
	end
	sync(player)
end

for index = 1, TOTAL do
	local s = spots[index]
	local color = Color3.fromHSV(index / TOTAL, 0.7, 1)
	local model = Instance.new("Model")
	model.Name = "Brainrot" .. index
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Shape = Enum.PartType.Ball
	body.Size = Vector3.one * 2.6
	body.Color = color
	body.Material = Enum.Material.SmoothPlastic
	body.Anchored = true
	body.CanCollide = false
	body.Position = s.Position
	body.Parent = model
	for _, side in { -1, 1 } do
		local eye = Instance.new("Part")
		eye.Shape = Enum.PartType.Ball
		eye.Size = Vector3.one * 0.7
		eye.Color = Color3.new(1, 1, 1)
		eye.Anchored = false
		eye.Massless = true
		eye.CanCollide = false
		eye.CanTouch = false
		eye.Position = s.Position + Vector3.new(side * 0.5, 0.4, -1.1)
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = body
		weld.Part1 = eye
		weld.Parent = eye
		eye.Parent = model
	end
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(160, 30)
	gui.StudsOffset = Vector3.new(0, 2.5, 0)
	gui.MaxDistance = 30
	gui.Parent = body
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.Text = Config.Names[index]
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = label
	label.Parent = gui
	model.PrimaryPart = body
	model:SetAttribute("Index", index)
	model.Parent = collectFolder
	CollectionService:AddTag(model, "Collectible")
	collectibles[index] = body
	body.Touched:Connect(function(hit)
		local character = hit:FindFirstAncestorOfClass("Model")
		local player = character and Players:GetPlayerFromCharacter(character)
		if player then
			collect(player, index)
		end
	end)
end

local function applyCoils(player: Player)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.UseJumpPower = true
		humanoid.WalkSpeed = if MonetizationService.OwnsPass(player, "SpeedCoil") then 28 else 16
		humanoid.JumpPower = if MonetizationService.OwnsPass(player, "GravityCoil") then 85 else 50
	end
end

TeleportRemote.OnServerEvent:Connect(function(player, zoneIndex)
	local zone = type(zoneIndex) == "number" and Config.ZoneSpawns[zoneIndex]
	if zone and MonetizationService.OwnsPass(player, "Teleporter") and player.Character then
		player.Character:PivotTo(CFrame.new(zone.Position))
	end
end)

local function unfound(data): { number }
	local list = {}
	for index = 1, TOTAL do
		if not data.Found[tostring(index)] then
			table.insert(list, index)
		end
	end
	return list
end

DataService.ProfileLoaded:Connect(function(player, data)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local found = Instance.new("IntValue")
	found.Name = "Found"
	found.Parent = stats
	stats.Parent = player
	for key in data.Found do
		local n = tonumber(key)
		if not n or n > TOTAL then
			data.Found[key] = nil
		end
	end
	sync(player)
	player.CharacterAdded:Connect(function(character)
		character:WaitForChild("Humanoid", 10)
		applyCoils(player)
	end)
	if player.Character then
		applyCoils(player)
	end
end)

MonetizationService.Init({
	Passes = Config.Passes,
	Products = Config.Products,
	ProductHandlers = {
		Hint = function(player, data)
			local list = unfound(data)
			if #list == 0 then
				notify(player, "You already found them all!", Color3.fromRGB(255, 215, 0))
				return true
			end
			local index = list[math.random(1, #list)]
			GuideRemote:FireClient(player, collectibles[index].Position, 60, spots[index].Hint)
			return true
		end,
		AutoFind = function(player, data)
			local list = unfound(data)
			if #list > 0 then
				collect(player, list[math.random(1, #list)])
			end
			return true
		end,
	},
	OnPassOwned = function(player, name)
		applyCoils(player)
		notify(player, "Unlocked " .. name .. "!", Color3.fromRGB(255, 215, 0))
	end,
})

-- Hints are public so the index can show them.
local hints = {}
for index = 1, TOTAL do
	hints[index] = spots[index].Hint
end
local hintsValue = Instance.new("StringValue")
hintsValue.Name = "Hints"
hintsValue.Value = game:GetService("HttpService"):JSONEncode(hints)
hintsValue.Parent = ReplicatedStorage

DataService.Init("FindTheBrainrots_v1", {
	Found = {},
})
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[-- Builds every zone and returns hiding spots: { Position, Hint } in a fixed order.
local World = {}

local folder: Folder
local function part(props): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = folder
	return p
end

local function truss(bottom: Vector3, height: number)
	local t = Instance.new("TrussPart")
	t.Anchored = true
	t.Size = Vector3.new(2, height, 2)
	t.Position = bottom + Vector3.new(0, height / 2, 0)
	t.Parent = folder
end

local spots = {}
local function spot(position: Vector3, hint: string)
	table.insert(spots, { Position = position, Hint = hint })
end

-- Hollow house with a door gap, a roof you can reach by ladder.
local function house(center: Vector3, color: Color3, zone: string)
	local w, h = 16, 10
	part({ Size = Vector3.new(w, 1, w), Position = center + Vector3.new(0, 0.5, 0), Color = Color3.fromRGB(150, 120, 90), Material = Enum.Material.WoodPlanks })
	part({ Size = Vector3.new(w, h, 1), Position = center + Vector3.new(0, h / 2 + 1, w / 2), Color = color, Material = Enum.Material.Brick })
	part({ Size = Vector3.new(1, h, w), Position = center + Vector3.new(w / 2, h / 2 + 1, 0), Color = color, Material = Enum.Material.Brick })
	part({ Size = Vector3.new(1, h, w), Position = center + Vector3.new(-w / 2, h / 2 + 1, 0), Color = color, Material = Enum.Material.Brick })
	-- front wall with a door
	part({ Size = Vector3.new(5.5, h, 1), Position = center + Vector3.new(-5.25, h / 2 + 1, -w / 2), Color = color, Material = Enum.Material.Brick })
	part({ Size = Vector3.new(5.5, h, 1), Position = center + Vector3.new(5.25, h / 2 + 1, -w / 2), Color = color, Material = Enum.Material.Brick })
	part({ Size = Vector3.new(5, 3, 1), Position = center + Vector3.new(0, h - 0.5, -w / 2), Color = color, Material = Enum.Material.Brick })
	part({ Size = Vector3.new(w + 2, 1, w + 2), Position = center + Vector3.new(0, h + 1.5, 0), Color = Color3.fromRGB(140, 50, 40), Material = Enum.Material.Slate })
	truss(center + Vector3.new(w / 2 + 1.5, 0, 4), h + 2)
	spot(center + Vector3.new(4, 2.5, 5), "Inside a house in " .. zone)
	spot(center + Vector3.new(-4, h + 3.5, -4), "On a roof in " .. zone .. " (find the ladder!)")
end

local function tree(base: Vector3)
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(14, 3, 3), CFrame = CFrame.new(base + Vector3.new(0, 7, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(110, 75, 45), Material = Enum.Material.Wood })
	part({ Shape = Enum.PartType.Ball, Size = Vector3.one * 12, Position = base + Vector3.new(0, 16, 0), Color = Color3.fromRGB(60, 150, 60), Material = Enum.Material.Grass, CanCollide = false })
end

-- Stepped pyramid: 2-stud steps are easy to walk up.
local function pyramid(center: Vector3, layers: number, zone: string)
	for i = 0, layers - 1 do
		local size = (layers - i) * 6
		part({ Size = Vector3.new(size, 2, size), Position = center + Vector3.new(0, 1 + i * 2, 0), Color = Color3.fromRGB(225, 195, 120), Material = Enum.Material.Sandstone })
	end
	spot(center + Vector3.new(0, layers * 2 + 1.5, 0), "On top of a pyramid in the " .. zone)
end

local function tower(base: Vector3, height: number, zone: string, color: Color3)
	part({ Size = Vector3.new(8, height, 8), Position = base + Vector3.new(0, height / 2, 0), Color = color, Material = Enum.Material.Concrete })
	truss(base + Vector3.new(5, 0, 0), height)
	spot(base + Vector3.new(0, height + 1.5, 0), "On top of a tall tower in " .. zone)
end

function World.Build()
	folder = Instance.new("Folder")
	folder.Name = "World"
	folder.Parent = workspace
	local rng = Random.new(7)

	-- Ground for each land zone
	part({ Name = "TownGround", Size = Vector3.new(180, 2, 180), Position = Vector3.new(0, -1, 0), Color = Color3.fromRGB(110, 200, 100), Material = Enum.Material.Grass })
	part({ Name = "ForestGround", Size = Vector3.new(160, 2, 180), Position = Vector3.new(220, -1, 0), Color = Color3.fromRGB(70, 140, 60), Material = Enum.Material.Grass })
	part({ Name = "DesertGround", Size = Vector3.new(160, 2, 180), Position = Vector3.new(-220, -1, 0), Color = Color3.fromRGB(235, 210, 150), Material = Enum.Material.Sand })
	part({ Name = "Bridge", Size = Vector3.new(400, 1, 10), Position = Vector3.new(0, -0.5, 0), Color = Color3.fromRGB(150, 110, 70), Material = Enum.Material.WoodPlanks })

	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.Position = Vector3.new(0, 0.5, 0)
	spawn.Neutral = true
	spawn.Color = Color3.fromRGB(255, 215, 0)
	spawn.Material = Enum.Material.Neon
	spawn.Parent = folder

	-- Town: 6 houses + a clock tower
	local colors = { Color3.fromRGB(240, 120, 120), Color3.fromRGB(120, 170, 240), Color3.fromRGB(250, 220, 120), Color3.fromRGB(150, 220, 150), Color3.fromRGB(220, 150, 230), Color3.fromRGB(240, 170, 110) }
	local housePositions = { Vector3.new(-50, 0, -50), Vector3.new(0, 0, -55), Vector3.new(50, 0, -50), Vector3.new(-50, 0, 50), Vector3.new(0, 0, 55), Vector3.new(50, 0, 50) }
	for i, pos in housePositions do
		house(pos, colors[i], "Town")
	end
	tower(Vector3.new(-65, 0, 0), 40, "Town", Color3.fromRGB(200, 200, 210))
	spot(Vector3.new(70, 1.5, 0), "Behind the fountain in Town")
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 14, 14), CFrame = CFrame.new(60, 1.5, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(180, 180, 190), Material = Enum.Material.Marble })

	-- Forest: trees, a log cabin, a lookout tower
	for _ = 1, 40 do
		tree(Vector3.new(220 + rng:NextNumber(-70, 70), 0, rng:NextNumber(-80, 80)))
	end
	house(Vector3.new(200, 0, -40), Color3.fromRGB(130, 90, 60), "the Forest")
	house(Vector3.new(250, 0, 50), Color3.fromRGB(110, 80, 55), "the Forest")
	tower(Vector3.new(270, 0, -60), 55, "the Forest", Color3.fromRGB(120, 90, 60))
	for i = 1, 5 do
		spot(Vector3.new(220 + rng:NextNumber(-60, 60), 1.5, rng:NextNumber(-70, 70)), "Hidden between the trees in the Forest (#" .. i .. ")")
	end

	-- Desert: pyramids and a ruin
	pyramid(Vector3.new(-200, 0, -40), 9, "Desert")
	pyramid(Vector3.new(-250, 0, 40), 6, "Desert")
	pyramid(Vector3.new(-170, 0, 60), 4, "Desert")
	house(Vector3.new(-260, 0, -60), Color3.fromRGB(200, 170, 110), "the Desert")
	for i = 1, 4 do
		local base = Vector3.new(-220 + rng:NextNumber(-60, 60), 0, rng:NextNumber(-80, 80))
		part({ Size = Vector3.new(2, 8, 2), Position = base + Vector3.new(0, 4, 0), Color = Color3.fromRGB(70, 160, 70), Material = Enum.Material.Grass })
		spot(base + Vector3.new(2, 1.5, 0), "Next to a cactus in the Desert (#" .. i .. ")")
	end

	-- Pond: real water, brainrots on the bottom and on a little island
	workspace.Terrain:FillBlock(CFrame.new(0, -6, 150), Vector3.new(100, 12, 100), Enum.Material.Water)
	part({ Name = "PondFloor", Size = Vector3.new(100, 2, 100), Position = Vector3.new(0, -13, 150), Color = Color3.fromRGB(190, 170, 130), Material = Enum.Material.Sand })
	for _, rim in {
		{ Vector3.new(120, 2, 10), Vector3.new(0, -1, 95) },
		{ Vector3.new(120, 2, 10), Vector3.new(0, -1, 205) },
		{ Vector3.new(10, 2, 120), Vector3.new(-55, -1, 150) },
		{ Vector3.new(10, 2, 120), Vector3.new(55, -1, 150) },
	} do
		part({ Name = "PondRim", Size = rim[1], Position = rim[2], Color = Color3.fromRGB(110, 200, 100), Material = Enum.Material.Grass })
	end
	part({ Name = "Island", Shape = Enum.PartType.Cylinder, Size = Vector3.new(14, 16, 16), CFrame = CFrame.new(20, -5, 160) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(110, 200, 100), Material = Enum.Material.Grass })
	spot(Vector3.new(20, 3.5, 160), "On the tiny island in the Pond")
	spot(Vector3.new(-30, -10.5, 170), "At the bottom of the Pond (swim down!)")
	spot(Vector3.new(30, -10.5, 120), "Deep in the Pond near the shore")

	-- Sky Islands: a staircase of floating platforms going up
	local pos = Vector3.new(0, 2, -110)
	part({ Size = Vector3.new(20, 1, 20), Position = Vector3.new(0, -0.5, -100), Color = Color3.fromRGB(200, 200, 255) })
	for i = 1, 24 do
		pos += Vector3.new(rng:NextNumber(-5, 5), 3.5, -9)
		local size = if i % 6 == 0 then 14 else 7
		part({ Size = Vector3.new(size, 1, size), Position = pos, Color = Color3.fromHSV(i / 24, 0.5, 1), Material = Enum.Material.SmoothPlastic })
		if i % 6 == 0 then
			spot(pos + Vector3.new(0, 2, 0), "Sky Islands, floating platform " .. i)
		end
	end
	spot(pos + Vector3.new(3, 2, 0), "At the very top of the Sky Islands")

	return spots
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="14">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="15">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="16">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="17">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Find the Brainrots client: counter, index with hints, radar/guide beams, teleports, spinning collectibles.
local CollectionService = game:GetService("CollectionService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local ShopUI = require(ReplicatedStorage.Common.ShopUI)
local UI = require(ReplicatedStorage.Common.UI)

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local hints = HttpService:JSONDecode((ReplicatedStorage:WaitForChild("Hints") :: StringValue).Value)

local gui = UI.new("ScreenGui", { Name = "HUD", ResetOnSpawn = false, Parent = player:WaitForChild("PlayerGui") }) :: ScreenGui
local toast = UI.CreateToaster(gui)
remotes:WaitForChild("Notify").OnClientEvent:Connect(toast)
local buy = ShopUI.Buyer(Config, toast)
local shop = ShopUI.Create(gui, Config, buy, Color3.fromRGB(40, 60, 40))

local counter = UI.new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 6),
	Size = UDim2.fromOffset(300, 60),
	BackgroundColor3 = Color3.fromRGB(30, 50, 30),
	BackgroundTransparency = 0.15,
	Parent = gui,
}, { UI.Corner(14), UI.Stroke(Color3.new(0, 0, 0), 3) })
local counterLabel = UI.Label("", { Size = UDim2.new(1, -10, 1, -8), Position = UDim2.fromOffset(5, 4), Parent = counter })

local found: { [number]: boolean } = {}
local function refreshFound()
	table.clear(found)
	for id in string.gmatch(player:GetAttribute("Found") or "", "[^,]+") do
		found[tonumber(id) :: number] = true
	end
	counterLabel.Text = "Found " .. (player:GetAttribute("FoundCount") or 0) .. " / " .. (workspace:GetAttribute("TotalBrainrots") or #hints)
end
player:GetAttributeChangedSignal("Found"):Connect(refreshFound)
refreshFound()

---------------------------------------------------------------- beams (radar + paid guide)

local function makeBeam(color: Color3): (Beam, Attachment)
	local target = Instance.new("Attachment")
	target.Parent = workspace.Terrain
	local beam = Instance.new("Beam")
	beam.Attachment1 = target
	beam.Color = ColorSequence.new(color)
	beam.Width0 = 0.6
	beam.Width1 = 0.6
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.Enabled = false
	beam.Parent = workspace.Terrain
	return beam, target
end
local radarBeam, radarTarget = makeBeam(Color3.fromRGB(0, 255, 200))
local guideBeam, guideTarget = makeBeam(Color3.fromRGB(255, 215, 0))
local guideUntil = 0

remotes:WaitForChild("Guide").OnClientEvent:Connect(function(position: Vector3, seconds: number, hint: string)
	guideTarget.WorldPosition = position
	guideUntil = os.clock() + seconds
	toast("Follow the gold beam! Hint: " .. hint, Color3.fromRGB(255, 215, 0))
end)

local rootAttachment: Attachment? = nil
local function onCharacter(character: Model)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if root then
		local a = Instance.new("Attachment")
		a.Parent = root
		rootAttachment = a
		radarBeam.Attachment0 = a
		guideBeam.Attachment0 = a
	end
end
player.CharacterAdded:Connect(onCharacter)
if player.Character then
	task.spawn(onCharacter, player.Character)
end

RunService.RenderStepped:Connect(function()
	local t = os.clock()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local nearest, nearestDist = nil, math.huge
	for _, model in CollectionService:GetTagged("Collectible") do
		local body = (model :: Model).PrimaryPart
		local index = model:GetAttribute("Index")
		if body and index then
			-- Spin + bob, and fade the ones you've found.
			local base = body:GetAttribute("BasePos") or body.Position
			body:SetAttribute("BasePos", base)
			local isFound = found[index] == true
			body.Transparency = if isFound then 0.75 else 0
			if root and not isFound then
				local d = (base - root.Position).Magnitude
				if d < nearestDist then
					nearest, nearestDist = base, d
				end
			end
			body.CFrame = CFrame.new(base + Vector3.new(0, math.sin(t * 2 + index) * 0.4, 0)) * CFrame.Angles(0, t * 1.5 + index, 0)
		end
	end
	radarBeam.Enabled = rootAttachment ~= nil and nearest ~= nil and player:GetAttribute("Pass_Radar") == true
	if nearest then
		radarTarget.WorldPosition = nearest
	end
	guideBeam.Enabled = rootAttachment ~= nil and t < guideUntil
end)

---------------------------------------------------------------- index

local index = UI.new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.new(0, 560, 0.72, 0),
	BackgroundColor3 = Color3.fromRGB(30, 50, 30),
	Visible = false,
	Parent = gui,
}, { UI.Corner(18), UI.Stroke(Color3.new(0, 0, 0), 4) }) :: Frame
UI.Label("BRAINROT INDEX", { Size = UDim2.new(1, -80, 0, 50), Position = UDim2.fromOffset(16, 6), TextXAlignment = Enum.TextXAlignment.Left, Parent = index })
UI.Button("X", Color3.fromRGB(230, 60, 60), { Size = UDim2.fromOffset(48, 48), Position = UDim2.new(1, -58, 0, 8), Parent = index }).Activated:Connect(function()
	index.Visible = false
end)
local list = UI.new("ScrollingFrame", {
	Position = UDim2.fromOffset(12, 64),
	Size = UDim2.new(1, -24, 1, -76),
	BackgroundTransparency = 1,
	AutomaticCanvasSize = Enum.AutomaticSize.Y,
	CanvasSize = UDim2.new(),
	ScrollBarThickness = 8,
	Parent = index,
})
local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 6)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = list

local function renderIndex()
	for _, c in list:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	for i, hint in hints do
		local isFound = found[i]
		local row = UI.new("Frame", { LayoutOrder = i, Size = UDim2.new(1, -10, 0, 58), BackgroundColor3 = if isFound then Color3.fromRGB(50, 90, 50) else Color3.fromRGB(45, 55, 45), Parent = list }, { UI.Corner(10) })
		UI.Label((if isFound then "✅ " .. Config.Names[i] else "❓ " .. Config.Names[i]), { Position = UDim2.fromOffset(10, 2), Size = UDim2.new(1, -20, 0, 28), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = if isFound then Color3.fromHSV(i / #hints, 0.6, 1) else Color3.fromRGB(200, 200, 200), Parent = row })
		UI.Label("Hint: " .. hint, { Position = UDim2.fromOffset(10, 30), Size = UDim2.new(1, -20, 0, 22), TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamMedium, TextColor3 = Color3.fromRGB(210, 220, 210), Parent = row })
	end
end
player:GetAttributeChangedSignal("Found"):Connect(function()
	if index.Visible then
		renderIndex()
	end
end)

---------------------------------------------------------------- teleport menu

local tpFrame = UI.new("Frame", {
	AnchorPoint = Vector2.new(0, 0.5),
	Position = UDim2.new(0, 150, 0.5, 0),
	Size = UDim2.fromOffset(170, 5 * 52 + 10),
	BackgroundTransparency = 1,
	Visible = false,
	Parent = gui,
})
local tpLayout = Instance.new("UIListLayout")
tpLayout.Padding = UDim.new(0, 6)
tpLayout.Parent = tpFrame
for i, zone in Config.ZoneSpawns do
	UI.Button(zone.Name, Color3.fromRGB(80, 140, 255), { Size = UDim2.fromOffset(170, 46), Parent = tpFrame }).Activated:Connect(function()
		remotes.Teleport:FireServer(i)
		tpFrame.Visible = false
	end)
end

local side = ShopUI.SideBar(gui)
UI.Button("INDEX", Color3.fromRGB(255, 170, 0), { Size = UDim2.fromOffset(130, 54), Parent = side }).Activated:Connect(function()
	shop.Visible = false
	index.Visible = not index.Visible
	if index.Visible then
		renderIndex()
	end
end)
UI.Button("TELEPORT", Color3.fromRGB(80, 140, 255), { Size = UDim2.fromOffset(130, 54), Parent = side }).Activated:Connect(function()
	if player:GetAttribute("Pass_Teleporter") then
		tpFrame.Visible = not tpFrame.Visible
	else
		buy("Pass", "Teleporter")
	end
end)
UI.Button("HINT", Color3.fromRGB(255, 215, 0), { Size = UDim2.fromOffset(130, 54), Parent = side }).Activated:Connect(function()
	buy("Product", "Hint")
end)
UI.Button("SHOP", Color3.fromRGB(40, 180, 70), { Size = UDim2.fromOffset(130, 54), Parent = side }).Activated:Connect(function()
	index.Visible = false
	shop.Visible = not shop.Visible
end)
