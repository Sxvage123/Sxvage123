    <Item class="Folder" referent="11">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="12">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Brainrot Ball server: homing ball, parries, eliminations, rounds, sword crates.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(ServerScriptService.CommonServer.DataService)
local MonetizationService = require(ServerScriptService.CommonServer.MonetizationService)

Lighting.ClockTime = 17.5
Lighting.Brightness = 2

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = ReplicatedStorage
local function remote(className: string, name: string): any
	local r = Instance.new(className)
	r.Name = name
	r.Parent = remotes
	return r
end
local NotifyRemote = remote("RemoteEvent", "Notify")
local ParryRemote = remote("RemoteEvent", "Parry")
local ParryFx = remote("RemoteEvent", "ParryFx")
local CrateRemote = remote("RemoteFunction", "OpenCrate")
local EquipRemote = remote("RemoteFunction", "EquipSword")

local function notify(player: Player?, text: string, color: Color3?)
	if player then
		NotifyRemote:FireClient(player, text, color)
	else
		NotifyRemote:FireAllClients(text, color)
	end
end

---------------------------------------------------------------- map

local ARENA = Vector3.new(0, 0, 300)
local ARENA_RADIUS = 70
local world = Instance.new("Folder")
world.Name = "World"
world.Parent = workspace
local function part(props): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = world
	return p
end
part({ Name = "Lobby", Size = Vector3.new(90, 2, 90), Position = Vector3.new(0, -1, 0), Color = Color3.fromRGB(235, 235, 245), Material = Enum.Material.Marble })
local spawn = Instance.new("SpawnLocation")
spawn.Anchored = true
spawn.Size = Vector3.new(12, 1, 12)
spawn.Position = Vector3.new(0, 0.5, 0)
spawn.Neutral = true
spawn.Color = Color3.fromRGB(255, 80, 80)
spawn.Material = Enum.Material.Neon
spawn.Parent = world
part({ Name = "Arena", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2, ARENA_RADIUS * 2, ARENA_RADIUS * 2), CFrame = CFrame.new(ARENA - Vector3.new(0, 1, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(60, 60, 80), Material = Enum.Material.Slate })
for i = 1, 36 do
	local a = i / 36 * math.pi * 2
	part({ Size = Vector3.new(13, 6, 1.5), CFrame = CFrame.new(ARENA + Vector3.new(math.cos(a) * ARENA_RADIUS, 3, math.sin(a) * ARENA_RADIUS)) * CFrame.Angles(0, -a + math.pi / 2, 0), Color = Color3.fromRGB(255, 60, 60), Material = Enum.Material.Neon, Transparency = 0.4 })
end

local ball = part({ Name = "Ball", Shape = Enum.PartType.Ball, Size = Vector3.one * 3, Position = ARENA + Vector3.new(0, 8, 0), Color = Color3.fromRGB(255, 255, 255), Material = Enum.Material.Neon, CanCollide = false })
ball.Transparency = 1
local light = Instance.new("PointLight")
light.Range = 16
light.Brightness = 3
light.Parent = ball
local trailA = Instance.new("Attachment")
trailA.Position = Vector3.new(0, 1, 0)
trailA.Parent = ball
local trailB = Instance.new("Attachment")
trailB.Position = Vector3.new(0, -1, 0)
trailB.Parent = ball
local trail = Instance.new("Trail")
trail.Attachment0 = trailA
trail.Attachment1 = trailB
trail.Lifetime = 0.25
trail.LightEmission = 1
trail.Parent = ball

---------------------------------------------------------------- helpers

local function sync(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	player:SetAttribute("Coins", data.Coins)
	player:SetAttribute("Wins", data.Wins)
	player:SetAttribute("Sword", data.Sword)
	local owned = {}
	for id in data.Swords do
		table.insert(owned, id)
	end
	player:SetAttribute("OwnedSwords", table.concat(owned, ","))
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats.Wins.Value = data.Wins
		stats.Kills.Value = data.Kills
	end
end

local function coinMult(player: Player): number
	local m = 1
	if MonetizationService.OwnsPass(player, "DoubleCoins") then
		m *= 2
	end
	if MonetizationService.OwnsPass(player, "VIP") then
		m *= 1.5
	end
	return m
end

local function addCoins(player: Player, amount: number)
	local data = DataService.Get(player)
	if data then
		data.Coins += math.floor(amount)
		sync(player)
	end
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function alive(): { Player }
	local list = {}
	for _, p in Players:GetPlayers() do
		if p:GetAttribute("Alive") and rootOf(p) then
			table.insert(list, p)
		end
	end
	return list
end

local function equipSword(player: Player)
	local data = DataService.Get(player)
	local character = player.Character
	local hand = character and (character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")) :: BasePart?
	if not data or not hand then
		return
	end
	local old = character:FindFirstChild("SwordBlade")
	if old then
		old:Destroy()
	end
	local sword = Config.SwordById[data.Sword] or Config.Swords[1]
	local blade = Instance.new("Part")
	blade.Name = "SwordBlade"
	blade.Size = Vector3.new(0.35, 0.35, 5)
	blade.Color = sword.Color
	blade.Material = sword.Material
	blade.CanCollide = false
	blade.CanQuery = false
	blade.Massless = true
	blade.CFrame = hand.CFrame * CFrame.new(0, -hand.Size.Y / 2, -2.4)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = hand
	weld.Part1 = blade
	weld.Parent = blade
	blade.Parent = character
end

---------------------------------------------------------------- ball

local state = {
	Active = false,
	Target = nil :: Player?,
	Speed = Config.BallStartSpeed,
	LastHitter = nil :: Player?,
	PausedUntil = 0,
}
local parryPressed: { [Player]: number } = {}
local parryCooldown: { [Player]: number } = {}

local function setTarget(player: Player?)
	state.Target = player
	ball:SetAttribute("TargetId", if player then player.UserId else 0)
	ball.Color = Color3.fromHSV(math.random(), 0.8, 1)
end

local function pickTarget(exclude: Player?, aim: Vector3?, from: Vector3?): Player?
	local candidates = {}
	for _, p in alive() do
		if p ~= exclude then
			table.insert(candidates, p)
		end
	end
	if #candidates == 0 then
		return exclude
	end
	if aim and from then
		local best, bestDot = nil, -2
		for _, p in candidates do
			local root = rootOf(p) :: BasePart
			local dot = (root.Position - from).Unit:Dot(aim.Unit)
			if dot > bestDot then
				best, bestDot = p, dot
			end
		end
		if best and bestDot > 0.5 then
			return best
		end
	end
	return candidates[math.random(1, #candidates)]
end

local function parryRange(): number
	return math.max(14, state.Speed * 0.4)
end

local function deflect(player: Player, aim: Vector3?)
	parryCooldown[player] = 0
	parryPressed[player] = nil
	state.Speed = math.min(Config.BallMaxSpeed, state.Speed + Config.BallSpeedGain)
	state.LastHitter = player
	local root = rootOf(player)
	setTarget(pickTarget(player, aim, root and root.Position))
	ParryFx:FireAllClients(ball.Position, player.UserId)
end

ParryRemote.OnServerEvent:Connect(function(player, aim)
	if not state.Active or not player:GetAttribute("Alive") then
		return
	end
	local now = os.clock()
	if now < (parryCooldown[player] or 0) then
		return
	end
	if typeof(aim) ~= "Vector3" or aim.Magnitude < 0.5 then
		aim = nil
	end
	local root = rootOf(player)
	if state.Target == player and root and (ball.Position - root.Position).Magnitude <= parryRange() then
		deflect(player, aim)
		return
	end
	-- Too early: remember the press briefly (latency forgiveness), then cooldown.
	parryPressed[player] = now
	parryCooldown[player] = now + Config.ParryCooldown
	player:SetAttribute("ParryAim", aim)
end)

local function eliminate(player: Player)
	player:SetAttribute("Alive", false)
	local root = rootOf(player)
	if root then
		local boom = Instance.new("Explosion")
		boom.Position = root.Position
		boom.BlastPressure = 0
		boom.DestroyJointRadiusPercent = 0
		boom.Parent = workspace
	end
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.Health = 0
	end
	local killer = state.LastHitter
	if killer and killer ~= player and killer.Parent then
		local data = DataService.Get(killer)
		if data then
			data.Kills += 1
			addCoins(killer, Config.KillCoins * coinMult(killer))
		end
		notify(nil, killer.DisplayName .. " eliminated " .. player.DisplayName .. "!", Color3.fromRGB(255, 120, 80))
	else
		notify(nil, player.DisplayName .. " got hit by the ball!", Color3.fromRGB(255, 120, 80))
	end
	state.Speed = Config.BallStartSpeed
	state.LastHitter = nil
	state.PausedUntil = os.clock() + 1.5
	ball.Position = ARENA + Vector3.new(0, 8, 0)
	setTarget(pickTarget(nil))
end

RunService.Heartbeat:Connect(function(dt)
	if not state.Active then
		return
	end
	local now = os.clock()
	if now < state.PausedUntil then
		return
	end
	local target = state.Target
	local root = target and target:GetAttribute("Alive") and rootOf(target)
	if not root then
		setTarget(pickTarget(nil))
		return
	end
	local toTarget = root.Position - ball.Position
	local dist = toTarget.Magnitude
	local step = state.Speed * dt
	if dist <= step + 2.5 then
		local pressed = parryPressed[target :: Player]
		if pressed and now - pressed <= Config.ParryWindow then
			deflect(target :: Player, (target :: Player):GetAttribute("ParryAim") :: Vector3?)
		else
			eliminate(target :: Player)
		end
		return
	end
	ball.Position += toTarget.Unit * step
end)

---------------------------------------------------------------- rounds

local function arenaSpawn(i: number, n: number): CFrame
	local a = i / n * math.pi * 2
	local pos = ARENA + Vector3.new(math.cos(a) * 45, 4, math.sin(a) * 45)
	return CFrame.lookAt(pos, ARENA + Vector3.new(0, 4, 0))
end

task.spawn(function()
	while true do
		for t = Config.Intermission, 1, -1 do
			workspace:SetAttribute("RoundState", "Intermission")
			workspace:SetAttribute("TimeLeft", t)
			task.wait(1)
		end
		local players = {}
		for _, p in Players:GetPlayers() do
			if DataService.Get(p) and rootOf(p) then
				table.insert(players, p)
			end
		end
		local minPlayers = if RunService:IsStudio() then 1 else Config.MinPlayers
		if #players < minPlayers then
			workspace:SetAttribute("RoundState", "Waiting")
			task.wait(2)
			continue
		end
		for i, p in players do
			p:SetAttribute("Alive", true)
			p.Character:PivotTo(arenaSpawn(i, #players))
		end
		workspace:SetAttribute("RoundState", "Playing")
		state.Speed = Config.BallStartSpeed
		state.LastHitter = nil
		state.PausedUntil = os.clock() + 2
		ball.Position = ARENA + Vector3.new(0, 8, 0)
		ball.Transparency = 0
		setTarget(pickTarget(nil))
		state.Active = true
		local solo = #players == 1
		while true do
			local left = alive()
			workspace:SetAttribute("AliveCount", #left)
			if #left == 0 or (not solo and #left <= 1) then
				break
			end
			task.wait(0.2)
		end
		state.Active = false
		ball.Transparency = 1
		setTarget(nil)
		local winners = alive()
		for _, w in winners do
			local data = DataService.Get(w)
			if data then
				data.Wins += 1
				addCoins(w, Config.WinCoins * coinMult(w))
			end
			notify(nil, w.DisplayName .. " WINS THE ROUND!", Color3.fromRGB(255, 215, 0))
			w:SetAttribute("Alive", false)
			if w.Character then
				w.Character:PivotTo(CFrame.new(0, 4, 0))
			end
		end
		workspace:SetAttribute("RoundState", "Ended")
		task.wait(3)
	end
end)

---------------------------------------------------------------- crates

local function rollSword(player: Player)
	local lucky = MonetizationService.OwnsPass(player, "LuckyCrates")
	local total = 0
	for i, r in Config.Rarities do
		total += r.Weight * (if lucky and i >= 3 then 2 else 1)
	end
	local roll = math.random() * total
	local rarity = Config.Rarities[1].Name
	for i, r in Config.Rarities do
		roll -= r.Weight * (if lucky and i >= 3 then 2 else 1)
		if roll <= 0 then
			rarity = r.Name
			break
		end
	end
	local pool = {}
	for _, s in Config.Swords do
		if s.Rarity == rarity then
			table.insert(pool, s.Id)
		end
	end
	return pool[math.random(1, #pool)]
end

CrateRemote.OnServerInvoke = function(player)
	local data = DataService.Get(player)
	if not data then
		return false, "Loading..."
	end
	if data.Coins < Config.CrateCost then
		return false, "Need " .. Config.CrateCost .. " coins!"
	end
	data.Coins -= Config.CrateCost
	local id = rollSword(player)
	local sword = Config.SwordById[id]
	local duplicate = data.Swords[id] == true
	if duplicate then
		data.Coins += math.floor(Config.CrateCost * 0.25)
	else
		data.Swords[id] = true
	end
	if sword.Rarity == "Legendary" or sword.Rarity == "Mythic" then
		notify(nil, player.DisplayName .. " unboxed " .. sword.Rarity .. " " .. sword.Name .. "!", Config.RarityColor[sword.Rarity])
	end
	sync(player)
	return true, id, duplicate
end

EquipRemote.OnServerInvoke = function(player, id)
	local data = DataService.Get(player)
	if not data or type(id) ~= "string" or not data.Swords[id] then
		return false
	end
	data.Sword = id
	equipSword(player)
	sync(player)
	return true
end

---------------------------------------------------------------- players

local function addTrail(player: Player)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root or root:FindFirstChild("VIPTrail") then
		return
	end
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 1, 0)
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -1, 0)
	a1.Parent = root
	local t = Instance.new("Trail")
	t.Name = "VIPTrail"
	t.Attachment0 = a0
	t.Attachment1 = a1
	t.Color = ColorSequence.new(Color3.fromRGB(255, 215, 0))
	t.LightEmission = 1
	t.Lifetime = 0.4
	t.Parent = root
end

DataService.ProfileLoaded:Connect(function(player, data)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, name in { "Wins", "Kills" } do
		local v = Instance.new("IntValue")
		v.Name = name
		v.Parent = stats
	end
	stats.Parent = player
	sync(player)
	local function onCharacter(character: Model)
		character:WaitForChild("HumanoidRootPart", 10)
		task.wait(0.2)
		if state.Active and player:GetAttribute("Alive") then
			character:PivotTo(arenaSpawn(math.random(1, 12), 12))
		end
		equipSword(player)
		if MonetizationService.OwnsPass(player, "VIP") then
			addTrail(player)
		end
	end
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
end)

Players.PlayerRemoving:Connect(function(player)
	parryPressed[player] = nil
	parryCooldown[player] = nil
end)

MonetizationService.Init({
	Passes = Config.Passes,
	Products = Config.Products,
	ProductHandlers = {
		CoinsSmall = function(player)
			addCoins(player, 1000)
			return true
		end,
		CoinsLarge = function(player)
			addCoins(player, 6000)
			return true
		end,
		Respawn = function(player)
			if state.Active and not player:GetAttribute("Alive") then
				player:SetAttribute("Alive", true)
				player:LoadCharacter()
				notify(nil, player.DisplayName .. " got a SECOND CHANCE!", Color3.fromRGB(90, 255, 90))
			else
				addCoins(player, 300)
				notify(player, "No round to rejoin — you got 300 coins instead!", Color3.fromRGB(255, 215, 0))
			end
			return true
		end,
	},
	OnPassOwned = function(player, name)
		if name == "VIP" then
			addTrail(player)
		end
		notify(player, "Unlocked " .. name .. "!", Color3.fromRGB(255, 215, 0))
	end,
})

DataService.Init("BrainrotBall_v1", {
	Coins = 0,
	Wins = 0,
	Kills = 0,
	Swords = { stick = true },
	Sword = "stick",
})
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="13">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="14">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="15">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="16">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Brainrot Ball client: parry (click/F/button), dash, targeted warning, crates, swords, shop.
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Common.Format)
local ShopUI = require(ReplicatedStorage.Common.ShopUI)
local UI = require(ReplicatedStorage.Common.UI)

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local ball = workspace:WaitForChild("World"):WaitForChild("Ball") :: BasePart

local gui = UI.new("ScreenGui", { Name = "HUD", ResetOnSpawn = false, Parent = player:WaitForChild("PlayerGui") }) :: ScreenGui
local toast = UI.CreateToaster(gui)
remotes:WaitForChild("Notify").OnClientEvent:Connect(toast)
local buy = ShopUI.Buyer(Config, toast)
local shop = ShopUI.Create(gui, Config, buy, Color3.fromRGB(50, 25, 35))
ShopUI.VIPChatTag("VIP")

---------------------------------------------------------------- HUD

local top = UI.new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 6),
	Size = UDim2.fromOffset(360, 76),
	BackgroundColor3 = Color3.fromRGB(30, 15, 20),
	BackgroundTransparency = 0.15,
	Parent = gui,
}, { UI.Corner(14), UI.Stroke(Color3.new(0, 0, 0), 3) })
local stateLabel = UI.Label("", { Size = UDim2.new(1, -10, 0, 40), Position = UDim2.fromOffset(5, 2), Parent = top })
local coinsLabel = UI.Label("", { Size = UDim2.new(1, -10, 0, 26), Position = UDim2.fromOffset(5, 44), TextColor3 = Color3.fromRGB(255, 215, 0), Parent = top })
local targeted = UI.Label("⚠ TARGETED — PARRY! ⚠", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.3),
	Size = UDim2.fromOffset(520, 56),
	TextColor3 = Color3.fromRGB(255, 50, 50),
	Visible = false,
	Parent = gui,
})
local respawnButton = UI.Button("SECOND CHANCE  R$ 29", Color3.fromRGB(40, 200, 80), {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.62),
	Size = UDim2.fromOffset(340, 80),
	Visible = false,
	Parent = gui,
})
respawnButton.Activated:Connect(function()
	buy("Product", "Respawn")
end)

player.AttributeChanged:Connect(function()
	coinsLabel.Text = Format.Abbreviate(player:GetAttribute("Coins") or 0) .. " coins  •  " .. (player:GetAttribute("Wins") or 0) .. " wins"
end)
coinsLabel.Text = "0 coins"

task.spawn(function()
	while true do
		local roundState = workspace:GetAttribute("RoundState")
		if roundState == "Playing" then
			stateLabel.Text = (workspace:GetAttribute("AliveCount") or 0) .. " players alive"
		elseif roundState == "Intermission" then
			stateLabel.Text = "Next round in " .. (workspace:GetAttribute("TimeLeft") or 0)
		elseif roundState == "Waiting" then
			stateLabel.Text = "Waiting for players..."
		else
			stateLabel.Text = "Round over!"
		end
		local isTarget = ball:GetAttribute("TargetId") == player.UserId and player:GetAttribute("Alive") == true
		targeted.Visible = isTarget
		if isTarget then
			targeted.TextTransparency = (math.sin(os.clock() * 20) + 1) * 0.25
		end
		respawnButton.Visible = roundState == "Playing" and not player:GetAttribute("Alive")
		task.wait(0.05)
	end
end)

---------------------------------------------------------------- parry + dash

local lastParry = 0
local function parry()
	local now = os.clock()
	if now - lastParry < 0.15 then
		return
	end
	lastParry = now
	local cam = workspace.CurrentCamera
	remotes.Parry:FireServer(cam and cam.CFrame.LookVector or nil)
end

local lastDash = -100
local function dash()
	local cooldown = if player:GetAttribute("Pass_QuickDash") then 3 else Config.DashCooldown
	if os.clock() - lastDash < cooldown then
		toast("Dash ready in " .. math.ceil(cooldown - (os.clock() - lastDash)) .. "s", Color3.fromRGB(200, 200, 200))
		return
	end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		lastDash = os.clock()
		root.AssemblyLinearVelocity = root.CFrame.LookVector * 110 + Vector3.new(0, 12, 0)
	end
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.F or input.UserInputType == Enum.UserInputType.MouseButton1 then
		parry()
	elseif input.KeyCode == Enum.KeyCode.Q then
		dash()
	end
end)

local parryButton = UI.Button("PARRY", Color3.fromRGB(230, 50, 50), {
	AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(1, -20, 1, -130),
	Size = UDim2.fromOffset(120, 120),
	Parent = gui,
})
parryButton.Activated:Connect(parry)
local dashButton = UI.Button("DASH", Color3.fromRGB(60, 120, 255), {
	AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(1, -150, 1, -140),
	Size = UDim2.fromOffset(90, 90),
	Parent = gui,
})
dashButton.Activated:Connect(dash)
parryButton.Visible = UserInputService.TouchEnabled
dashButton.Visible = UserInputService.TouchEnabled

remotes:WaitForChild("ParryFx").OnClientEvent:Connect(function(position: Vector3)
	local ring = Instance.new("Part")
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.Shape = Enum.PartType.Ball
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(255, 255, 255)
	ring.Transparency = 0.3
	ring.Size = Vector3.one * 2
	ring.Position = position
	ring.Parent = workspace
	TweenService:Create(ring, TweenInfo.new(0.3), { Size = Vector3.one * 12, Transparency = 1 }):Play()
	Debris:AddItem(ring, 0.35)
end)

---------------------------------------------------------------- swords + crates

local swordsFrame = UI.new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.new(0, 520, 0.7, 0),
	BackgroundColor3 = Color3.fromRGB(45, 25, 35),
	Visible = false,
	Parent = gui,
}, { UI.Corner(18), UI.Stroke(Color3.new(0, 0, 0), 4) }) :: Frame
UI.Label("SWORDS", { Size = UDim2.new(1, -80, 0, 50), Position = UDim2.fromOffset(16, 6), TextXAlignment = Enum.TextXAlignment.Left, Parent = swordsFrame })
UI.Button("X", Color3.fromRGB(230, 60, 60), { Size = UDim2.fromOffset(48, 48), Position = UDim2.new(1, -58, 0, 8), Parent = swordsFrame }).Activated:Connect(function()
	swordsFrame.Visible = false
end)
local crateButton = UI.Button("OPEN CRATE (" .. Config.CrateCost .. " coins)", Color3.fromRGB(255, 170, 0), { Position = UDim2.fromOffset(16, 62), Size = UDim2.new(1, -32, 0, 54), Parent = swordsFrame })
local oddsParts = {}
for _, r in Config.Rarities do
	table.insert(oddsParts, r.Name .. " " .. r.Weight .. "%")
end
UI.Label(table.concat(oddsParts, " • "), { Position = UDim2.fromOffset(16, 120), Size = UDim2.new(1, -32, 0, 22), Font = Enum.Font.GothamMedium, Parent = swordsFrame })
local swordList = UI.new("ScrollingFrame", {
	Position = UDim2.fromOffset(12, 150),
	Size = UDim2.new(1, -24, 1, -162),
	BackgroundTransparency = 1,
	AutomaticCanvasSize = Enum.AutomaticSize.Y,
	CanvasSize = UDim2.new(),
	ScrollBarThickness = 8,
	Parent = swordsFrame,
})
local swordLayout = Instance.new("UIListLayout")
swordLayout.Padding = UDim.new(0, 6)
swordLayout.SortOrder = Enum.SortOrder.LayoutOrder
swordLayout.Parent = swordList

local function renderSwords()
	for _, c in swordList:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	local owned = {}
	for id in string.gmatch(player:GetAttribute("OwnedSwords") or "", "[^,]+") do
		owned[id] = true
	end
	for i, sword in Config.Swords do
		local has = owned[sword.Id]
		local row = UI.new("Frame", { LayoutOrder = -i, Size = UDim2.new(1, -10, 0, 56), BackgroundColor3 = Color3.fromRGB(65, 40, 55), Parent = swordList }, { UI.Corner(10) })
		UI.Label(if has then sword.Name else "??? (" .. sword.Rarity .. ")", { Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -150, 1, -8), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Config.RarityColor[sword.Rarity], Parent = row })
		if has then
			local equipped = player:GetAttribute("Sword") == sword.Id
			local b = UI.Button(if equipped then "EQUIPPED" else "EQUIP", if equipped then Color3.fromRGB(90, 90, 90) else Color3.fromRGB(40, 180, 70), { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(120, 44), Parent = row })
			b.Activated:Connect(function()
				remotes.EquipSword:InvokeServer(sword.Id)
			end)
		end
	end
end
player:GetAttributeChangedSignal("OwnedSwords"):Connect(function()
	if swordsFrame.Visible then
		renderSwords()
	end
end)
player:GetAttributeChangedSignal("Sword"):Connect(function()
	if swordsFrame.Visible then
		renderSwords()
	end
end)

crateButton.Activated:Connect(function()
	local ok, result, duplicate = remotes.OpenCrate:InvokeServer()
	if not ok then
		toast(result, Color3.fromRGB(255, 90, 90))
		buy("Product", "CoinsSmall")
		return
	end
	local sword = Config.SwordById[result]
	toast((if duplicate then "Duplicate (+25% refund): " else "NEW SWORD: ") .. sword.Name .. " (" .. sword.Rarity .. ")", Config.RarityColor[sword.Rarity])
end)

local side = ShopUI.SideBar(gui)
UI.Button("SWORDS", Color3.fromRGB(255, 120, 40), { Size = UDim2.fromOffset(130, 54), Parent = side }).Activated:Connect(function()
	shop.Visible = false
	swordsFrame.Visible = not swordsFrame.Visible
	if swordsFrame.Visible then
		renderSwords()
	end
end)
UI.Button("SHOP", Color3.fromRGB(40, 180, 70), { Size = UDim2.fromOffset(130, 54), Parent = side }).Activated:Connect(function()
	swordsFrame.Visible = false
	shop.Visible = not shop.Visible
end)
UI.Label("Click / F = Parry\nQ = Dash", { Size = UDim2.fromOffset(130, 50), Parent = side })
