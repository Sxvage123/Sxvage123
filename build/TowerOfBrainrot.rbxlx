  <Item class="ServerScriptService" referent="9">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="10">
      <Properties>
        <string name="Name">CommonServer</string>
      </Properties>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Session-locked DataStore saving shared by every game.
-- Keeps each player's data in memory, autosaves, and never lets two servers
-- write the same player at once (prevents item duplication / rollbacks).
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local DataService = {}

local AUTOSAVE_INTERVAL = 90
local LOCK_EXPIRE = 600
local LOAD_ATTEMPTS = 6

local profiles: { [Player]: { [string]: any } } = {}
local loadedEvent = Instance.new("BindableEvent")
local releasingEvent = Instance.new("BindableEvent")
DataService.ProfileLoaded = loadedEvent.Event -- (player, data)
DataService.ProfileReleasing = releasingEvent.Event -- (player, data) fired before the final save

local store: DataStore? = nil
local memoryStore: { [string]: any } = {}
local template: { [string]: any } = {}
local initialized = false

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end
DataService.DeepCopy = deepCopy

local function reconcile(data, tmpl)
	for key, value in tmpl do
		if data[key] == nil then
			data[key] = deepCopy(value)
		elseif type(value) == "table" and type(data[key]) == "table" and next(value) ~= nil and #value == 0 then
			reconcile(data[key], value)
		end
	end
end

local function update(key: string, transform: (any) -> any): (boolean, any)
	if not store then
		local result = transform(memoryStore[key])
		if result ~= nil then
			memoryStore[key] = deepCopy(result)
		end
		return true, result
	end
	local ok, result = pcall(function()
		return (store :: DataStore):UpdateAsync(key, transform)
	end)
	return ok, result
end

local function keyFor(player: Player): string
	return "Player_" .. player.UserId
end

local function loadProfile(player: Player)
	local key = keyFor(player)
	for attempt = 1, LOAD_ATTEMPTS do
		local stealLock = attempt == LOAD_ATTEMPTS
		local lockedElsewhere = false
		local ok, result = update(key, function(stored)
			stored = stored or { Data = deepCopy(template) }
			local lock = stored.Lock
			if lock and lock.JobId ~= game.JobId and os.time() - lock.Time < LOCK_EXPIRE and not stealLock then
				lockedElsewhere = true
				return nil
			end
			stored.Lock = { JobId = game.JobId, Time = os.time() }
			return stored
		end)
		if ok and result and not lockedElsewhere then
			local data = result.Data or deepCopy(template)
			reconcile(data, template)
			return data
		end
		if not ok then
			warn("[DataService] load failed for", player.Name, result)
		end
		task.wait(lockedElsewhere and 5 or 2)
		if not player.Parent then
			return nil
		end
	end
	return nil
end

-- Saves the player's data. `release` clears the session lock (used on leave).
function DataService.Save(player: Player, release: boolean?): boolean
	local data = profiles[player]
	if not data then
		return false
	end
	data.LastSave = os.time()
	local snapshot = deepCopy(data)
	local ok, err = update(keyFor(player), function(stored)
		stored = stored or {}
		if stored.Lock and stored.Lock.JobId ~= game.JobId then
			-- Another server took over this player; never overwrite its data.
			return nil
		end
		stored.Data = snapshot
		stored.Lock = if release then nil else { JobId = game.JobId, Time = os.time() }
		return stored
	end)
	if not ok then
		warn("[DataService] save failed for", player.Name, err)
	end
	return ok
end

function DataService.Get(player: Player): { [string]: any }?
	return profiles[player]
end

function DataService.WaitFor(player: Player, timeout: number?): { [string]: any }?
	local deadline = os.clock() + (timeout or 15)
	while not profiles[player] and player.Parent and os.clock() < deadline do
		task.wait(0.1)
	end
	return profiles[player]
end

local function onPlayerAdded(player: Player)
	local data = loadProfile(player)
	if not player.Parent then
		if data then
			profiles[player] = data
			DataService.Save(player, true)
			profiles[player] = nil
		end
		return
	end
	if not data then
		player:Kick("Your data could not load. Please rejoin in a moment!")
		return
	end
	data.LoginCount = (data.LoginCount or 0) + 1
	profiles[player] = data
	loadedEvent:Fire(player, data)
end

local function onPlayerRemoving(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	releasingEvent:Fire(player, data)
	DataService.Save(player, true)
	profiles[player] = nil
end

function DataService.Init(storeName: string, dataTemplate: { [string]: any })
	assert(not initialized, "DataService already initialized")
	initialized = true
	template = dataTemplate
	template.LastSave = template.LastSave or 0
	template.LoginCount = template.LoginCount or 0
	template.Receipts = template.Receipts or {}
	template.RobuxSpent = template.RobuxSpent or 0

	local ok, result = pcall(function()
		local s = DataStoreService:GetDataStore(storeName)
		if RunService:IsStudio() then
			-- Throws when "Enable Studio Access to API Services" is off.
			s:GetAsync("__probe")
		end
		return s
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStores unavailable, using memory only (turn on API access in Game Settings to save):", result)
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player in profiles do
				task.spawn(DataService.Save, player, false)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				releasingEvent:Fire(player, profiles[player])
				DataService.Save(player, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[-- Game pass ownership + developer product receipts, done safely:
-- every receipt is granted exactly once and saved before Roblox is told it succeeded.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local DataService = require(script.Parent.DataService)

local MonetizationService = {}

type Config = {
	Passes: { [string]: number },
	Products: { [string]: number },
	ProductHandlers: { [string]: (Player, { [string]: any }) -> boolean? },
	OnPassOwned: ((Player, string) -> ())?,
}

local passes: { [string]: number } = {}
local passIdToName: { [number]: string } = {}
local productIdToName: { [number]: string } = {}
local handlers = {}
local onPassOwned: ((Player, string) -> ())? = nil

local MAX_RECEIPTS = 100

local function setPass(player: Player, name: string)
	if player:GetAttribute("Pass_" .. name) then
		return
	end
	player:SetAttribute("Pass_" .. name, true)
	if onPassOwned then
		task.spawn(onPassOwned, player, name)
	end
end

function MonetizationService.OwnsPass(player: Player, name: string): boolean
	return player:GetAttribute("Pass_" .. name) == true
end

local function checkPasses(player: Player)
	for name, id in passes do
		if id and id > 0 then
			task.spawn(function()
				local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, id)
				if ok and owns and player.Parent then
					setPass(player, name)
				end
			end)
		end
	end
end

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = DataService.WaitFor(player, 20)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if table.find(data.Receipts, receipt.PurchaseId) then
		-- Already applied in memory; only confirm once it's actually saved
		-- (an earlier save may have failed).
		if DataService.Save(player, false) then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local name = productIdToName[receipt.ProductId]
	local handler = name and handlers[name]
	if not handler then
		warn("[Monetization] no handler for product", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok, result = pcall(handler, player, data)
	if not ok then
		warn("[Monetization] handler error", name, result)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if result == false then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(data.Receipts, receipt.PurchaseId)
	while #data.Receipts > MAX_RECEIPTS do
		table.remove(data.Receipts, 1)
	end
	data.RobuxSpent = (data.RobuxSpent or 0) + (receipt.CurrencySpent or 0)
	if DataService.Save(player, false) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

function MonetizationService.Init(config: Config)
	passes = config.Passes
	handlers = config.ProductHandlers
	onPassOwned = config.OnPassOwned
	for name, id in config.Passes do
		passIdToName[id] = name
	end
	for name, id in config.Products do
		productIdToName[id] = name
	end

	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local name = passIdToName[passId]
		if purchased and name then
			setPass(player, name)
		end
	end)

	-- In Studio, buttons for passes/products whose ID is still 0 grant instantly so you can test.
	local testRemote = Instance.new("RemoteEvent")
	testRemote.Name = "StudioTestPurchase"
	testRemote.Parent = ReplicatedStorage
	testRemote.OnServerEvent:Connect(function(player, kind, name)
		if not RunService:IsStudio() or type(name) ~= "string" then
			return
		end
		if kind == "Pass" and passes[name] ~= nil then
			setPass(player, name)
		elseif kind == "Product" and handlers[name] then
			local data = DataService.Get(player)
			if data then
				handlers[name](player, data)
			end
		end
	end)

	Players.PlayerAdded:Connect(checkPasses)
	for _, player in Players:GetPlayers() do
		checkPasses(player)
	end
end

-- Lets admins / testers grant passes in Studio before IDs exist.
function MonetizationService.GrantPassForTesting(player: Player, name: string)
	setPass(player, name)
end

return MonetizationService
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="13">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="14">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Tower of Brainrot server: rounds with a fresh random tower, kill bricks, lava mutator, coins, coils.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(ServerScriptService.CommonServer.DataService)
local MonetizationService = require(ServerScriptService.CommonServer.MonetizationService)
local Tower = require(script.Parent.Tower)

Lighting.ClockTime = 16
Lighting.Brightness = 2.5

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = ReplicatedStorage
local NotifyRemote = Instance.new("RemoteEvent")
NotifyRemote.Name = "Notify"
NotifyRemote.Parent = remotes
local CoilRemote = Instance.new("RemoteEvent")
CoilRemote.Name = "ToggleCoil"
CoilRemote.Parent = remotes

local function notify(player: Player?, text: string, color: Color3?)
	if player then
		NotifyRemote:FireClient(player, text, color)
	else
		NotifyRemote:FireAllClients(text, color)
	end
end

local spawn = Instance.new("SpawnLocation")
spawn.Anchored = true
spawn.Size = Vector3.new(8, 1, 8)
spawn.Position = Vector3.new(-12, 0.5, -12)
spawn.Neutral = true
spawn.Color = Color3.fromRGB(255, 215, 0)
spawn.Material = Enum.Material.Neon
spawn.Parent = workspace

local lava = Instance.new("Part")
lava.Name = "RisingLava"
lava.Anchored = true
lava.CanCollide = false
lava.Size = Vector3.new(44, 2, 44)
lava.Color = Color3.fromRGB(255, 90, 20)
lava.Material = Enum.Material.Neon
lava.Transparency = 0.25
lava.Position = Vector3.new(0, -20, 0)
lava:SetAttribute("Kill", true)
lava.Parent = workspace

local finishers: { [Player]: boolean } = {}
local roundEnds = 0
local lavaOn = false
local rebuildRequested = false

local function sync(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	player:SetAttribute("Coins", data.Coins)
	player:SetAttribute("Wins", data.Wins)
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats.Wins.Value = data.Wins
		stats.Coins.Value = data.Coins
	end
end

local function applyMovement(player: Player)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	humanoid.UseJumpPower = true
	humanoid.WalkSpeed = if player:GetAttribute("SpeedOn") and MonetizationService.OwnsPass(player, "SpeedCoil") then 26 else 16
	humanoid.JumpPower = if player:GetAttribute("GravityOn") and MonetizationService.OwnsPass(player, "GravityCoil") then 70 else 50
end

local function hookKillers()
	for _, p in Tower.Folder():GetDescendants() do
		if p:IsA("BasePart") and p:GetAttribute("Kill") then
			p.Touched:Connect(function(hit)
				local model = hit:FindFirstAncestorOfClass("Model")
				local humanoid = model and model:FindFirstChildOfClass("Humanoid")
				if humanoid and humanoid.Health > 0 then
					humanoid.Health = 0
				end
			end)
		end
	end
end
lava.Touched:Connect(function(hit)
	local model = hit:FindFirstAncestorOfClass("Model")
	local humanoid = model and model:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		humanoid.Health = 0
	end
end)

local function onFinish(player: Player)
	if finishers[player] then
		return
	end
	finishers[player] = true
	local data = DataService.Get(player)
	if data then
		local m = 1
		if MonetizationService.OwnsPass(player, "DoubleCoins") then
			m *= 2
		end
		if MonetizationService.OwnsPass(player, "VIP") then
			m *= 1.5
		end
		data.Wins += 1
		data.Coins += math.floor(Config.TopCoins * m)
		sync(player)
	end
	notify(nil, player.DisplayName .. " beat the Tower of Brainrot!", Color3.fromRGB(255, 215, 0))
end

local function newTower()
	local finish = Tower.Build()
	finish.Touched:Connect(function(hit)
		local model = hit:FindFirstAncestorOfClass("Model")
		local player = model and Players:GetPlayerFromCharacter(model)
		if player then
			onFinish(player)
		end
	end)
	hookKillers()
	table.clear(finishers)
	lavaOn = false
	lava.Position = Vector3.new(0, -20, 0)
	roundEnds = os.time() + Config.RoundTime
	workspace:SetAttribute("RoundEnds", roundEnds)
	workspace:SetAttribute("LavaOn", false)
	for _, player in Players:GetPlayers() do
		if player.Character then
			player.Character:PivotTo(spawn.CFrame + Vector3.new(0, 4, 0))
		end
	end
	notify(nil, "A NEW TOWER appeared! Reach the top before time runs out!", Color3.fromRGB(120, 220, 255))
end

task.spawn(function()
	newTower()
	while true do
		task.wait(0.2)
		if rebuildRequested or os.time() >= roundEnds then
			rebuildRequested = false
			newTower()
		end
		if lavaOn and lava.Position.Y < Config.Sections * Config.SectionHeight - 4 then
			lava.Position += Vector3.new(0, Config.LavaSpeed * 0.2, 0)
		end
		-- current section for each player (shown on the HUD + used by Skip Section)
		for _, player in Players:GetPlayers() do
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				player:SetAttribute("Section", math.clamp(math.floor(root.Position.Y / Config.SectionHeight) + 1, 1, Config.Sections))
			end
		end
	end
end)

CoilRemote.OnServerEvent:Connect(function(player, name)
	if name == "Speed" then
		player:SetAttribute("SpeedOn", not player:GetAttribute("SpeedOn"))
	elseif name == "Gravity" then
		player:SetAttribute("GravityOn", not player:GetAttribute("GravityOn"))
	end
	applyMovement(player)
end)

DataService.ProfileLoaded:Connect(function(player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, name in { "Wins", "Coins" } do
		local v = Instance.new("IntValue")
		v.Name = name
		v.Parent = stats
	end
	stats.Parent = player
	sync(player)
	player.CharacterAdded:Connect(function(character)
		character:WaitForChild("Humanoid", 10)
		applyMovement(player)
	end)
	if player.Character then
		applyMovement(player)
	end
end)

Players.PlayerRemoving:Connect(function(player)
	finishers[player] = nil
end)

MonetizationService.Init({
	Passes = Config.Passes,
	Products = Config.Products,
	ProductHandlers = {
		LavaRise = function(player)
			lavaOn = true
			lava.Position = Vector3.new(0, -2, 0)
			workspace:SetAttribute("LavaOn", true)
			notify(nil, player.DisplayName .. " made the LAVA RISE! Climb!", Color3.fromRGB(255, 120, 40))
			return true
		end,
		SlowTime = function(player)
			roundEnds += 120
			workspace:SetAttribute("RoundEnds", roundEnds)
			notify(nil, player.DisplayName .. " added 2 minutes to the timer!", Color3.fromRGB(120, 255, 120))
			return true
		end,
		SkipSection = function(player)
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local section = player:GetAttribute("Section") or 1
				local y = math.min(section, Config.Sections) * Config.SectionHeight + 3
				player.Character:PivotTo(CFrame.new(10, y, 10))
			end
			return true
		end,
		NewTower = function(player)
			rebuildRequested = true
			notify(nil, player.DisplayName .. " summoned a NEW TOWER!", Color3.fromRGB(120, 220, 255))
			return true
		end,
	},
	OnPassOwned = function(player, name)
		if name == "SpeedCoil" then
			player:SetAttribute("SpeedOn", true)
		elseif name == "GravityCoil" then
			player:SetAttribute("GravityOn", true)
		end
		applyMovement(player)
		notify(player, "Unlocked " .. name .. "!", Color3.fromRGB(255, 215, 0))
	end,
})

DataService.Init("TowerOfBrainrot_v1", {
	Coins = 0,
	Wins = 0,
})
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Tower</string>
          <string name="Source"><![CDATA[-- Builds a random tower out of stacked sections. Each section is a 40x40 floor area climbed via an obstacle.
local Config = require(game:GetService("ReplicatedStorage").Shared.Config)

local Tower = {}
Tower.Base = Vector3.new(0, 0, 0)

local folder: Folder
local rng: Random
local COLORS = {
	Color3.fromRGB(255, 99, 99), Color3.fromRGB(255, 170, 60), Color3.fromRGB(255, 230, 80), Color3.fromRGB(110, 230, 110),
	Color3.fromRGB(80, 200, 255), Color3.fromRGB(150, 110, 255), Color3.fromRGB(255, 120, 220),
}

local function part(props): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = folder
	return p
end
local function killer(props): BasePart
	props.Color = Color3.fromRGB(255, 30, 30)
	props.Material = Enum.Material.Neon
	local p = part(props)
	p:SetAttribute("Kill", true)
	return p
end

-- Every section is one lap around the shaft: it starts at the opening corner (-14, -14) on the floor and
-- climbs to just under the next floor's opening at the same corner, so any section order is beatable.
-- Default character: ~7 studs jump height, ~8 studs flat jump; all gaps below stay well inside that.
local H = Config.SectionHeight
local R = 14

local function lap(t: number): Vector3
	local d = (t % 1) * 8 * R -- perimeter distance
	if d < 2 * R then
		return Vector3.new(-R + d, 0, -R)
	elseif d < 4 * R then
		return Vector3.new(R, 0, -R + (d - 2 * R))
	elseif d < 6 * R then
		return Vector3.new(R - (d - 4 * R), 0, R)
	end
	return Vector3.new(-R, 0, R - (d - 6 * R))
end
local function rise(t: number): number
	return 1.5 + t * (H - 4)
end

-- Lava over the section floor, leaving the arrival corner (x, z < -6) safe.
local function lavaFloor(y: number)
	killer({ Size = Vector3.new(38, 0.4, 25), Position = Vector3.new(0, y + 0.3, 6.5) })
	killer({ Size = Vector3.new(25, 0.4, 13), Position = Vector3.new(6.5, y + 0.3, -12.5) })
end

local builders = {}

function builders.Stairs(y: number, color: Color3)
	for i = 1, 12 do
		local t = i / 12
		part({ Size = Vector3.new(5, 1, 5), Position = lap(t) + Vector3.new(0, y + rise(t), 0), Color = color })
	end
end
function builders.TinySteps(y: number, color: Color3)
	for i = 1, 16 do
		local t = i / 16
		part({ Size = Vector3.new(3, 1, 3), Position = lap(t) + Vector3.new(0, y + rise(t), 0), Color = color })
	end
	lavaFloor(y)
end
function builders.LavaJumps(y: number, color: Color3)
	for i = 1, 14 do
		local t = i / 14
		local wobble = Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1))
		part({ Size = Vector3.new(4, 1, 4), Position = lap(t) + wobble * (if i == 14 then 0 else 1) + Vector3.new(0, y + rise(t), 0), Color = color })
	end
	lavaFloor(y)
end
function builders.Beams(y: number, color: Color3)
	local prev = lap(0) + Vector3.new(0, y + rise(0), 0)
	part({ Size = Vector3.new(4, 1, 4), Position = prev, Color = color })
	for i = 1, 8 do
		local t = i / 8
		local nextPos = lap(t) + Vector3.new(0, y + rise(t), 0)
		part({ Size = Vector3.new(1.4, 1, (nextPos - prev).Magnitude + 1), CFrame = CFrame.lookAt((prev + nextPos) / 2, nextPos), Color = color })
		part({ Size = Vector3.new(3, 1, 3), Position = nextPos, Color = color })
		prev = nextPos
	end
	lavaFloor(y)
end
function builders.Wallhops(y: number, color: Color3)
	for i = 1, 12 do
		local t = i / 12
		local pos = lap(t) + Vector3.new(0, y + rise(t), 0)
		part({ Size = Vector3.new(4, 1, 4), Position = pos, Color = color })
		if i < 12 then
			-- Post beside the jump line (pushed toward the shaft centre) to hop past.
			local mid = lap(t + 1 / 24)
			local inward = if mid.Magnitude > 0 then -mid.Unit * 2.6 else Vector3.zero
			part({ Size = Vector3.new(1, 6, 1), Position = mid + inward + Vector3.new(0, y + rise(t) + 3, 0), Color = Color3.fromRGB(60, 60, 70) })
		end
	end
end
function builders.Truss(y: number, color: Color3)
	-- Low walk to the far corner, climb a truss, then a flat walkway back at the top.
	for i = 1, 6 do
		local t = i / 12
		part({ Size = Vector3.new(5, 1, 5), Position = lap(t) + Vector3.new(0, y + 1.5, 0), Color = color })
	end
	local corner = lap(0.5)
	local t = Instance.new("TrussPart")
	t.Anchored = true
	t.Size = Vector3.new(2, H - 4, 2)
	t.Position = corner + Vector3.new(0, y + 2 + (H - 4) / 2, 2)
	t.Parent = folder
	for i = 6, 12 do
		local tt = i / 12
		part({ Size = Vector3.new(4, 1, 4), Position = lap(tt) + Vector3.new(0, y + H - 2.5, 0), Color = color })
	end
end

local ORDER = { "Stairs", "TinySteps", "Truss", "LavaJumps", "Wallhops", "Beams" }

-- Returns the top finish part.
function Tower.Build(): BasePart
	if folder then
		folder:Destroy()
	end
	folder = Instance.new("Folder")
	folder.Name = "Tower"
	folder.Parent = workspace
	rng = Random.new(os.time())
	part({ Name = "StartFloor", Size = Vector3.new(40, 1, 40), Position = Vector3.new(0, -0.5, 0), Color = Color3.fromRGB(230, 230, 240), Material = Enum.Material.Marble })
	for i = 0, Config.Sections - 1 do
		local y = i * H
		local color = COLORS[(i % #COLORS) + 1]
		builders[ORDER[rng:NextInteger(1, #ORDER)]](y, color)
		-- floor of the next section, with a 12x12 opening over the (-14, -14) corner where every lap ends
		part({ Size = Vector3.new(40, 1, 28), Position = Vector3.new(0, y + H - 0.5, 6), Color = color:Lerp(Color3.new(1, 1, 1), 0.3), Transparency = 0.2 })
		part({ Size = Vector3.new(28, 1, 12), Position = Vector3.new(6, y + H - 0.5, -14), Color = color:Lerp(Color3.new(1, 1, 1), 0.3), Transparency = 0.2 })
		-- glass shaft walls
		for _, s in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
			part({ Size = if s[1] ~= 0 then Vector3.new(1, H, 40) else Vector3.new(40, H, 1), Position = Vector3.new(s[1] * 20.5, y + H / 2, s[2] * 20.5), Color = Color3.fromRGB(200, 230, 255), Transparency = 0.8, Material = Enum.Material.Glass })
		end
		local sign = part({ Size = Vector3.new(0.2, 0.2, 0.2), Position = Vector3.new(0, y + 3, -19), Transparency = 1, CanCollide = false })
		sign:SetAttribute("Section", i + 1)
	end
	local top = part({ Name = "Finish", Size = Vector3.new(40, 1, 40), Position = Vector3.new(0, Config.Sections * H + 0.5, 0), Color = Color3.fromRGB(255, 215, 0), Material = Enum.Material.Neon })
	return top
end

function Tower.Folder(): Folder
	return folder
end

return Tower
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="16">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="17">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="18">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="19">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Tower of Brainrot client: timer, section counter, coils, mutator buttons, shop.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Common.Format)
local ShopUI = require(ReplicatedStorage.Common.ShopUI)
local UI = require(ReplicatedStorage.Common.UI)

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")

local gui = UI.new("ScreenGui", { Name = "HUD", ResetOnSpawn = false, Parent = player:WaitForChild("PlayerGui") }) :: ScreenGui
local toast = UI.CreateToaster(gui)
remotes:WaitForChild("Notify").OnClientEvent:Connect(toast)
local buy = ShopUI.Buyer(Config, toast)
local shop = ShopUI.Create(gui, Config, buy, Color3.fromRGB(30, 40, 60))
ShopUI.VIPChatTag("VIP")

local top = UI.new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 6),
	Size = UDim2.fromOffset(380, 80),
	BackgroundColor3 = Color3.fromRGB(25, 30, 45),
	BackgroundTransparency = 0.15,
	Parent = gui,
}, { UI.Corner(14), UI.Stroke(Color3.new(0, 0, 0), 3) })
local timerLabel = UI.Label("", { Size = UDim2.new(1, -10, 0, 42), Position = UDim2.fromOffset(5, 2), Parent = top })
local infoLabel = UI.Label("", { Size = UDim2.new(1, -10, 0, 28), Position = UDim2.fromOffset(5, 46), TextColor3 = Color3.fromRGB(255, 215, 0), Parent = top })

task.spawn(function()
	while true do
		local left = (workspace:GetAttribute("RoundEnds") or 0) - os.time()
		timerLabel.Text = "New tower in " .. Format.Time(left) .. (if workspace:GetAttribute("LavaOn") then "  🔥 LAVA" else "")
		timerLabel.TextColor3 = if left < 60 then Color3.fromRGB(255, 90, 90) else Color3.new(1, 1, 1)
		infoLabel.Text = string.format("Section %d/%d  •  %d wins  •  %d coins", player:GetAttribute("Section") or 1, Config.Sections, player:GetAttribute("Wins") or 0, player:GetAttribute("Coins") or 0)
		task.wait(0.25)
	end
end)

local side = ShopUI.SideBar(gui)
UI.Button("SHOP", Color3.fromRGB(40, 180, 70), { Size = UDim2.fromOffset(130, 52), Parent = side }).Activated:Connect(function()
	shop.Visible = not shop.Visible
end)
local function coilButton(label: string, pass: string, attr: string, remoteName: string)
	local b = UI.Button(label, Color3.fromRGB(60, 120, 255), { Size = UDim2.fromOffset(130, 52), Parent = side })
	local function refresh()
		b.Text = if player:GetAttribute("Pass_" .. pass) then label .. (if player:GetAttribute(attr) then ": ON" else ": OFF") else label .. " 🔒"
	end
	player.AttributeChanged:Connect(refresh)
	refresh()
	b.Activated:Connect(function()
		if player:GetAttribute("Pass_" .. pass) then
			remotes.ToggleCoil:FireServer(remoteName)
		else
			buy("Pass", pass)
		end
	end)
end
coilButton("Speed", "SpeedCoil", "SpeedOn", "Speed")
coilButton("Jump", "GravityCoil", "GravityOn", "Gravity")
UI.Button("SKIP", Color3.fromRGB(230, 60, 60), { Size = UDim2.fromOffset(130, 52), Parent = side }).Activated:Connect(function()
	buy("Product", "SkipSection")
end)
UI.Button("LAVA 🔥", Color3.fromRGB(255, 110, 30), { Size = UDim2.fromOffset(130, 52), Parent = side }).Activated:Connect(function()
	buy("Product", "LavaRise")
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
